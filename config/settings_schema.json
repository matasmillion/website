[
  {
    "name": "theme_info",
    "theme_name": "Foreign Resource",
    "theme_version": "1.0.0",
    "theme_author": "Foreign Resource",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Logo & Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width (px)",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 140,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (text & UI)",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary (backgrounds)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (CTAs & highlights)",
        "default": "#C4632A"
      },
      {
        "type": "color",
        "id": "color_supporting_green",
        "label": "Supporting — Sage Green",
        "default": "#7A8B6F"
      },
      {
        "type": "color",
        "id": "color_supporting_sand",
        "label": "Supporting — Sand",
        "default": "#D4C5A9"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "inter_n5"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "font_body_size",
        "label": "Base font size",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 16,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "X / Twitter URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Dedicated page" }
        ],
        "default": "drawer"
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "min": 0,
        "max": 500,
        "step": 10,
        "default": 150,
        "unit": "$"
      }
    ]
  },
  {
    "name": "Live chat / assistance",
    "settings": [
      {
        "type": "checkbox",
        "id": "chat_enable",
        "label": "Show floating assistance button",
        "default": true
      },
      {
        "type": "text",
        "id": "chat_text",
        "label": "Button text",
        "default": "Live Assistance"
      },
      {
        "type": "url",
        "id": "chat_link",
        "label": "Fallback link",
        "info": "Opens Shopify Inbox chat if available; otherwise goes here (e.g. contact page)."
      },
      {
        "type": "checkbox",
        "id": "chat_hide_inbox",
        "label": "Hide Shopify Inbox default bubble",
        "info": "Hides the standard Inbox chat bubble so only this text button shows.",
        "default": true
      }
    ]
  }
]
