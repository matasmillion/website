[
  {
    "name": "theme_info",
    "theme_name": "Foreign Resource",
    "theme_version": "1.0.0",
    "theme_author": "Foreign Resource",
    "theme_documentation_url": "https://github.com/matasmillion/website",
    "theme_support_email": "matias@foreignresource.com"
  },
  {
    "name": "Logo & Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width (px)",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 140,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (text & UI)",
        "default": "#2D2C2F"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary (backgrounds)",
        "default": "#F1EEE6"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (CTAs & highlights)",
        "default": "#C4632A"
      },
      {
        "type": "color",
        "id": "color_supporting_green",
        "label": "Supporting — Sage Green",
        "default": "#7A8B6F"
      },
      {
        "type": "color",
        "id": "color_supporting_sand",
        "label": "Supporting — Sand",
        "default": "#D4C5A9"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "The brand defaults are Cormorant Garamond for headings and Inter for body text. Enable custom fonts to pick from the Shopify font library instead."
      },
      {
        "type": "checkbox",
        "id": "use_custom_fonts",
        "label": "Use custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "inter_n5"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "font_body_size",
        "label": "Base font size",
        "min": 12,
        "max": 20,
        "step": 1,
        "default": 13,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "X / Twitter URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Dedicated page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "min": 0,
        "max": 500,
        "step": 10,
        "default": 150,
        "unit": "$"
      }
    ]
  },
  {
    "name": "Product page",
    "settings": [
      {
        "type": "header",
        "content": "Collection label"
      },
      {
        "type": "paragraph",
        "content": "The small grey line above the product name. Set \"Main Collection\" on a product in Shopify admin to choose it exactly. These settings only decide what happens when that field is left empty."
      },
      {
        "type": "text",
        "id": "collection_label_ignore",
        "label": "Collections never used as the label",
        "info": "Comma-separated collection handles (the end of the collection's URL). Catch-all and internal collections belong here.",
        "default": "all-products, for-shopify-performance-tracking"
      },
      {
        "type": "text",
        "id": "collection_label_fallback",
        "label": "Label when nothing else applies",
        "default": "ALL"
      }
    ]
  }
]
