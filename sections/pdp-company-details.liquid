{%- comment -%}
  PDP — Company details.

  The Packaging / Mission / Colour / Fabric rows, lifted out of Product Info so they
  can be ordered, moved or removed independently of the buy box. They render the
  same .pdp__rows markup as before, so component-product-page.css and
  initPdpRows in global.js pick them up unchanged.

  Rows open one at a time. Which one starts open is a per-block checkbox rather
  than a hardcoded first-row rule, so it stays a merchandising decision.

  DESKTOP — the same blocks laid out as one flush four-up band, on the same
  column geometry as FOREIGN ENGINEERING directly above it: full bleed, equal
  columns, 1.25rem inset. The dividers therefore land exactly on the seams
  between the images upstairs instead of cutting across them, which is what
  keeps two stacked full-width bands from reading as noise.

  The accordion is a mobile behaviour only. Across four short columns there is
  nothing to collapse, and a click that reflowed a quarter of the row would be
  the messy part — so on desktop every panel is simply open, the toggle is
  replaced by a plain heading, and the images stay off by default (the band
  above is already carrying the pictures).

  Two headings are rendered per row, one shown per breakpoint: a <button> for
  the mobile accordion and an <h3> for the static desktop column. Duplicating
  two or three words of heading text is the cost of not lying about the
  semantics — a button that cannot be pressed, or an aria-expanded that
  contradicts what is on screen, is worse.
{%- endcomment -%}

{%- assign detail_rows = section.blocks | where: 'type', 'detail_row' -%}
{%- assign desktop_layout = section.settings.desktop_layout | default: 'columns' -%}

{%- if detail_rows.size > 0 -%}
  <section
    class="pdp-details reveal{% if desktop_layout == 'columns' %} pdp-details--columns{% if section.settings.desktop_media %} pdp-details--media{% endif %}{% endif %}"
    style="--pdp-cols: {{ detail_rows.size }};"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="pdp-details__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- comment -%}
      The attribute's value is what tells initPdpRows the group goes static
      above 769px, so it can unhide the panels the accordion left closed.
    {%- endcomment -%}
    <div class="pdp__rows" data-pdp-rows="{% if desktop_layout == 'columns' %}columns{% else %}stack{% endif %}">
      {%- comment -%}
        Only the first row asking to be open gets it. The group is
        one-at-a-time by design, so two blocks ticking the box would render
        a state the JS immediately contradicts on the first click.
      {%- endcomment -%}
      {%- assign row_opened = false -%}
      {%- for block in detail_rows -%}
        {%- assign is_open = false -%}
        {%- if block.settings.open_by_default and row_opened == false -%}
          {%- assign is_open = true -%}
          {%- assign row_opened = true -%}
        {%- endif -%}
        <div class="pdp__row" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="pdp__row-trigger"
            data-row-trigger
            aria-expanded="{% if is_open %}true{% else %}false{% endif %}"
          >
            <span>{{ block.settings.heading }}</span>
            <span class="pdp__row-icon" aria-hidden="true"></span>
          </button>

          {%- comment -%}
            Desktop column heading. Hidden below 769px, where the button above
            takes over — only one of the two is ever displayed. Not emitted at
            all in stack mode, where nothing would ever reveal it.
          {%- endcomment -%}
          {%- if desktop_layout == 'columns' -%}
            <h3 class="pdp__row-title">{{ block.settings.heading }}</h3>
          {%- endif -%}

          <div class="pdp__row-panel" data-row-panel {% unless is_open %}hidden{% endunless %}>
            {%- if block.settings.content != blank -%}
              <div class="pdp__row-copy">{{ block.settings.content }}</div>
            {%- endif -%}

            {%- comment -%}
              Optional swatch list, one per line: Name|#hex|Description
              Used by the Colour row to show the full system.
            {%- endcomment -%}
            {%- if block.settings.swatches != blank -%}
              <ul class="pdp__row-swatches">
                {%- assign lines = block.settings.swatches | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- assign parts = line | strip | split: '|' -%}
                  {%- if parts.size > 1 -%}
                    <li class="pdp__row-swatch">
                      <span class="pdp__row-chip" style="background: {{ parts[1] | strip }};" aria-hidden="true"></span>
                      <span class="pdp__row-swatch-body">
                        <span class="pdp__row-swatch-name">{{ parts[0] | strip }}</span>
                        {%- if parts.size > 2 -%}
                          <span class="pdp__row-swatch-text">{{ parts[2] | strip }}</span>
                        {%- endif -%}
                      </span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              {%- comment -%}
                Animated GIFs must be served untouched — any CDN transform
                risks collapsing them to a single frame. So for a .gif we
                rebuild the URL from the path plus the version stamp only,
                dropping every sizing parameter. Matching on the parsed
                extension rather than a substring keeps a file called
                "packaging.gifts.jpg" out of this branch.
              {%- endcomment -%}
              {%- assign row_src = block.settings.image | image_url: width: 900 -%}
              {%- assign row_path = row_src | split: '?' | first -%}
              {%- assign row_ext = row_path | split: '.' | last | downcase -%}
              {%- if row_ext == 'gif' -%}
                {%- if row_src contains 'v=' -%}
                  {%- assign row_ver = row_src | split: 'v=' | last | split: '&' | first -%}
                  {%- assign row_src = row_path | append: '?v=' | append: row_ver -%}
                {%- else -%}
                  {%- assign row_src = row_path -%}
                {%- endif -%}
              {%- endif -%}
              <img
                class="pdp__row-media"
                src="{{ row_src }}"
                alt="{{ block.settings.heading | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                decoding="async"
              >
            {%- elsif block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'pdp__row-media' }}
            {%- endif -%}

            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <a class="pdp__tab-link" href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<style>
  /* Matches the inset and rhythm the rows had inside Product Info, now that
     they own their own band of the page. This is the mobile case, and the
     desktop case too whenever the four-up band is switched off. */
  .pdp-details {
    padding: 0 clamp(1.25rem, 0.5rem + 3vw, 4rem);
    max-width: 640px;
    margin: 0 auto;
  }

  .pdp-details__heading {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #A4A4A4;
    margin: 0 0 0.5rem;
  }
</style>

{%- comment -%}
  The four-up desktop band lives in component-product-page.css alongside the
  rest of the .pdp__row rules it overrides — keeping it here would put the
  override in a different stylesheet from the thing it overrides.
{%- endcomment -%}

{% schema %}
{
  "name": "Company Details",
  "class": "section-pdp-company-details",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to show the rows with no heading above them."
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "info": "Mobile is always the stacked accordion. Columns line the rows up on the same grid as Foreign Engineering above, with every panel open.",
      "options": [
        { "value": "columns", "label": "Equal columns, full width" },
        { "value": "stack", "label": "Stacked accordion (same as mobile)" }
      ],
      "default": "columns"
    },
    {
      "type": "checkbox",
      "id": "desktop_media",
      "label": "Show row images in the desktop columns",
      "info": "Off by default. Sitting straight under the Foreign Engineering images, four more pictures at quarter width is what makes the band look busy. Images always show on mobile.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "detail_row",
      "name": "Detail row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fabric" },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open this row on page load",
          "info": "Rows open one at a time, so if several are ticked only the topmost opens.",
          "default": false
        },
        { "type": "richtext", "id": "content", "label": "Content" },
        {
          "type": "textarea",
          "id": "swatches",
          "label": "Swatches (one per line)",
          "info": "Format: Name|#hex|Description — used for the colour system."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image or GIF",
          "info": "Animated GIFs are served at full size, untransformed, so the animation survives. Keep them under ~2 MB and no wider than 1200px."
        },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Company Details",
      "blocks": [
        { "type": "detail_row", "settings": { "heading": "Our Packaging", "open_by_default": true } },
        { "type": "detail_row", "settings": { "heading": "Our Mission" } },
        { "type": "detail_row", "settings": { "heading": "Our Colors" } },
        { "type": "detail_row", "settings": { "heading": "Our Fabrics" } }
      ]
    }
  ]
}
{% endschema %}
