{{ 'component-portal.css' | asset_url | stylesheet_tag }}

<div class="portal-auth page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="portal-auth__inner">
    <div class="portal-auth__panel">
      <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
      <h1 class="portal-auth__heading h2">{{ 'customer.register.title' | t }}</h1>
      <p class="text-soft">{{ 'customer.register.subtext' | t }}</p>

      {%- form 'create_customer', novalidate: 'novalidate', class: 'portal-auth__form' -%}
        {%- if form.errors -%}
          <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="portal-auth__row">
          <div class="field">
            <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
            <input
              id="RegisterFirstName"
              class="field__input"
              type="text"
              name="customer[first_name]"
              autocomplete="given-name"
            >
          </div>
          <div class="field">
            <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
            <input
              id="RegisterLastName"
              class="field__input"
              type="text"
              name="customer[last_name]"
              autocomplete="family-name"
            >
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
          <input
            id="RegisterEmail"
            class="field__input"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            required
          >
        </div>

        <div class="field">
          <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
          <input
            id="RegisterPassword"
            class="field__input"
            type="password"
            name="customer[password]"
            autocomplete="new-password"
            required
          >
        </div>

        <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}

      <div class="portal-auth__alt">
        <p class="text-soft">{{ 'customer.register.have_account' | t }}</p>
        <a href="{{ routes.account_login_url }}" class="link-underline">{{ 'customer.register.sign_in' | t }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Register",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ]
}
{% endschema %}
