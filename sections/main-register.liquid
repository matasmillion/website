{{ 'component-customer.css' | asset_url | stylesheet_tag }}

<section class="customer">
  <h1 class="customer__title">{{ 'customer.register.title' | t }}</h1>
  <p class="customer__intro">{{ 'customer.register.intro' | t }}</p>

  {%- form 'create_customer', class: 'customer__form' -%}
    {%- if form.errors -%}
      <div class="customer__errors" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="customer__form-row">
      <div class="customer__field">
        <label for="RegisterFirstName">{{ 'customer.fields.first_name' | t }}</label>
        <input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name">
      </div>
      <div class="customer__field">
        <label for="RegisterLastName">{{ 'customer.fields.last_name' | t }}</label>
        <input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name">
      </div>
    </div>

    <div class="customer__field">
      <label for="RegisterEmail">{{ 'customer.fields.email' | t }}</label>
      <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required>
    </div>

    <div class="customer__field">
      <label for="RegisterPassword">{{ 'customer.fields.password' | t }}</label>
      <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
    </div>

    <div class="customer__actions">
      <button type="submit" class="btn btn--primary btn--full">{{ 'customer.register.submit' | t }}</button>
    </div>
  {%- endform -%}

  <div class="customer__links">
    <a href="{{ routes.account_login_url }}">{{ 'customer.register.have_account' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Customer Register",
  "class": "section-customer-register",
  "settings": []
}
{% endschema %}
