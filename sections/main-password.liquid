<style>
  .password-page {
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    max-width: 440px;
    margin: 0 auto;
  }
  .password-page__shop {
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: var(--space-xl);
  }
  .password-page__heading {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-md);
  }
  .password-page__text {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.8;
    margin-bottom: var(--space-xl);
  }
  .password-page__form {
    display: flex;
    border-bottom: 1px solid var(--color-primary);
    margin-bottom: var(--space-lg);
  }
  .password-page__input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 0.75rem 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-primary);
  }
  .password-page__input:focus { outline: none; }
  .password-page__submit {
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    cursor: pointer;
  }
  .password-page__error {
    font-size: var(--text-sm);
    color: #8B0000;
    margin-bottom: var(--space-md);
  }
  .password-page__toggle {
    background: none;
    border: none;
    border-bottom: 1px solid var(--color-border);
    padding: 0 0 0.125rem;
    font-family: var(--font-body);
    font-size: var(--text-micro);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-light);
    cursor: pointer;
  }
</style>

<div class="password-page">
  <p class="password-page__shop">{{ shop.name }}</p>
  <h1 class="password-page__heading">{{ section.settings.heading | default: 'Opening soon' }}</h1>
  {%- if section.settings.text != blank -%}
    <div class="password-page__text">{{ section.settings.text }}</div>
  {%- endif -%}

  <div id="PasswordForm" hidden>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="password-page__error">{{ form.errors.messages['form'] }}</p>
      {%- endif -%}
      <div class="password-page__form">
        <input
          type="password"
          name="password"
          class="password-page__input"
          placeholder="{{ 'password_page.placeholder' | t }}"
          aria-label="{{ 'password_page.placeholder' | t }}"
        >
        <button type="submit" class="password-page__submit">{{ 'password_page.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>

  <button type="button" class="password-page__toggle" data-password-toggle>
    {{ 'password_page.enter_password' | t }}
  </button>
</div>

<script>
  (function () {
    var toggle = document.querySelector('[data-password-toggle]');
    var form = document.getElementById('PasswordForm');
    if (!toggle || !form) return;
    toggle.addEventListener('click', function () {
      form.hidden = false;
      toggle.hidden = true;
      var input = form.querySelector('input[name="password"]');
      if (input) input.focus();
    });
    // After a wrong password the page re-renders with an error — keep the form visible
    if (form.querySelector('.password-page__error')) {
      form.hidden = false;
      toggle.hidden = true;
    }
  })();
</script>

{% schema %}
{
  "name": "Password Page",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Foreign Resource is coming. Premium essentials for the modern explorer.</p>"
    }
  ]
}
{% endschema %}
