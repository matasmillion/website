{{ 'component-hero.css' | asset_url | stylesheet_tag }}

<section
  class="hero hero--{{ section.settings.height }} hero--text-{{ section.settings.text_position }}"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'hero__video'
      }}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1600, 2000, 2400',
          sizes: '100vw',
          class: 'hero__image',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__placeholder' }}
    {%- endif -%}
  </div>

  <div class="hero__content page-width" data-fade-in>
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading h0">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link }}" class="button{% if section.settings.cta_style == 'outline' %} button--outline{% endif %}">
        {{ section.settings.cta_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video (overrides image)" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Foreign Resource" },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Travel is the only thing you buy that makes you richer"
    },
    { "type": "text", "id": "subheading", "label": "Subheadline" },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "bottom-left"
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop collection" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button style",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "outline", "label": "Outlined" }
      ],
      "default": "outline"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 20
    }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
