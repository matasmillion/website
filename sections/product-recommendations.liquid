{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

<section class="product-recs reveal" data-product-recommendations>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-recs__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="product-recs__grid">
      {%- if recommendations.performed -%}
        {%- if recommendations.products_count > 0 -%}
          {%- for product in recommendations.products limit: section.settings.products_count -%}
            <div class="product-recs__item">
              {%- render 'product-card', product: product -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="product-recs__item">
            <article class="product-card">
              <div class="product-card__image-wrapper product-card__image-wrapper--portrait">
                <div class="product-card__placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}
                </div>
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">Recommendation {{ i }}</h3>
                <div class="product-card__price">{{ 8500 | money }}</div>
              </div>
            </article>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%}
      VIEW MORE — every live collection, straight from the `collections` global
      so it can never fall out of step with the store. Empty collections are
      skipped (a shopper following one lands on nothing) and the exclude list
      handles the internal ones — tracking feeds, duplicates, staging sets —
      without needing a code change to hide them.
    {%- endcomment -%}
    {%- if section.settings.show_collections -%}
      {%- assign hidden = section.settings.exclude_handles | downcase | split: ',' -%}
      {%- capture links -%}
        {%- for collection in collections -%}
          {%- assign is_hidden = false -%}
          {%- for h in hidden -%}
            {%- if h | strip == collection.handle -%}{%- assign is_hidden = true -%}{%- endif -%}
          {%- endfor -%}
          {%- if collection.all_products_count > 0 and is_hidden == false -%}
            <a class="product-recs__collection" href="{{ collection.url }}">{{ collection.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if links != blank -%}
        <div class="product-recs__more">
          {%- if section.settings.more_heading != blank -%}
            <p class="product-recs__more-heading">{{ section.settings.more_heading }}</p>
          {%- endif -%}
          <nav class="product-recs__collections" aria-label="{{ section.settings.more_heading | default: 'View more' | escape }}">{{ links }}</nav>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .product-recs {
    padding: var(--space-2xl) 0;
    border-top: var(--border-thin);
  }
  .product-recs__heading {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
    opacity: 0.5;
  }
  .product-recs__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--grid-gap);
  }
  @media (max-width: 1024px) {
    .product-recs__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .product-recs__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .product-recs__more {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--border-thin);
  }

  .product-recs__more-heading {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 var(--space-md);
    opacity: 0.5;
  }

  /* Wraps rather than scrolls — the list is short enough to read at a glance
     and a hidden overflow would bury whole collections. */
  .product-recs__collections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }

  .product-recs__collection {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6E6D71;
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .product-recs__collection:hover,
  .product-recs__collection:focus-visible { color: #2D2C2F; }
</style>

{% schema %}
{
  "name": "Product Recommendations",
  "class": "section-product-recs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "View more"
    },
    {
      "type": "checkbox",
      "id": "show_collections",
      "label": "List every live collection below",
      "default": true
    },
    {
      "type": "text",
      "id": "more_heading",
      "label": "View more heading",
      "default": "View more"
    },
    {
      "type": "text",
      "id": "exclude_handles",
      "label": "Collection handles to hide",
      "info": "Comma separated, e.g. for-shopify-performance-tracking, sales-copy-1. Empty collections are already skipped automatically.",
      "default": "for-shopify-performance-tracking"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations"
    }
  ]
}
{% endschema %}
