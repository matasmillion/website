{{ 'component-customer.css' | asset_url | stylesheet_tag }}

<section class="customer">
  <h1 class="customer__title">{{ 'customer.reset.title' | t }}</h1>
  <p class="customer__intro">{{ 'customer.reset.intro' | t: email: email }}</p>

  {%- form 'reset_customer_password', class: 'customer__form' -%}
    {%- if form.errors -%}
      <div class="customer__errors" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="customer__field">
      <label for="ResetPassword">{{ 'customer.fields.new_password' | t }}</label>
      <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    </div>

    <div class="customer__field">
      <label for="ResetPasswordConfirm">{{ 'customer.fields.confirm_password' | t }}</label>
      <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
    </div>

    <div class="customer__actions">
      <button type="submit" class="btn btn--primary btn--full">{{ 'customer.reset.submit' | t }}</button>
    </div>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Customer Reset Password",
  "class": "section-customer-reset",
  "settings": []
}
{% endschema %}
