{{ 'component-portal.css' | asset_url | stylesheet_tag }}

<div class="portal-auth page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="portal-auth__inner">
    <div class="portal-auth__panel">
      <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
      <h1 class="portal-auth__heading h2">{{ 'customer.reset_password.title' | t }}</h1>
      <p class="text-soft">{{ 'customer.reset_password.subtext' | t: email: email }}</p>

      {%- form 'reset_customer_password', class: 'portal-auth__form' -%}
        {%- if form.errors -%}
          <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input
            id="ResetPassword"
            class="field__input"
            type="password"
            name="customer[password]"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="field">
          <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input
            id="ResetPasswordConfirm"
            class="field__input"
            type="password"
            name="customer[password_confirmation]"
            autocomplete="new-password"
            required
          >
        </div>

        <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ]
}
{% endschema %}
