{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign app_blocks = section.blocks | where: 'type', '@app'

  # Instalment figure — this shop's money format drops decimals, so it is
  # composed by hand rather than via the money filters.
  assign inst_cents = current_variant.price | divided_by: 4
  assign inst_dollars = inst_cents | divided_by: 100
  assign inst_rem = inst_cents | modulo: 100

  # Sale state drives both add-to-cart buttons
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
-%}

{{ 'component-product-page.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Band height drives the mobile image height, the fixed band, and scroll
  padding. Declared on :root so html-level rules can resolve it.
{%- endcomment -%}
<style>
  :root { --pdp-band-h: 126px; }
  html { scroll-padding-bottom: var(--pdp-band-h); }

  /* iOS Safari keeps scrolling <html> even when <body> clips, which is what
     leaves a strip of background down the right-hand side. `clip` rather than
     `hidden`: hidden would make html a scroll container and kill the sticky
     gallery. */
  html, body { overflow-x: clip; }
</style>

<div class="pdp" data-pdp data-low-stock-threshold="{{ section.settings.low_stock_threshold | default: 5 }}">
  {%- comment -%} ===== IMAGE GALLERY (LEFT ON DESKTOP) ===== {% endcomment -%}
  {%- liquid
    assign focal_map = 'top:12%,upper:25%,center:50%,lower:75%,bottom:88%' | split: ','
    assign focal_y = '25%'
    for pair in focal_map
      assign kv = pair | split: ':'
      if kv[0] == section.settings.desktop_focal_y
        assign focal_y = kv[1]
      endif
    endfor
  -%}
  <div
    class="pdp__gallery"
    data-product-gallery
    style="--pdp-fit: {{ section.settings.desktop_image_fit | default: 'cover' }}; --pdp-focal-y: {{ focal_y }};"
  >
    <div class="pdp__gallery-main" data-gallery-main>
      {%- for image in product.images -%}
        <div
          class="pdp__gallery-slide{% if forloop.first %} is-active{% endif %}"
          data-gallery-slide="{{ forloop.index0 }}"
          data-zoom-src="{{ image | image_url: width: 2048 }}"
          data-zoom-alt="{{ image.alt | default: product.title | escape }}"
        >
          <img
            src="{{ image | image_url: width: 1200 }}"
            srcset="{{ image | image_url: width: 600 }} 600w,
                    {{ image | image_url: width: 900 }} 900w,
                    {{ image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 769px) 58vw, 100vw"
            alt="{{ image.alt | default: product.title | escape }}"
            width="{{ image.width }}"
            height="{{ image.height }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            class="pdp__gallery-img"
          >
        </div>
      {%- endfor -%}
    </div>

    <div class="pdp__gallery-rail">
      {%- if product.images.size > 1 -%}
        <div class="pdp__gallery-dots">
          {%- for image in product.images -%}
            <button
              class="pdp__gallery-dot{% if forloop.first %} is-active{% endif %}"
              data-gallery-dot="{{ forloop.index0 }}"
              aria-label="View image {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- comment -%} Wishlist sits directly beneath the dots {% endcomment -%}
      <button
        class="pdp__wishlist-img"
        data-wishlist-toggle="{{ product.handle }}"
        aria-label="Save {{ product.title }}"
        aria-pressed="false"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>
    </div>

    {%- if product.images.size > 1 -%}
      <button class="pdp__gallery-nav pdp__gallery-nav--prev" data-gallery-prev aria-label="Previous image">
        <svg width="8" height="13" viewBox="0 0 8 13" fill="none" stroke="currentColor" stroke-width="1"><polyline points="7 1 1 6.5 7 12"/></svg>
      </button>
      <button class="pdp__gallery-nav pdp__gallery-nav--next" data-gallery-next aria-label="Next image">
        <svg width="8" height="13" viewBox="0 0 8 13" fill="none" stroke="currentColor" stroke-width="1"><polyline points="1 1 7 6.5 1 12"/></svg>
      </button>
    {%- endif -%}

    {%- comment -%} Tag badge, bottom-left (desktop) {% endcomment -%}
    {%- capture badge_label %}{% render 'product-badge-label', product: product %}{% endcapture -%}
    {%- assign badge_label = badge_label | strip -%}
    {%- if badge_label != blank -%}
      <span class="pdp__gallery-badge">{{ badge_label | upcase }}</span>
    {%- endif -%}

    {%- comment -%}
      Cursor-following zoom affordance (desktop): a round white +/- that tracks
      the pointer over the gallery, as in the reference. Hidden on touch.
    {%- endcomment -%}
    <span class="pdp__zoom-cursor" data-zoom-cursor aria-hidden="true">+</span>

    {%- comment -%} Mobile: flat progress bar flush to the image's bottom edge {% endcomment -%}
    <div class="pdp__gallery-progress" aria-hidden="true">
      <span class="pdp__gallery-progress-fill" data-gallery-progress></span>
    </div>
  </div>

  {%- comment -%}
    ===== STICKY BAND (mobile only) =====
    Replaces the old in-flow mobile band — never duplicates it. global.js wires
    [data-mobile-submit] with singular querySelector in three places, so a
    second copy would silently break variant sync and add-to-cart feedback.
    Must stay inside [data-pdp]: initPdpVariants scopes its lookup to it.
  {%- endcomment -%}
  <div class="pdp-band" data-sticky-band>
    <div class="pdp-band__top">
      <h1 class="pdp-band__title">{{ product.title }}</h1>
      <button
        class="pdp-band__heart"
        data-wishlist-toggle="{{ product.handle }}"
        aria-label="Save {{ product.title }}"
        aria-pressed="false"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>
    </div>
    <button type="button" class="pdp-band__atc" data-mobile-submit {% unless current_variant.available %}disabled{% endunless %}>
      <span>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
      <span data-mobile-price>
        {%- if on_sale -%}
          <s class="price-was">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
          <span class="price-now">{{ current_variant.price | money_without_trailing_zeros }}</span>
        {%- else -%}
          {{ current_variant.price | money_without_trailing_zeros }}
        {%- endif -%}
      </span>
    </button>
  </div>

  {%- comment -%} ===== PRODUCT DETAILS (RIGHT ON DESKTOP) ===== {% endcomment -%}
  <div class="pdp__details">
    <div class="pdp__details-inner">
      {%- comment -%} Desktop-only: collection label + title {% endcomment -%}
      {%- if product.collections.size > 0 -%}
        <p class="pdp__collection">{{ product.collections.first.title }}</p>
      {%- endif -%}

      <h1 class="pdp__title">{{ product.title }}</h1>

      {%- if product.description != blank and section.settings.show_short_description -%}
        <p class="pdp__description">{{ product.description | strip_html | truncate: 200 }}</p>
      {%- endif -%}

      {%- comment -%} ===== COLOR SWATCHES ===== {% endcomment -%}
      {%- for option in product.options_with_values -%}
        {%- if option.name == 'Color' or option.name == 'Colour' -%}
          <div class="pdp__swatches">
            <p class="pdp__swatch-label">{{ option.selected_value }}</p>
            <div class="pdp__swatch-list" data-variant-select data-option-position="{{ option.position }}">
              {%- for value in option.values -%}
                {%- liquid
                  # Takes the hex from Shopify's colour metaobject so the chip
                  # is the true colour rather than a guess. The metaobject's
                  # texture image is deliberately not used — a flat chip reads
                  # cleaner at this size. The name map is the fallback for
                  # colours with no metaobject yet.
                  assign swatch_color = blank
                  assign value_down = value | downcase

                  for entry in product.metafields.shopify['color-pattern'].value
                    assign entry_label = entry.label | downcase
                    if entry_label == value_down
                      assign swatch_color = entry.color
                    endif
                  endfor

                  if swatch_color == blank
                    assign color_lower = value | downcase | replace: ' ', ''
                    assign swatch_color = '#000000'
                    if color_lower contains 'black'
                      assign swatch_color = '#000000'
                    elsif color_lower contains 'white' or color_lower contains 'ivory'
                      assign swatch_color = '#FFFFFF'
                    elsif color_lower contains 'navy'
                      assign swatch_color = '#1B2A4A'
                    elsif color_lower contains 'stone'
                      assign swatch_color = '#716F71'
                    elsif color_lower contains 'brown' or color_lower contains 'tan'
                      assign swatch_color = '#8B6914'
                    elsif color_lower contains 'green' or color_lower contains 'khaki' or color_lower contains 'olive'
                      assign swatch_color = '#556B2F'
                    elsif color_lower contains 'blue'
                      assign swatch_color = '#3B5998'
                    elsif color_lower contains 'red' or color_lower contains 'burgundy'
                      assign swatch_color = '#8B0000'
                    elsif color_lower contains 'grey' or color_lower contains 'gray'
                      assign swatch_color = '#808080'
                    elsif color_lower contains 'beige' or color_lower contains 'sand' or color_lower contains 'cream'
                      assign swatch_color = '#D4C5A9'
                    elsif color_lower contains 'pink'
                      assign swatch_color = '#D4A0A0'
                    elsif color_lower contains 'orange'
                      assign swatch_color = '#C4632A'
                    elsif color_lower contains 'yellow'
                      assign swatch_color = '#D4B44A'
                    elsif color_lower contains 'purple'
                      assign swatch_color = '#663399'
                    endif
                  endif
                -%}
                <button
                  type="button"
                  class="pdp__swatch{% if option.selected_value == value %} is-selected{% endif %}"
                  data-variant-option="{{ value }}"
                  aria-label="{{ value }}"
                  aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                  style="background-color: {{ swatch_color }};{% if swatch_color == '#FFFFFF' %} border-color: rgba(0,0,0,0.2);{% endif %}"
                  title="{{ value }}"
                ></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} ===== SIZE SELECTOR + ADD TO CART ===== {% endcomment -%}
      {%- form 'product', product, data-add-to-cart: true, class: 'pdp__form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <script type="application/json" data-variant-json>{{ product.variants | json }}</script>
        {%- comment -%}
          product.variants JSON omits inventory, so remaining units are passed
          separately for the low-stock indicator. Only tracked variants appear.
        {%- endcomment -%}
        {%- liquid
          assign inv_pairs = ''
          for v in product.variants
            if v.inventory_management != blank
              assign pair = v.id | append: '":' | prepend: '"' | append: v.inventory_quantity
              if inv_pairs == ''
                assign inv_pairs = pair
              else
                assign inv_pairs = inv_pairs | append: ',' | append: pair
              endif
            endif
          endfor
        -%}
        <script type="application/json" data-inventory-json>{ {{- inv_pairs -}} }</script>

        {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- unless option.name == 'Color' or option.name == 'Colour' -%}
            <div class="pdp__sizes">
              {%- comment -%}
                No "SIZE" label — the numbers read as sizes on their own. The
                size-guide link is the SmartSize app block, rendered here so it
                sits where the old button did.
              {%- endcomment -%}
              {%- if option.name == 'Size' and app_blocks.size > 0 -%}
                {%- assign size_guide_rendered = true -%}
                <div class="pdp__size-header">
                  {%- for block in app_blocks -%}
                    <div class="pdp__size-guide-slot" {{ block.shopify_attributes }}>{% render block %}</div>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- comment -%} Low stock — only meaningful when inventory is tracked {% endcomment -%}
              {%- if option.name == 'Size' -%}
                <p class="pdp__low-stock" data-low-stock hidden></p>
              {%- endif -%}
              <div class="pdp__size-buttons" data-variant-select data-option-position="{{ option.position }}">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="pdp__size-btn{% if option.selected_value == value %} is-selected{% endif %}"
                    data-variant-option="{{ value }}"
                    aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endunless -%}
        {%- endfor -%}
        {%- endunless -%}

        {%- comment -%}
          Products with no Size option (one-size, accessories) never enter the
          loop above, so the size guide is rendered here instead of vanishing.
        {%- endcomment -%}
        {%- unless size_guide_rendered -%}
          {%- if app_blocks.size > 0 -%}
            <div class="pdp__size-header">
              {%- for block in app_blocks -%}
                <div class="pdp__size-guide-slot" {{ block.shopify_attributes }}>{% render block %}</div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endunless -%}

        <button
          type="submit"
          class="pdp__add-btn"
          data-add-btn
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span class="pdp__add-text">
            {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
          </span>
          <span class="pdp__add-price" data-price>
            {%- if on_sale -%}
              <s class="price-was">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
              <span class="price-now">{{ current_variant.price | money_without_trailing_zeros }}</span>
            {%- else -%}
              {{ current_variant.price | money_without_trailing_zeros }}
            {%- endif -%}
          </span>
        </button>

        {%- comment -%}
          Pay in 4. Shopify's {{ form | payment_terms }} renders a locked-down
          web component — its Shop Pay lockup and wording can't be restyled or
          reworded. So the line is written here instead, with the instalment
          figure derived from the variant price and kept in sync by JS.
        {%- endcomment -%}
        {%- if section.settings.show_payment_terms -%}
          <p class="pdp__terms">
            Pay in four interest-free installments of&nbsp;<span data-installment>${{ inst_dollars }}.{% if inst_rem < 10 %}0{% endif %}{{ inst_rem }}</span>.
            <a href="{{ section.settings.installments_url | default: 'https://shop.app/pay-installments' }}"
               class="pdp__terms-link" target="_blank" rel="noopener">Learn more</a>
          </p>
        {%- endif -%}
      {%- endform -%}

      {%- comment -%}
        Back in stock — shown only when the selected variant is unavailable.
        Klaviyo's Back in Stock is opened from here; see global.js.
      {%- endcomment -%}
      {%- comment -%}
        Back in stock is handled entirely by Klaviyo's injected
        .klaviyo-bis-trigger button; the theme only restyles it.
      {%- endcomment -%}




      {%- comment -%}
        Shopify injects its Shop Promise box via content_for_header, so it can't
        be removed in Liquid — only placed and hidden.

        PLACEMENT. Shopify's own shop_promise_pdp.js looks for
        .delivery-promise__promise-container first and mounts into it; failing
        that it hunts for a form[action*="/cart/add"] and injects itself
        structurally, which is why it used to land wherever the markup allowed.
        The empty div below claims that hook, so the banner renders here — above
        our urgency line, where the delivery story belongs.
      {%- endcomment -%}
      <div class="delivery-promise__promise-container"></div>

      {%- comment -%}
        The escape hatch. Note the element is <delivery-promise-wc> — the older
        shop-promise-banner / [class*="shop-promise"] selectors matched nothing,
        which is why ticking this setting appeared to do nothing at all.
      {%- endcomment -%}
      {%- if section.settings.hide_shop_promise -%}
        <style>
          delivery-promise-wc,
          .delivery-promise__promise-container { display: none !important; }
        </style>
      {%- endif -%}

      {%- comment -%} Rolling urgency — same date engine as the estimator {% endcomment -%}
      <p class="pdp__urgency" data-delivery-urgency hidden>
        <span class="dest__pulse" aria-hidden="true"></span>
        <span data-urgency-text></span>
      </p>

      {%- if section.settings.show_appointment_link -%}
        <a href="{{ section.settings.appointment_link }}" class="pdp__appointment">
          See availability and book an appointment in store
        </a>
      {%- endif -%}

      {%- comment -%} ===== TABS ===== {% endcomment -%}
      {%- comment -%}
        Panels start closed — clicking a tab slides its panel in, clicking the
        active tab again closes it.
      {%- endcomment -%}
      <div class="pdp__tabs" data-pdp-tabs>
        <div class="pdp__tab-list" role="tablist">
          <button class="pdp__tab" role="tab" data-tab="story" aria-selected="false" aria-expanded="false">Story</button>
          <button class="pdp__tab" role="tab" data-tab="sizing" aria-selected="false" aria-expanded="false">Sizing</button>
          <button class="pdp__tab" role="tab" data-tab="shipping" aria-selected="false" aria-expanded="false">Shipping</button>
          <button class="pdp__tab" role="tab" data-tab="returns" aria-selected="false" aria-expanded="false">Returns</button>
        </div>

        {%- comment -%} ===== STORY ===== {% endcomment -%}
        <div class="pdp__tab-panel" data-tab-panel="story" role="tabpanel">
          {%- if product.collections.size > 0 -%}
            <p class="pdp__tab-collection">{{ product.collections.first.title | upcase }}</p>
          {%- endif -%}
          <p class="pdp__tab-subtitle">{{ product.title }}</p>
          {%- liquid
            assign story = product.metafields.custom.product_story
            if story == blank
              assign story = product.description
            endif
          -%}
          {%- if story != blank -%}
            <div class="pdp__tab-description">{{ story }}</div>
          {%- endif -%}
          <p class="pdp__tab-meta">Ref. {{ product.variants.first.sku | default: product.id }}</p>
        </div>

        {%- comment -%} ===== SIZING ===== {% endcomment -%}
        <div class="pdp__tab-panel" data-tab-panel="sizing" role="tabpanel">
          {%- if product.metafields.custom.sizing != blank -%}
            <div class="pdp__tab-description">{{ product.metafields.custom.sizing }}</div>
          {%- endif -%}

          {%- if product.metafields.custom.model_stats != blank -%}
            <p class="pdp__tab-meta">{{ product.metafields.custom.model_stats }}</p>
          {%- endif -%}

          {%- if section.settings.size_chart_content != blank -%}
            <button type="button" class="pdp__tab-link" data-modal-open="size-chart-modal">Size guide</button>
          {%- endif -%}

          {%- if section.settings.size_calculator_url != blank -%}
            <a href="{{ section.settings.size_calculator_url }}" class="pdp__tab-link">Find my size</a>
          {%- endif -%}
        </div>

        {%- comment -%} ===== SHIPPING ===== {% endcomment -%}
        {%- comment -%}
          Stripped to the zip gate on purpose: free-shipping line, then the
          estimator, then nothing. The date only gets read if it is the only
          thing to read, so resist re-adding transit tables, express tiers or
          payment-method copy here — payment icons already live at checkout.
        {%- endcomment -%}
        <div class="pdp__tab-panel" data-tab-panel="shipping" role="tabpanel">
          {%- render 'delivery-estimator',
            delivery_rates: section.settings.delivery_rates,
            cutoff_hour: section.settings.cutoff_hour,
            delivery_timezone: section.settings.delivery_timezone,
            standard_label: section.settings.standard_label,
            express_label: section.settings.express_label
          -%}
        </div>

        {%- comment -%}
          ===== RETURNS =====
          The window, then the three outcomes ranked best-to-worst, then the
          action. Support hours and the contact link were cut — nobody opens
          Returns to find a phone number, and they buried the one line that
          costs money.

          Terms are one per line in the theme editor; the separators are
          rendered as hairlines rather than typed dashes.
        {%- endcomment -%}
        <div class="pdp__tab-panel pdp__tab-panel--returns" data-tab-panel="returns" role="tabpanel" data-returns-panel>
          {%- comment -%}
            Returns vary by region — the refund policy offers them in the USA,
            calls them "offered soon" for EU/UK/CA/AUS and unavailable
            elsewhere — so the panel resolves against a country the same way the
            delivery estimator does. Both pickers share one stored choice, so
            setting it in either tab moves the other.
          {%- endcomment -%}
          {%- assign ret_here = localization.country.iso_code | default: 'US' -%}
          <div class="dest__entry">
            <label class="dest__hint" for="ret-country">Select your country</label>
            <div class="dest__row">
              <select id="ret-country" class="dest__select" data-returns-country>
                {%- if localization.available_countries.size > 0 -%}
                  {%- for country in localization.available_countries -%}
                    <option value="{{ country.iso_code }}" {% if country.iso_code == ret_here %}selected{% endif %}>{{ country.name }}</option>
                  {%- endfor -%}
                {%- else -%}
                  <option value="{{ ret_here }}" selected>{{ localization.country.name | default: 'United States' }}</option>
                {%- endif -%}
              </select>
            </div>
          </div>

          <script type="text/plain" data-returns-rules>{{ section.settings.returns_rules | escape }}</script>

          {%- comment -%}
            Costs first, window second. What a return costs is the question that
            decides the purchase; how many days you have to decide is the
            qualifier on it. The sentence reads as a footnote to the table.
            Rows are written by JS from the rules table — the labels stay
            settings so the wording is still the merchant's.
          {%- endcomment -%}
          <ul class="pdp__returns-terms" data-returns-terms hidden>
            <li class="pdp__returns-term">
              <span class="pdp__returns-term-label">{{ section.settings.returns_label_exchange | default: 'Exchange' }}</span>
              <span class="pdp__returns-term-value" data-returns-exchange></span>
            </li>
            <li class="pdp__returns-term">
              <span class="pdp__returns-term-label">{{ section.settings.returns_label_credit | default: 'Return · Store credit' }}</span>
              <span class="pdp__returns-term-value" data-returns-credit></span>
            </li>
            <li class="pdp__returns-term">
              <span class="pdp__returns-term-label">{{ section.settings.returns_label_card | default: 'Return · To card' }}</span>
              <span class="pdp__returns-term-value" data-returns-card></span>
            </li>
          </ul>

          {%- comment -%}
            {days} is substituted from the rules table so the window can never
            contradict the row above it.
          {%- endcomment -%}
          <p class="pdp__returns-intro" data-returns-intro data-template="{{ section.settings.returns_intro | default: 'You have {days} days from the date of delivery to return or exchange items.' | escape }}" hidden></p>

          <p class="pdp__returns-intro" data-returns-none hidden>{{ section.settings.returns_unavailable | default: 'Returns & Exchanges are not yet offered for your region. Our team is working hard to roll this feature out.' }}</p>

          <div class="pdp__returns-actions" data-returns-actions>
            {%- if section.settings.returns_start_label != blank -%}
              <a href="{{ section.settings.returns_start_url | default: '/pages/track-order' }}" class="pdp__tab-link" data-returns-start>{{ section.settings.returns_start_label }}</a>
            {%- endif -%}
            {%- if section.settings.returns_policy_label != blank -%}
              <a href="{{ section.settings.returns_policy_url | default: '/pages/returns' }}" class="pdp__tab-link pdp__tab-link--quiet">{{ section.settings.returns_policy_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  COMPLETE THE LOOK now lives in its own section
  (sections/product-complete-the-look.liquid) so the products can be curated
  per SKU via the custom.complete_the_look metafield.
{%- endcomment -%}


{%- comment -%} ===== ZOOM LIGHTBOX ===== {% endcomment -%}
<div class="pdp-zoom" data-pdp-zoom aria-hidden="true" role="dialog" aria-label="Zoom image">
  <div class="pdp-zoom__stage" data-zoom-stage>
    <img class="pdp-zoom__img" data-zoom-img alt="">
  </div>
  <button class="pdp-zoom__close" data-zoom-close aria-label="Close">
    {%- render 'icon-close' -%}
  </button>
  <div class="pdp-zoom__ctrls">
    <button class="pdp-zoom__ctrl" data-zoom-in aria-label="Zoom in">+</button>
    <button class="pdp-zoom__ctrl" data-zoom-out aria-label="Zoom out">&minus;</button>
  </div>
</div>

{{ 'component-modal.css' | asset_url | stylesheet_tag }}
<div class="modal" id="size-chart-modal" aria-hidden="true">
  <div class="modal__overlay"></div>
  <div class="modal__panel" role="dialog" aria-label="Size guide">
    <div class="modal__header">
      <h2 class="modal__title">Size guide</h2>
      <button class="modal__close" data-modal-close aria-label="Close">
        {%- render 'icon-close' -%}
      </button>
    </div>
    <div class="modal__body" id="size-chart-content">
      {%- if section.settings.size_chart_content != blank -%}
        {{ section.settings.size_chart_content }}
      {%- else -%}
        <p>Size chart coming soon.</p>
      {%- endif -%}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Product Info",
  "class": "section-product-info",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_short_description",
      "label": "Show short description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_appointment_link",
      "label": "Show appointment link",
      "default": false
    },
    {
      "type": "url",
      "id": "appointment_link",
      "label": "Appointment page link"
    },
    {
      "type": "url",
      "id": "size_calculator_url",
      "label": "Size calculator link"
    },
    {
      "type": "header",
      "content": "Returns tab"
    },
    {
      "type": "text",
      "id": "returns_intro",
      "label": "Intro line",
      "info": "{days} is replaced with the return window for the selected country, so the sentence can never contradict the table above it.",
      "default": "You have {days} days from the date of delivery to return or exchange items."
    },
    {
      "type": "textarea",
      "id": "returns_rules",
      "label": "Returns by country",
      "info": "CODE|window days|exchange|store credit|to card. Costs are free text. A country with no line here is treated as not-yet-offered. Add a ROW line to catch every country not named. Keep in sync with the refund policy.",
      "default": "US|14|Free|Free|$35"
    },
    {
      "type": "text",
      "id": "returns_unavailable",
      "label": "Message where returns aren't offered",
      "default": "Returns & Exchanges are not yet offered for your region. Our team is working hard to roll this feature out."
    },
    {
      "type": "text",
      "id": "returns_label_exchange",
      "label": "Row label — exchange",
      "default": "Exchange"
    },
    {
      "type": "text",
      "id": "returns_label_credit",
      "label": "Row label — store credit",
      "default": "Return · Store credit"
    },
    {
      "type": "text",
      "id": "returns_label_card",
      "label": "Row label — refund to card",
      "default": "Return · To card"
    },
    {
      "type": "text",
      "id": "returns_start_label",
      "label": "Primary link label",
      "default": "Start a return"
    },
    {
      "type": "url",
      "id": "returns_start_url",
      "label": "Primary link URL"
    },
    {
      "type": "text",
      "id": "returns_policy_label",
      "label": "Secondary link label",
      "default": "Read our return policy"
    },
    {
      "type": "url",
      "id": "returns_policy_url",
      "label": "Secondary link URL"
    },
    {
      "type": "header",
      "content": "Desktop image framing"
    },
    {
      "type": "select",
      "id": "desktop_image_fit",
      "label": "Desktop image fit",
      "info": "Cover fills the frame and crops; contain shows the whole image with padding.",
      "options": [
        {
          "value": "cover",
          "label": "Cover (crop to fill)"
        },
        {
          "value": "contain",
          "label": "Contain (show whole image)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "desktop_focal_y",
      "label": "Desktop crop focal point",
      "info": "Which part of the image to keep when cropping. Upper keeps heads in frame.",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "upper",
          "label": "Upper (recommended)"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "lower",
          "label": "Lower"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "upper"
    },
    {
      "type": "header",
      "content": "Conversion"
    },
    {
      "type": "checkbox",
      "id": "show_payment_terms",
      "label": "Show Shop Pay Installments (pay in 4)",
      "default": true
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock indicator appears at or below",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5
    },
    {
      "type": "url",
      "id": "installments_url",
      "label": "Pay-in-4 'Learn more' link"
    },
    {
      "type": "checkbox",
      "id": "hide_shop_promise",
      "label": "Hide Shopify's Shop Promise box",
      "info": "Left unticked, Shop Promise shows and our urgency line hides itself so only one delivery date is on the page.",
      "default": false
    },
    {
      "type": "header",
      "content": "Delivery estimator"
    },
    {
      "type": "paragraph",
      "content": "One line per country. A theme cannot read shipping rates at runtime, so this table is generated from Settings → Shipping and delivery and must be regenerated when rates change. A country with no line here shows as not-shipped-to rather than guessing."
    },
    {
      "type": "text",
      "id": "standard_label",
      "label": "Standard service name",
      "default": "Foreign Air"
    },
    {
      "type": "text",
      "id": "express_label",
      "label": "Express service name",
      "default": "Express Air"
    },
    {
      "type": "textarea",
      "id": "delivery_rates",
      "label": "Rates by country",
      "info": "CODE|standard fastest|standard slowest|express fastest|express slowest|standard price|express price — days are business days, \"-\" disables a tier, prices are free text. Add a ROW line to catch every country not named.",
      "default": "US|3|5|1|2|$10|$20"
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "label": "Same-day dispatch cutoff (hour, 24h)",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 13
    },
    {
      "type": "select",
      "id": "delivery_timezone",
      "label": "Warehouse time zone",
      "info": "The cutoff is read in this zone, not the shopper's. Without it a New York shopper is told a Los Angeles cutoff passed three hours early.",
      "options": [
        {
          "value": "America/Los_Angeles",
          "label": "Los Angeles (Pacific)"
        },
        {
          "value": "America/Denver",
          "label": "Denver (Mountain)"
        },
        {
          "value": "America/Chicago",
          "label": "Chicago (Central)"
        },
        {
          "value": "America/New_York",
          "label": "New York (Eastern)"
        },
        {
          "value": "Europe/London",
          "label": "London"
        },
        {
          "value": "Europe/Paris",
          "label": "Paris"
        },
        {
          "value": "Asia/Shanghai",
          "label": "Shanghai"
        }
      ],
      "default": "America/Los_Angeles"
    },
    {
      "type": "richtext",
      "id": "size_chart_content",
      "label": "Size chart content"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
