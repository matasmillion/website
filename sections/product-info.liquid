{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign app_blocks = section.blocks | where: 'type', '@app'

  # FABRIC. Resolved once so the tab button and its panel cannot disagree about
  # whether there is anything to show.
  #
  # TWO KEY TRAPS, both from fields that predate the current naming:
  #   "Fabric (Back)"        is custom.fabric_image, NOT fabric_back
  #   "Fabric (Composition)" is custom.composition,  NOT fabric_composition
  #   "Fabric (Weight)"      is custom.weight,       NOT fabric_weight
  # Everything else follows the obvious fabric_* convention.
  assign fabric_text = product.metafields.custom.fabric.value
  assign fabric_front = product.metafields.custom.fabric_front.value
  assign fabric_back = product.metafields.custom.fabric_image.value
  assign fabric_name = product.metafields.custom.fabric_name.value
  assign fabric_type = product.metafields.custom.fabric_type.value
  assign fabric_composition = product.metafields.custom.composition.value
  assign fabric_weight = product.metafields.custom.weight.value
  assign fabric_method = product.metafields.custom.fabric_method.value
  assign fabric_certs = product.metafields.custom.fabric_certifications.value
  assign has_fabric = false
  if fabric_text != blank or fabric_front != blank or fabric_back != blank
    assign has_fabric = true
  endif
  # Specs alone are enough to earn the tab — a product can carry the cloth's
  # composition without anyone having shot the swatch yet.
  if fabric_name != blank or fabric_type != blank or fabric_composition != blank or fabric_weight != blank or fabric_method != blank or fabric_certs != blank
    assign has_fabric = true
  endif

  # MODEL MEASUREMENTS. Imperial for the US, metric everywhere else — the US is
  # the only market we sell to that reads feet and pounds. Resolved from the
  # storefront's country, the same source the Returns panel defaults its picker
  # to, so it is server-rendered and never flashes the wrong units.
  #
  # This replaces custom.model_stats, which was read here for months but has no
  # metafield definition and no value on any product — the line on screen was
  # actually coming from custom.sizing.
  assign model_line = product.metafields.custom.model_metric_system.value
  if localization.country.iso_code == 'US'
    assign model_imperial = product.metafields.custom.model_imperial.value
    if model_imperial != blank
      assign model_line = model_imperial
    endif
  endif

  # custom.sizing is the fit note above that line, and on most products it is
  # real copy — "Fits oversized", "Check size chart", and so on — with the
  # measurements written into it as one more paragraph. Those products have no
  # model_* fields, so nothing collides.
  #
  # On a product that HAS the model fields, a sizing note consisting of nothing
  # but a lone "Model is ..." line is the same fact again in different units.
  # Suppress that one case rather than print it twice. Deliberately narrow: it
  # needs the model fields present AND a single line AND that line naming the
  # model, so a multi-paragraph fit note can never be swallowed.
  #
  # This is a display guard, not a data fix. Clearing the duplicate metafield
  # would be tidier, but the field is shared with the published theme, so that
  # is the merchant's call to make in admin, not ours to make from here.
  assign sizing_copy = product.metafields.custom.sizing.value
  assign show_sizing_copy = true
  if model_line != blank and sizing_copy != blank
    assign sizing_lines = sizing_copy | strip | newline_to_br | split: '<br />'
    assign sizing_kept = ''
    for sizing_line in sizing_lines
      assign sizing_line_trim = sizing_line | strip
      unless sizing_line_trim == blank
        assign sizing_kept = sizing_kept | append: sizing_line_trim | append: '||'
      endunless
    endfor
    assign sizing_kept = sizing_kept | split: '||'
    # Nested rather than `and`-joined: Liquid evaluates conditions right to
    # left, so a one-line version of this reads differently than it looks.
    if sizing_kept.size == 1
      if sizing_kept[0] contains 'Model is'
        assign show_sizing_copy = false
      endif
    endif
  endif

  # Instalment figure — this shop's money format drops decimals, so it is
  # composed by hand rather than via the money filters.
  assign inst_cents = current_variant.price | divided_by: 4
  assign inst_dollars = inst_cents | divided_by: 100
  assign inst_rem = inst_cents | modulo: 100

  # Sale state drives both add-to-cart buttons
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
-%}

{%- comment -%}
  The collection eyebrow, resolved once for both places it appears — the mobile
  band and the desktop details column — so they cannot disagree. See the snippet
  for why product.collections.first is not good enough.

  Not the Story tab: that panel is deliberately copy-only, and the eyebrow sits
  above it in the buy column at both breakpoints already.
{%- endcomment -%}
{%- capture main_collection %}{% render 'main-collection', product: product %}{% endcapture -%}
{%- assign main_collection = main_collection | strip -%}

{{ 'component-product-page.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Band height drives the mobile image height, the fixed band, and scroll
  padding. Declared on :root so html-level rules can resolve it.
{%- endcomment -%}
<style>
  :root { --pdp-band-h: 140px; }
  html { scroll-padding-bottom: var(--pdp-band-h); }

  /* iOS Safari keeps scrolling <html> even when <body> clips, which is what
     leaves a strip of background down the right-hand side. `clip` rather than
     `hidden`: hidden would make html a scroll container and kill the sticky
     gallery. */
  html, body { overflow-x: clip; }
</style>

<div class="pdp" data-pdp data-low-stock-threshold="{{ section.settings.low_stock_threshold | default: 5 }}">
  {%- comment -%} ===== IMAGE GALLERY (LEFT ON DESKTOP) ===== {% endcomment -%}
  {%- liquid
    assign focal_map = 'top:12%,upper:25%,center:50%,lower:75%,bottom:88%' | split: ','
    assign focal_y = '25%'
    for pair in focal_map
      assign kv = pair | split: ':'
      if kv[0] == section.settings.desktop_focal_y
        assign focal_y = kv[1]
      endif
    endfor
  -%}
  <div
    class="pdp__gallery"
    data-product-gallery
    style="--pdp-fit: {{ section.settings.desktop_image_fit | default: 'cover' }}; --pdp-focal-y: {{ focal_y }};"
  >
    <div class="pdp__gallery-main" data-gallery-main>
      {%- for image in product.images -%}
        <div
          class="pdp__gallery-slide{% if forloop.first %} is-active{% endif %}"
          data-gallery-slide="{{ forloop.index0 }}"
          data-zoom-src="{{ image | image_url: width: 2048 }}"
          data-zoom-alt="{{ image.alt | default: product.title | escape }}"
        >
          <img
            src="{{ image | image_url: width: 1200 }}"
            srcset="{{ image | image_url: width: 600 }} 600w,
                    {{ image | image_url: width: 900 }} 900w,
                    {{ image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 769px) 58vw, 100vw"
            alt="{{ image.alt | default: product.title | escape }}"
            width="{{ image.width }}"
            height="{{ image.height }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            class="pdp__gallery-img"
          >
        </div>
      {%- endfor -%}
    </div>

    <div class="pdp__gallery-rail">
      {%- comment -%}
        The dot column used to live here. Both breakpoints now share the single
        progress bar at the end of this block, so the heart is all the rail holds.
      {%- endcomment -%}
      <button
        class="pdp__wishlist-img"
        data-wishlist-toggle="{{ product.handle }}"
        aria-label="Save {{ product.title }}"
        aria-pressed="false"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>
    </div>

    {%- comment -%} Tag badge, bottom-left (desktop) {% endcomment -%}
    {%- capture badge_label %}{% render 'product-badge-label', product: product %}{% endcapture -%}
    {%- assign badge_label = badge_label | strip -%}
    {%- if badge_label != blank -%}
      <span class="pdp__gallery-badge">{{ badge_label | upcase }}</span>
    {%- endif -%}

    {%- comment -%}
      Cursor-following zoom affordance (desktop): a round white +/- that tracks
      the pointer over the gallery, as in the reference. Hidden on touch.
    {%- endcomment -%}
    <span class="pdp__zoom-cursor" data-zoom-cursor aria-hidden="true">+</span>

    {%- comment -%}
      The only how-many-images affordance at either breakpoint. Mobile: flush to
      the image's bottom edge, filling left to right. Desktop: the same bar stood
      on end at the image's right edge, filling bottom to top.

      Guarded on image count — with one image the bar would sit permanently full,
      announcing a gallery that isn't there.
    {%- endcomment -%}
    {%- if product.images.size > 1 -%}
      <div class="pdp__gallery-progress" aria-hidden="true">
        <span class="pdp__gallery-progress-fill" data-gallery-progress></span>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    ===== STICKY BAND (mobile only) =====
    Replaces the old in-flow mobile band — never duplicates it. global.js wires
    [data-mobile-submit] with singular querySelector in three places, so a
    second copy would silently break variant sync and add-to-cart feedback.
    Must stay inside [data-pdp]: initPdpVariants scopes its lookup to it.
  {%- endcomment -%}
  <div class="pdp-band" data-sticky-band>
    <div class="pdp-band__top">
      <div class="pdp-band__titles">
        {%- if main_collection != blank -%}
          <p class="pdp-band__collection">{{ main_collection }}</p>
        {%- endif -%}
        <h1 class="pdp-band__title">{{ product.title }}</h1>
      </div>
      <button
        class="pdp-band__heart"
        data-wishlist-toggle="{{ product.handle }}"
        aria-label="Save {{ product.title }}"
        aria-pressed="false"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>
    </div>
    <button type="button" class="pdp-band__atc" data-mobile-submit {% unless current_variant.available %}disabled{% endunless %}>
      <span>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
      <span data-mobile-price>
        {%- if on_sale -%}
          <s class="price-was">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
          <span class="price-now">{{ current_variant.price | money_without_trailing_zeros }}</span>
        {%- else -%}
          {{ current_variant.price | money_without_trailing_zeros }}
        {%- endif -%}
      </span>
    </button>
  </div>

  {%- comment -%} ===== PRODUCT DETAILS (RIGHT ON DESKTOP) ===== {% endcomment -%}
  <div class="pdp__details">
    <div class="pdp__details-inner">
      {%- comment -%} Desktop-only: collection label + title {% endcomment -%}
      {%- if main_collection != blank -%}
        <p class="pdp__collection">{{ main_collection }}</p>
      {%- endif -%}

      <h1 class="pdp__title">{{ product.title }}</h1>

      {%- if product.description != blank and section.settings.show_short_description -%}
        <p class="pdp__description">{{ product.description | strip_html | truncate: 200 }}</p>
      {%- endif -%}

      {%- comment -%} ===== COLOR SWATCHES ===== {% endcomment -%}
      {%- for option in product.options_with_values -%}
        {%- if option.name == 'Color' or option.name == 'Colour' -%}
          {%- comment -%}
            The colour name is deliberately not shown — no label above the row,
            no title tooltip on the chips. The chip is the colour; the customer
            meets the name at cart and checkout, on the variant title.
            aria-label stays: it is how a screen reader tells the chips apart,
            and it is not a visual reveal.
          {%- endcomment -%}
          <div class="pdp__swatches">
            <div class="pdp__swatch-list" data-variant-select data-option-position="{{ option.position }}">
              {%- for value in option.values -%}
                {%- liquid
                  # Takes the hex from Shopify's colour metaobject so the chip
                  # is the true colour rather than a guess. The metaobject's
                  # texture image is deliberately not used — a flat chip reads
                  # cleaner at this size. The name map is the fallback for
                  # colours with no metaobject yet.
                  assign swatch_color = blank
                  assign value_down = value | downcase

                  for entry in product.metafields.shopify['color-pattern'].value
                    assign entry_label = entry.label | downcase
                    if entry_label == value_down
                      assign swatch_color = entry.color
                    endif
                  endfor

                  if swatch_color == blank
                    assign color_lower = value | downcase | replace: ' ', ''
                    assign swatch_color = '#000000'
                    if color_lower contains 'black'
                      assign swatch_color = '#000000'
                    elsif color_lower contains 'white' or color_lower contains 'ivory'
                      assign swatch_color = '#FFFFFF'
                    elsif color_lower contains 'navy'
                      assign swatch_color = '#1B2A4A'
                    elsif color_lower contains 'stone'
                      assign swatch_color = '#716F71'
                    elsif color_lower contains 'brown' or color_lower contains 'tan'
                      assign swatch_color = '#8B6914'
                    elsif color_lower contains 'green' or color_lower contains 'khaki' or color_lower contains 'olive'
                      assign swatch_color = '#556B2F'
                    elsif color_lower contains 'blue'
                      assign swatch_color = '#3B5998'
                    elsif color_lower contains 'red' or color_lower contains 'burgundy'
                      assign swatch_color = '#8B0000'
                    elsif color_lower contains 'grey' or color_lower contains 'gray'
                      assign swatch_color = '#808080'
                    elsif color_lower contains 'beige' or color_lower contains 'sand' or color_lower contains 'cream'
                      assign swatch_color = '#D4C5A9'
                    elsif color_lower contains 'pink'
                      assign swatch_color = '#D4A0A0'
                    elsif color_lower contains 'orange'
                      assign swatch_color = '#C4632A'
                    elsif color_lower contains 'yellow'
                      assign swatch_color = '#D4B44A'
                    elsif color_lower contains 'purple'
                      assign swatch_color = '#663399'
                    endif
                  endif
                -%}
                <button
                  type="button"
                  class="pdp__swatch{% if option.selected_value == value %} is-selected{% endif %}"
                  data-variant-option="{{ value }}"
                  aria-label="{{ value }}"
                  aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                  style="background-color: {{ swatch_color }};{% if swatch_color == '#FFFFFF' %} border-color: rgba(0,0,0,0.2);{% endif %}"
                ></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} ===== SIZE SELECTOR + ADD TO CART ===== {% endcomment -%}
      {%- form 'product', product, data-add-to-cart: true, class: 'pdp__form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <script type="application/json" data-variant-json>{{ product.variants | json }}</script>
        {%- comment -%}
          product.variants JSON omits inventory, so remaining units are passed
          separately for the low-stock indicator. Only tracked variants appear.
        {%- endcomment -%}
        {%- liquid
          assign inv_pairs = ''
          for v in product.variants
            if v.inventory_management != blank
              assign pair = v.id | append: '":' | prepend: '"' | append: v.inventory_quantity
              if inv_pairs == ''
                assign inv_pairs = pair
              else
                assign inv_pairs = inv_pairs | append: ',' | append: pair
              endif
            endif
          endfor
        -%}
        <script type="application/json" data-inventory-json>{ {{- inv_pairs -}} }</script>

        {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- unless option.name == 'Color' or option.name == 'Colour' -%}
            <div class="pdp__sizes">
              {%- comment -%}
                No "SIZE" label — the numbers read as sizes on their own. The
                size-guide link used to sit here; it now lives in the Sizing tab
                with the rest of the fit information, so the buy column stays
                colour → size → add to cart with nothing in between.
              {%- endcomment -%}
              {%- comment -%} Low stock — only meaningful when inventory is tracked {% endcomment -%}
              {%- if option.name == 'Size' -%}
                <p class="pdp__low-stock" data-low-stock hidden></p>
              {%- endif -%}
              <div class="pdp__size-buttons" data-variant-select data-option-position="{{ option.position }}">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="pdp__size-btn{% if option.selected_value == value %} is-selected{% endif %}"
                    data-variant-option="{{ value }}"
                    aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endunless -%}
        {%- endfor -%}
        {%- endunless -%}

        {%- comment -%}
          Pay in 4. Shopify's {{ form | payment_terms }} renders a locked-down
          web component — its Shop Pay lockup and wording can't be restyled or
          reworded, and at 14px type under a 20px lockup it reads as an ad
          dropped into a column set in 11px. So the line is written here
          instead, with the instalment figure derived from the variant price
          and kept in sync by JS.

          Above the button, not below: it is a condition on the price about to
          be committed to, not a footnote to a decision already made.

          Gated on the eligible order range as well as on the setting. Outside
          that range Shop Pay does not offer instalments at checkout, so the
          line would be promising something the cart cannot honour. Set the
          minimum to 0 to show it on everything.
        {%- endcomment -%}
        {%- if section.settings.show_payment_terms -%}
          {%- liquid
            assign inst_min = section.settings.installments_min | default: 0 | times: 100
            assign inst_max = section.settings.installments_max | default: 1000000 | times: 100
            assign inst_eligible = false
            if current_variant.price >= inst_min and current_variant.price <= inst_max
              assign inst_eligible = true
            endif
          -%}
          <p
            class="pdp__terms"
            data-terms
            data-terms-min="{{ inst_min }}"
            data-terms-max="{{ inst_max }}"
            {% unless inst_eligible %}hidden{% endunless %}
          >
            Or 4 payments of&nbsp;<span data-installment>${{ inst_dollars }}.{% if inst_rem < 10 %}0{% endif %}{{ inst_rem }}</span> at 0% interest with&nbsp;<a
              href="{{ section.settings.installments_url | default: 'https://shop.app/pay-installments' }}"
              class="pdp__terms-mark"
              target="_blank"
              rel="noopener"
              aria-label="Shop Pay — how instalments work"
            ><span>shop</span><span class="pdp__terms-mark-pay">Pay</span></a>
          </p>
        {%- endif -%}

        <button
          type="submit"
          class="pdp__add-btn"
          data-add-btn
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span class="pdp__add-text">
            {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
          </span>
          <span class="pdp__add-price" data-price>
            {%- if on_sale -%}
              <s class="price-was">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
              <span class="price-now">{{ current_variant.price | money_without_trailing_zeros }}</span>
            {%- else -%}
              {{ current_variant.price | money_without_trailing_zeros }}
            {%- endif -%}
          </span>
        </button>

      {%- endform -%}

      {%- comment -%}
        Back in stock — shown only when the selected variant is unavailable.
        Klaviyo's Back in Stock is opened from here; see global.js.
      {%- endcomment -%}
      {%- comment -%}
        Back in stock is handled entirely by Klaviyo's injected
        .klaviyo-bis-trigger button; the theme only restyles it.
      {%- endcomment -%}




      {%- comment -%}
        Shop Promise mounts here. Shopify injects it via content_for_header, so
        Liquid cannot place it directly — but shop_promise_pdp.js looks for
        .delivery-promise__promise-container first and mounts into it, and only
        failing that hunts for a form[action*="/cart/add"] to inject itself into
        structurally. Claiming the hook is what puts the box above our urgency
        line rather than wherever the form's markup happens to allow.

        It is restyled, not left as Shopify ships it: the grey pill and 14px type
        are undone in component-product-page.css, which also explains how a
        shadow root is reachable at all. The element is <delivery-promise-wc>;
        the shop-promise-banner and [class*="shop-promise"] selectors that read
        plausibly match nothing.
      {%- endcomment -%}
      <div class="delivery-promise__promise-container"></div>

      {%- comment -%}
        The escape hatch, for the day Shopify rebuilds the widget and the skin
        stops landing. Hiding it here rather than deleting it is the only option
        available — see the placement note above. With the box gone the urgency
        line has nothing to stand down for, so it shows on every product.
      {%- endcomment -%}
      {%- if section.settings.hide_shop_promise -%}
        <style>
          delivery-promise-wc,
          .delivery-promise__promise-container { display: none !important; }
        </style>
      {%- endif -%}

      {%- comment -%} Rolling urgency — same date engine as the estimator {% endcomment -%}
      <p class="pdp__urgency" data-delivery-urgency hidden>
        <span class="dest__pulse" aria-hidden="true"></span>
        <span data-urgency-text></span>
      </p>

      {%- if section.settings.show_appointment_link -%}
        <a href="{{ section.settings.appointment_link }}" class="pdp__appointment">
          See availability and book an appointment in store
        </a>
      {%- endif -%}

      {%- comment -%}
        ===== TABS =====
        Story · Sizing · Fabric · Shipping · Returns. Fabric appears only where
        the product carries a custom.fabric metafield, so the tab count varies
        by product — the JS pairs buttons to panels by name over whatever is
        present rather than assuming a fixed set.
      {%- endcomment -%}
      {%- comment -%}
        Story opens on load at every breakpoint — it is the one panel that
        justifies the product, so it should never need a click to be read.
        The rest start closed; clicking a tab slides its panel in, clicking the
        active tab again closes it (including Story).
      {%- endcomment -%}
      <div class="pdp__tabs" data-pdp-tabs>
        <div class="pdp__tab-list" role="tablist">
          <button class="pdp__tab is-active" role="tab" data-tab="story" aria-selected="true" aria-expanded="true">Story</button>
          <button class="pdp__tab" role="tab" data-tab="sizing" aria-selected="false" aria-expanded="false">Sizing</button>
          {%- comment -%}
            Composition is product-specific, so the tab only exists where the
            metafield does — an empty Fabric tab is worse than no Fabric tab.
            The tab JS pairs [data-tab] to [data-tab-panel] by name over
            whatever is present, so omitting both needs no JS change.
          {%- endcomment -%}
          {%- if has_fabric -%}
            <button class="pdp__tab" role="tab" data-tab="fabric" aria-selected="false" aria-expanded="false">Fabric</button>
          {%- endif -%}
          <button class="pdp__tab" role="tab" data-tab="shipping" aria-selected="false" aria-expanded="false">Shipping</button>
          <button class="pdp__tab" role="tab" data-tab="returns" aria-selected="false" aria-expanded="false">Returns</button>
        </div>

        {%- comment -%} ===== STORY ===== {% endcomment -%}
        {%- comment -%}
          Copy only. The collection, product title and SKU reference all sit
          above this in the buy column already — repeating them here padded the
          panel without telling the customer anything new.
        {%- endcomment -%}
        <div class="pdp__tab-panel is-active" data-tab-panel="story" role="tabpanel">
          {%- liquid
            assign story = product.metafields.custom.product_story
            if story == blank
              assign story = product.description
            endif
          -%}
          {%- if story != blank -%}
            <div class="pdp__tab-description">{{ story }}</div>
          {%- endif -%}
        </div>

        {%- comment -%} ===== SIZING ===== {% endcomment -%}
        <div class="pdp__tab-panel" data-tab-panel="sizing" role="tabpanel">
          {%- comment -%}
            ACTIONS FIRST, then the copy. Someone opening Sizing is trying to
            pick a size, not read — the two tools that answer that question lead
            the panel and the measurements support them underneath.

            The SmartSize app block renders here and nowhere else: an app block
            can only be output once, so moving it out of the buy column meant
            moving it, not copying it. Products with no Size option get it too,
            since the panel is unconditional.

            In practice both live buttons arrive from SmartSize's app EMBEDS,
            which inject #smartrecom-triggers at runtime; initSmartSizePlacement
            PREPENDS that wrapper to this panel so it lands above this copy too.
            The two theme links below are dormant (both settings are blank) but
            are ordered to match, so enabling one changes nothing about layout.
          {%- endcomment -%}
          {%- if app_blocks.size > 0 -%}
            {%- for block in app_blocks -%}
              <div class="pdp__size-guide-slot" {{ block.shopify_attributes }}>{% render block %}</div>
            {%- endfor -%}
          {%- endif -%}

          {%- if section.settings.size_chart_content != blank or section.settings.size_calculator_url != blank -%}
            <div class="pdp__size-actions">
              {%- if section.settings.size_calculator_url != blank -%}
                <a href="{{ section.settings.size_calculator_url }}" class="pdp__size-btn-cta pdp__size-btn-cta--primary">Find my size</a>
              {%- endif -%}
              {%- if section.settings.size_chart_content != blank -%}
                <button type="button" class="pdp__size-btn-cta" data-modal-open="size-chart-modal">Size guide</button>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if sizing_copy != blank and show_sizing_copy -%}
            <div class="pdp__tab-description">{{ sizing_copy | newline_to_br }}</div>
          {%- endif -%}

          {%- comment -%} Imperial or metric, resolved at the top of this file {%- endcomment -%}
          {%- if model_line != blank -%}
            <p class="pdp__tab-meta">{{ model_line }}</p>
          {%- endif -%}
        </div>

        {%- comment -%} ===== FABRIC ===== {% endcomment -%}
        {%- if has_fabric -%}
          <div class="pdp__tab-panel" data-tab-panel="fabric" role="tabpanel">
            {%- comment -%}
              THE CLOTH LEADS. Name, then the swatch, then the prose, then the
              specs — identity, evidence, story, data. The description used to
              open the panel, which asked people to read about a texture before
              being shown it.

              The name is a brand-level object, not a per-product one: the same
              cloth recurs across styles and gets its own entry on the fabric
              page. Setting it in the same words on every product using it is
              what makes that legible on the PDP.
            {%- endcomment -%}
            {%- if fabric_name != blank -%}
              <p class="pdp__fabric-name">{{ fabric_name }}</p>
            {%- endif -%}

            {%- comment -%}
              Front and back of the cloth. Either may be missing — the grid is
              auto-fit so a lone image fills the width instead of sitting in
              half of an empty two-column row.

              data-zoom-open/-src/-alt hand these to the gallery's existing
              lightbox; see initPdpZoom. 2048 matches the gallery's zoom source,
              since the whole point of opening one is to inspect the weave.
            {%- endcomment -%}
            {%- if fabric_front != blank or fabric_back != blank -%}
              <div class="pdp__fabric-shots">
                {%- if fabric_front != blank -%}
                  <button
                    type="button"
                    class="pdp__fabric-shot"
                    data-zoom-open
                    data-zoom-src="{{ fabric_front | image_url: width: 2048 }}"
                    data-zoom-alt="{{ product.title | escape }} fabric, front"
                    aria-label="View {{ product.title | escape }} fabric front full screen"
                  >
                    <img
                      src="{{ fabric_front | image_url: width: 800 }}"
                      srcset="{{ fabric_front | image_url: width: 400 }} 400w,
                              {{ fabric_front | image_url: width: 800 }} 800w,
                              {{ fabric_front | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 769px) 20vw, 45vw"
                      alt="{{ product.title | escape }} fabric, front"
                      width="{{ fabric_front.width }}"
                      height="{{ fabric_front.height }}"
                      loading="lazy"
                      decoding="async"
                    >
                    <span class="pdp__fabric-caption">Front</span>
                  </button>
                {%- endif -%}
                {%- if fabric_back != blank -%}
                  <button
                    type="button"
                    class="pdp__fabric-shot"
                    data-zoom-open
                    data-zoom-src="{{ fabric_back | image_url: width: 2048 }}"
                    data-zoom-alt="{{ product.title | escape }} fabric, back"
                    aria-label="View {{ product.title | escape }} fabric back full screen"
                  >
                    <img
                      src="{{ fabric_back | image_url: width: 800 }}"
                      srcset="{{ fabric_back | image_url: width: 400 }} 400w,
                              {{ fabric_back | image_url: width: 800 }} 800w,
                              {{ fabric_back | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 769px) 20vw, 45vw"
                      alt="{{ product.title | escape }} fabric, back"
                      width="{{ fabric_back.width }}"
                      height="{{ fabric_back.height }}"
                      loading="lazy"
                      decoding="async"
                    >
                    <span class="pdp__fabric-caption">Back</span>
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if fabric_text != blank -%}
              {%- comment -%} newline_to_br: .pdp__tab-description has no pre-line, so the composition and weight lines would otherwise run together. {%- endcomment -%}
              <div class="pdp__tab-description">{{ fabric_text | newline_to_br }}</div>
            {%- endif -%}

            {%- comment -%}
              Spec table. Shares its rules with the returns table rather than
              carrying a copy of them, so the two cannot drift apart — see
              .pdp__spec-* in component-product-page.css. Every row is guarded:
              a blank field drops its row rather than printing an empty value.
            {%- endcomment -%}
            {%- if fabric_type != blank or fabric_composition != blank or fabric_weight != blank or fabric_method != blank or fabric_certs != blank -%}
              <ul class="pdp__spec-list">
                {%- if fabric_type != blank -%}
                  <li class="pdp__spec-row">
                    <span class="pdp__spec-label">Type</span>
                    <span class="pdp__spec-value">{{ fabric_type }}</span>
                  </li>
                {%- endif -%}
                {%- if fabric_composition != blank -%}
                  <li class="pdp__spec-row">
                    <span class="pdp__spec-label">Composition</span>
                    <span class="pdp__spec-value">{{ fabric_composition }}</span>
                  </li>
                {%- endif -%}
                {%- if fabric_weight != blank -%}
                  <li class="pdp__spec-row">
                    <span class="pdp__spec-label">Weight</span>
                    <span class="pdp__spec-value">{{ fabric_weight }}</span>
                  </li>
                {%- endif -%}
                {%- comment -%}
                  Flush right with every other value — the column of values down
                  the right edge is the point of the table, and Method breaking
                  out of it read as a mistake rather than as emphasis.

                  --wrap because this row is prose where the others are figures:
                  it has to be free to run onto a second line if a merchant
                  writes a longer method than "Brushed & Fleeced Interior".
                {%- endcomment -%}
                {%- if fabric_method != blank -%}
                  <li class="pdp__spec-row">
                    <span class="pdp__spec-label">Method</span>
                    <span class="pdp__spec-value pdp__spec-value--wrap">{{ fabric_method }}</span>
                  </li>
                {%- endif -%}
                {%- comment -%}
                  Certifications are a list of image files (OEKO-TEX, OCS …), so
                  the value cell holds marks rather than words.
                {%- endcomment -%}
                {%- if fabric_certs != blank -%}
                  <li class="pdp__spec-row">
                    <span class="pdp__spec-label">Certifications</span>
                    <span class="pdp__spec-value pdp__spec-value--marks">
                      {%- for cert in fabric_certs -%}
                        <img
                          src="{{ cert | image_url: height: 48 }}"
                          alt="{{ cert.alt | default: 'Certification' | escape }}"
                          loading="lazy"
                          decoding="async"
                        >
                      {%- endfor -%}
                    </span>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} ===== SHIPPING ===== {% endcomment -%}
        {%- comment -%}
          Stripped to the zip gate on purpose: free-shipping line, then the
          estimator, then nothing. The date only gets read if it is the only
          thing to read, so resist re-adding transit tables, express tiers or
          payment-method copy here — payment icons already live at checkout.
        {%- endcomment -%}
        <div class="pdp__tab-panel" data-tab-panel="shipping" role="tabpanel">
          {%- render 'delivery-estimator',
            delivery_rates: section.settings.delivery_rates,
            cutoff_hour: section.settings.cutoff_hour,
            delivery_timezone: section.settings.delivery_timezone,
            standard_label: section.settings.standard_label,
            express_label: section.settings.express_label
          -%}
        </div>

        {%- comment -%}
          ===== RETURNS =====
          The window, then the three outcomes ranked best-to-worst, then the
          action. Support hours and the contact link were cut — nobody opens
          Returns to find a phone number, and they buried the one line that
          costs money.

          Terms are one per line in the theme editor; the separators are
          rendered as hairlines rather than typed dashes.
        {%- endcomment -%}
        <div class="pdp__tab-panel pdp__tab-panel--returns" data-tab-panel="returns" role="tabpanel" data-returns-panel>
          {%- comment -%}
            Returns vary by region — the refund policy offers them in the USA,
            calls them "offered soon" for EU/UK/CA/AUS and unavailable
            elsewhere — so the panel resolves against a country the same way the
            delivery estimator does. Both pickers share one stored choice, so
            setting it in either tab moves the other.
          {%- endcomment -%}
          {%- assign ret_here = localization.country.iso_code | default: 'US' -%}
          <div class="dest__entry">
            <label class="dest__hint" for="ret-country">Select your country</label>
            <div class="dest__row">
              <select id="ret-country" class="dest__select" data-returns-country>
                {%- if localization.available_countries.size > 0 -%}
                  {%- for country in localization.available_countries -%}
                    <option value="{{ country.iso_code }}" {% if country.iso_code == ret_here %}selected{% endif %}>{{ country.name }}</option>
                  {%- endfor -%}
                {%- else -%}
                  <option value="{{ ret_here }}" selected>{{ localization.country.name | default: 'United States' }}</option>
                {%- endif -%}
              </select>
            </div>
          </div>

          <script type="text/plain" data-returns-rules>{{ section.settings.returns_rules | escape }}</script>

          {%- comment -%}
            Costs first, window second. What a return costs is the question that
            decides the purchase; how many days you have to decide is the
            qualifier on it. The sentence reads as a footnote to the table.
            Rows are written by JS from the rules table — the labels stay
            settings so the wording is still the merchant's.
          {%- endcomment -%}
          <ul class="pdp__returns-terms" data-returns-terms hidden>
            <li class="pdp__returns-term">
              <span class="pdp__returns-term-label">{{ section.settings.returns_label_exchange | default: 'Exchange' }}</span>
              <span class="pdp__returns-term-value" data-returns-exchange></span>
            </li>
            <li class="pdp__returns-term">
              <span class="pdp__returns-term-label">{{ section.settings.returns_label_credit | default: 'Return · Store credit' }}</span>
              <span class="pdp__returns-term-value" data-returns-credit></span>
            </li>
            <li class="pdp__returns-term">
              <span class="pdp__returns-term-label">{{ section.settings.returns_label_card | default: 'Return · To card' }}</span>
              <span class="pdp__returns-term-value" data-returns-card></span>
            </li>
          </ul>

          {%- comment -%}
            {days} is substituted from the rules table so the window can never
            contradict the row above it.
          {%- endcomment -%}
          {%- comment -%}
            No `| default:` here. A literal {days} inside a {{ }} output tag is
            a Liquid syntax error — the parser reads the brace as the start of a
            tag and never finds its terminator. The fallback lives in the JS,
            where a brace is just a character.
          {%- endcomment -%}
          <p class="pdp__returns-intro" data-returns-intro data-template="{{ section.settings.returns_intro | escape }}" hidden></p>

          {%- comment -%}
            Two rows, not one sentence. The first states the position; the
            second is the reassurance, and it only lands if it is not buried at
            the tail of the first. `hidden` stays on the wrapper — that is the
            node initReturnsByCountry toggles — so the paragraphs inside are
            never individually addressed by JS.
          {%- endcomment -%}
          <div class="pdp__returns-none" data-returns-none hidden>
            <p class="pdp__returns-intro pdp__returns-intro--muted">{{ section.settings.returns_unavailable | default: 'Returns & Exchanges are not yet offered for your region.' }}</p>
            {%- if section.settings.returns_unavailable_note != blank -%}
              <p class="pdp__returns-note">{{ section.settings.returns_unavailable_note }}</p>
            {%- endif -%}
          </div>

          <div class="pdp__returns-actions" data-returns-actions>
            {%- if section.settings.returns_start_label != blank -%}
              <a href="{{ section.settings.returns_start_url | default: '/pages/track-order' }}" class="pdp__tab-link" data-returns-start>{{ section.settings.returns_start_label }}</a>
            {%- endif -%}
            {%- if section.settings.returns_policy_label != blank -%}
              <a href="{{ section.settings.returns_policy_url | default: '/pages/returns' }}" class="pdp__tab-link pdp__tab-link--quiet">{{ section.settings.returns_policy_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  COMPLETE THE LOOK now lives in its own section
  (sections/product-complete-the-look.liquid) so the products can be curated
  per SKU via the custom.complete_the_look metafield.
{%- endcomment -%}


{%- comment -%} ===== ZOOM LIGHTBOX ===== {% endcomment -%}
<div class="pdp-zoom" data-pdp-zoom aria-hidden="true" role="dialog" aria-label="Zoom image">
  <div class="pdp-zoom__stage" data-zoom-stage>
    <img class="pdp-zoom__img" data-zoom-img alt="">
  </div>
  <button class="pdp-zoom__close" data-zoom-close aria-label="Close">
    {%- render 'icon-close' -%}
  </button>
  <div class="pdp-zoom__ctrls">
    <button class="pdp-zoom__ctrl" data-zoom-in aria-label="Zoom in">+</button>
    <button class="pdp-zoom__ctrl" data-zoom-out aria-label="Zoom out">&minus;</button>
  </div>
</div>

{{ 'component-modal.css' | asset_url | stylesheet_tag }}
<div class="modal" id="size-chart-modal" aria-hidden="true">
  <div class="modal__overlay"></div>
  <div class="modal__panel" role="dialog" aria-label="Size guide">
    <div class="modal__header">
      <h2 class="modal__title">Size guide</h2>
      <button class="modal__close" data-modal-close aria-label="Close">
        {%- render 'icon-close' -%}
      </button>
    </div>
    <div class="modal__body" id="size-chart-content">
      {%- if section.settings.size_chart_content != blank -%}
        {{ section.settings.size_chart_content }}
      {%- else -%}
        <p>Size chart coming soon.</p>
      {%- endif -%}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Product Info",
  "class": "section-product-info",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_short_description",
      "label": "Show short description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_appointment_link",
      "label": "Show appointment link",
      "default": false
    },
    {
      "type": "url",
      "id": "appointment_link",
      "label": "Appointment page link"
    },
    {
      "type": "url",
      "id": "size_calculator_url",
      "label": "Size calculator link"
    },
    {
      "type": "header",
      "content": "Returns tab"
    },
    {
      "type": "text",
      "id": "returns_intro",
      "label": "Intro line",
      "info": "{days} is replaced with the return window for the selected country, so the sentence can never contradict the table above it.",
      "default": "You have {days} days from the date of delivery to return or exchange items."
    },
    {
      "type": "textarea",
      "id": "returns_rules",
      "label": "Returns by country",
      "info": "CODE|window days|exchange|store credit|to card. Costs are free text. A country with no line here is treated as not-yet-offered. Add a ROW line to catch every country not named. Keep in sync with the refund policy.",
      "default": "US|14|Free|Free|$35"
    },
    {
      "type": "text",
      "id": "returns_unavailable",
      "label": "Message where returns aren't offered",
      "info": "The position. Keep the reassurance in the line below it — as one sentence the second half gets lost.",
      "default": "Returns & Exchanges are not yet offered for your region."
    },
    {
      "type": "text",
      "id": "returns_unavailable_note",
      "label": "Message where returns aren't offered — second line",
      "info": "Rendered on its own row, under the message above. Leave blank to show only the first line.",
      "default": "Our team is working hard to roll this feature out."
    },
    {
      "type": "text",
      "id": "returns_label_exchange",
      "label": "Row label — exchange",
      "default": "Exchange"
    },
    {
      "type": "text",
      "id": "returns_label_credit",
      "label": "Row label — store credit",
      "default": "Return · Store credit"
    },
    {
      "type": "text",
      "id": "returns_label_card",
      "label": "Row label — refund to card",
      "default": "Return · To card"
    },
    {
      "type": "text",
      "id": "returns_start_label",
      "label": "Primary link label",
      "default": "Start a return"
    },
    {
      "type": "url",
      "id": "returns_start_url",
      "label": "Primary link URL"
    },
    {
      "type": "text",
      "id": "returns_policy_label",
      "label": "Secondary link label",
      "default": "Read our return policy"
    },
    {
      "type": "url",
      "id": "returns_policy_url",
      "label": "Secondary link URL"
    },
    {
      "type": "header",
      "content": "Desktop image framing"
    },
    {
      "type": "select",
      "id": "desktop_image_fit",
      "label": "Desktop image fit",
      "info": "Cover fills the frame and crops; contain shows the whole image with padding.",
      "options": [
        {
          "value": "cover",
          "label": "Cover (crop to fill)"
        },
        {
          "value": "contain",
          "label": "Contain (show whole image)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "desktop_focal_y",
      "label": "Desktop crop focal point",
      "info": "Which part of the image to keep when cropping. Upper keeps heads in frame.",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "upper",
          "label": "Upper (recommended)"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "lower",
          "label": "Lower"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "upper"
    },
    {
      "type": "header",
      "content": "Conversion"
    },
    {
      "type": "checkbox",
      "id": "show_payment_terms",
      "label": "Show Shop Pay Installments (pay in 4)",
      "default": true
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock indicator appears at or below",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5
    },
    {
      "type": "url",
      "id": "installments_url",
      "label": "Pay-in-4 link",
      "info": "Where the Shop Pay mark at the end of the line goes. Defaults to shop.app/pay-installments."
    },
    {
      "type": "number",
      "id": "installments_min",
      "label": "Pay-in-4 line shows at or above ($)",
      "info": "Shop Pay only finances orders inside an eligible range, so below this the line is hidden rather than promising something checkout will not honour. Confirm the current figure in your Shop Pay dashboard. Set to 0 to show it on every product.",
      "default": 50
    },
    {
      "type": "number",
      "id": "installments_max",
      "label": "Pay-in-4 line shows at or below ($)",
      "default": 3000
    },
    {
      "type": "checkbox",
      "id": "hide_shop_promise",
      "label": "Hide Shopify's Shop Promise box",
      "info": "Left unticked, Shop Promise shows restyled to match the theme, and our urgency countdown hides itself on products it covers so only one delivery date is on the page.",
      "default": false
    },
    {
      "type": "header",
      "content": "Delivery estimator"
    },
    {
      "type": "paragraph",
      "content": "One line per country. A theme cannot read shipping rates at runtime, so this table is generated from Settings → Shipping and delivery and must be regenerated when rates change. A country with no line here shows as not-shipped-to rather than guessing."
    },
    {
      "type": "text",
      "id": "standard_label",
      "label": "Standard service name",
      "default": "Foreign Air"
    },
    {
      "type": "text",
      "id": "express_label",
      "label": "Express service name",
      "default": "Express Air"
    },
    {
      "type": "textarea",
      "id": "delivery_rates",
      "label": "Rates by country",
      "info": "CODE|standard fastest|standard slowest|express fastest|express slowest|standard price|express price — days are business days, \"-\" disables a tier, prices are free text. Add a ROW line to catch every country not named.",
      "default": "US|3|5|1|2|$10|$20"
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "label": "Same-day dispatch cutoff (hour, 24h)",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 13
    },
    {
      "type": "select",
      "id": "delivery_timezone",
      "label": "Warehouse time zone",
      "info": "The cutoff is read in this zone, not the shopper's. Without it a New York shopper is told a Los Angeles cutoff passed three hours early.",
      "options": [
        {
          "value": "America/Los_Angeles",
          "label": "Los Angeles (Pacific)"
        },
        {
          "value": "America/Denver",
          "label": "Denver (Mountain)"
        },
        {
          "value": "America/Chicago",
          "label": "Chicago (Central)"
        },
        {
          "value": "America/New_York",
          "label": "New York (Eastern)"
        },
        {
          "value": "Europe/London",
          "label": "London"
        },
        {
          "value": "Europe/Paris",
          "label": "Paris"
        },
        {
          "value": "Asia/Shanghai",
          "label": "Shanghai"
        }
      ],
      "default": "America/Los_Angeles"
    },
    {
      "type": "richtext",
      "id": "size_chart_content",
      "label": "Size chart content"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}