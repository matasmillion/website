{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign detail_rows = section.blocks | where: 'type', 'detail_row'
-%}

{{ 'component-product-page.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

<div class="pdp" data-pdp data-low-stock-threshold="{{ section.settings.low_stock_threshold | default: 5 }}">
  {%- comment -%} ===== IMAGE GALLERY (LEFT ON DESKTOP) ===== {% endcomment -%}
  <div class="pdp__gallery" data-product-gallery>
    <div class="pdp__gallery-main" data-gallery-main>
      {%- for image in product.images -%}
        <div class="pdp__gallery-slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide="{{ forloop.index0 }}">
          <img
            src="{{ image | image_url: width: 1200 }}"
            srcset="{{ image | image_url: width: 600 }} 600w,
                    {{ image | image_url: width: 900 }} 900w,
                    {{ image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 769px) 58vw, 100vw"
            alt="{{ image.alt | default: product.title | escape }}"
            width="{{ image.width }}"
            height="{{ image.height }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            class="pdp__gallery-img"
          >
        </div>
      {%- endfor -%}
    </div>

    {%- if product.images.size > 1 -%}
      <div class="pdp__gallery-dots">
        {%- for image in product.images -%}
          <button
            class="pdp__gallery-dot{% if forloop.first %} is-active{% endif %}"
            data-gallery-dot="{{ forloop.index0 }}"
            aria-label="View image {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
      <button class="pdp__gallery-nav pdp__gallery-nav--prev" data-gallery-prev aria-label="Previous image">
        <svg width="8" height="13" viewBox="0 0 8 13" fill="none" stroke="currentColor" stroke-width="1"><polyline points="7 1 1 6.5 7 12"/></svg>
      </button>
      <button class="pdp__gallery-nav pdp__gallery-nav--next" data-gallery-next aria-label="Next image">
        <svg width="8" height="13" viewBox="0 0 8 13" fill="none" stroke="currentColor" stroke-width="1"><polyline points="1 1 7 6.5 1 12"/></svg>
      </button>
    {%- endif -%}

    {%- comment -%} Wishlist on image — desktop only {% endcomment -%}
    <button
      class="pdp__wishlist-img"
      data-wishlist-toggle="{{ product.handle }}"
      aria-label="Save {{ product.title }}"
      aria-pressed="false"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>
  </div>

  {%- comment -%} ===== MOBILE BAND: title + heart + ATC (mobile only, below image) ===== {% endcomment -%}
  <div class="pdp__mobile-band">
    <div class="pdp__mobile-top">
      <h1 class="pdp__mobile-title">{{ product.title }}</h1>
      <button
        class="pdp__mobile-heart"
        data-wishlist-toggle="{{ product.handle }}"
        aria-label="Save {{ product.title }}"
        aria-pressed="false"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>
    </div>
    <button type="button" class="pdp__mobile-atc" data-mobile-submit {% unless current_variant.available %}disabled{% endunless %}>
      <span>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
      <span data-mobile-price>{{ current_variant.price | money_without_trailing_zeros }}</span>
    </button>
  </div>

  {%- comment -%} ===== PRODUCT DETAILS (RIGHT ON DESKTOP) ===== {% endcomment -%}
  <div class="pdp__details">
    <div class="pdp__details-inner">
      {%- comment -%} Desktop-only: collection label + title {% endcomment -%}
      {%- if product.collections.size > 0 -%}
        <p class="pdp__collection">{{ product.collections.first.title }}</p>
      {%- endif -%}

      <h1 class="pdp__title">{{ product.title }}</h1>

      {%- if product.description != blank and section.settings.show_short_description -%}
        <p class="pdp__description">{{ product.description | strip_html | truncate: 200 }}</p>
      {%- endif -%}

      {%- comment -%} ===== COLOR SWATCHES ===== {% endcomment -%}
      {%- for option in product.options_with_values -%}
        {%- if option.name == 'Color' or option.name == 'Colour' -%}
          <div class="pdp__swatches">
            <p class="pdp__swatch-label">{{ option.selected_value }}</p>
            <div class="pdp__swatch-list" data-variant-select data-option-position="{{ option.position }}">
              {%- for value in option.values -%}
                {%- liquid
                  assign color_lower = value | downcase | replace: ' ', ''
                  assign swatch_color = '#000000'
                  if color_lower contains 'black'
                    assign swatch_color = '#000000'
                  elsif color_lower contains 'white' or color_lower contains 'ivory'
                    assign swatch_color = '#FFFFFF'
                  elsif color_lower contains 'navy'
                    assign swatch_color = '#1B2A4A'
                  elsif color_lower contains 'brown' or color_lower contains 'tan'
                    assign swatch_color = '#8B6914'
                  elsif color_lower contains 'green' or color_lower contains 'khaki' or color_lower contains 'olive'
                    assign swatch_color = '#556B2F'
                  elsif color_lower contains 'blue'
                    assign swatch_color = '#3B5998'
                  elsif color_lower contains 'red' or color_lower contains 'burgundy'
                    assign swatch_color = '#8B0000'
                  elsif color_lower contains 'grey' or color_lower contains 'gray'
                    assign swatch_color = '#808080'
                  elsif color_lower contains 'beige' or color_lower contains 'sand' or color_lower contains 'cream'
                    assign swatch_color = '#D4C5A9'
                  elsif color_lower contains 'pink'
                    assign swatch_color = '#D4A0A0'
                  elsif color_lower contains 'orange'
                    assign swatch_color = '#C4632A'
                  elsif color_lower contains 'yellow'
                    assign swatch_color = '#D4B44A'
                  elsif color_lower contains 'purple'
                    assign swatch_color = '#663399'
                  endif
                -%}
                <button
                  type="button"
                  class="pdp__swatch{% if option.selected_value == value %} is-selected{% endif %}"
                  data-variant-option="{{ value }}"
                  aria-label="{{ value }}"
                  aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                  style="background-color: {{ swatch_color }};{% if color_lower contains 'white' or color_lower contains 'ivory' or color_lower contains 'cream' %} border-color: rgba(0,0,0,0.2);{% endif %}"
                  title="{{ value }}"
                ></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} ===== SIZE SELECTOR + ADD TO CART ===== {% endcomment -%}
      {%- form 'product', product, data-add-to-cart: true, class: 'pdp__form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <script type="application/json" data-variant-json>{{ product.variants | json }}</script>
        {%- comment -%}
          product.variants JSON omits inventory, so remaining units are passed
          separately for the low-stock indicator. Only tracked variants appear.
        {%- endcomment -%}
        {%- liquid
          assign inv_pairs = ''
          for v in product.variants
            if v.inventory_management != blank
              assign pair = v.id | append: '":' | prepend: '"' | append: v.inventory_quantity
              if inv_pairs == ''
                assign inv_pairs = pair
              else
                assign inv_pairs = inv_pairs | append: ',' | append: pair
              endif
            endif
          endfor
        -%}
        <script type="application/json" data-inventory-json>{ {{- inv_pairs -}} }</script>

        {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- unless option.name == 'Color' or option.name == 'Colour' -%}
            <div class="pdp__sizes">
              {%- comment -%}
                No "SIZE" label — the numbers read as sizes on their own. The
                size-guide link is the SmartSize app block, rendered here so it
                sits where the old button did.
              {%- endcomment -%}
              {%- if option.name == 'Size' and app_blocks.size > 0 -%}
                <div class="pdp__size-header">
                  {%- for block in app_blocks -%}
                    <div class="pdp__size-guide-slot" {{ block.shopify_attributes }}>{% render block %}</div>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- comment -%} Low stock — only meaningful when inventory is tracked {% endcomment -%}
              {%- if option.name == 'Size' -%}
                <p class="pdp__low-stock" data-low-stock hidden></p>
              {%- endif -%}
              <div class="pdp__size-buttons" data-variant-select data-option-position="{{ option.position }}">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="pdp__size-btn{% if option.selected_value == value %} is-selected{% endif %}"
                    data-variant-option="{{ value }}"
                    aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endunless -%}
        {%- endfor -%}
        {%- endunless -%}

        <button
          type="submit"
          class="pdp__add-btn"
          data-add-btn
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <svg class="pdp__add-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="pdp__add-text">
            {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
          </span>
          <span class="pdp__add-price" data-price>{{ current_variant.price | money_without_trailing_zeros }}</span>
        </button>

        {%- comment -%}
          Pay in 4. Shopify's {{ form | payment_terms }} renders a locked-down
          web component — its Shop Pay lockup and wording can't be restyled or
          reworded. So the line is written here instead, with the instalment
          figure derived from the variant price and kept in sync by JS.
        {%- endcomment -%}
        {%- if section.settings.show_payment_terms -%}
          <p class="pdp__terms">
            Pay in four interest-free installments of
            {%- liquid
              assign inst_cents = current_variant.price | divided_by: 4
              assign inst_dollars = inst_cents | divided_by: 100
              assign inst_rem = inst_cents | modulo: 100 | prepend: '00' | slice: -2, 2
            -%}<span data-installment>${{ inst_dollars }}.{{ inst_rem }}</span>.
            <a href="{{ section.settings.installments_url | default: 'https://shop.app/pay-installments' }}"
               class="pdp__terms-link" target="_blank" rel="noopener">Learn more</a>
          </p>
        {%- endif -%}
      {%- endform -%}

      {%- comment -%}
        Back in stock — shown only when the selected variant is unavailable.
        Klaviyo's Back in Stock is opened from here; see global.js.
      {%- endcomment -%}
      <div
        class="pdp__notify-wrap"
        data-notify
        data-variant="{{ current_variant.id }}"
        data-klaviyo-company="{{ section.settings.klaviyo_company_id }}"
        {% if current_variant.available %}hidden{% endif %}
      >
        <button type="button" class="pdp__notify" data-notify-open>
          {{ section.settings.notify_label | default: 'Notify me when available' }}
        </button>

        <div class="pdp__notify-form" data-notify-form hidden>
          <label class="pdp__notify-hint" for="notify-email">
            We'll email you the moment this size is back.
          </label>
          <div class="pdp__notify-row">
            <input
              type="email"
              id="notify-email"
              class="pdp__notify-input"
              placeholder="you@email.com"
              autocomplete="email"
              data-notify-email
            >
            <button type="button" class="pdp__notify-submit" data-notify-submit>Notify me</button>
          </div>
          <p class="pdp__notify-msg" data-notify-msg hidden></p>
        </div>
      </div>



      {%- comment -%}
        Shopify injects its Shop Promise box next to the buy button via
        content_for_header, so it can't be removed in Liquid — only hidden.
        Our urgency line plus the estimator now cover the same ground, and two
        delivery dates computed two different ways is worse than one.
      {%- endcomment -%}
      {%- if section.settings.hide_shop_promise -%}
        <style>
          shop-promise-banner,
          [class*="shop-promise"],
          [id*="shop-promise"]:not(script) { display: none !important; }
        </style>
      {%- endif -%}

      {%- comment -%} Rolling urgency — same date engine as the estimator {% endcomment -%}
      <p class="pdp__urgency" data-delivery-urgency hidden>
        <span class="dest__pulse" aria-hidden="true"></span>
        <span data-urgency-text></span>
      </p>

      {%- if section.settings.show_appointment_link -%}
        <a href="{{ section.settings.appointment_link }}" class="pdp__appointment">
          See availability and book an appointment in store
        </a>
      {%- endif -%}

      {%- comment -%} ===== TABS ===== {% endcomment -%}
      {%- comment -%}
        Panels start closed — clicking a tab slides its panel in, clicking the
        active tab again closes it.
      {%- endcomment -%}
      <div class="pdp__tabs" data-pdp-tabs>
        <div class="pdp__tab-list" role="tablist">
          <button class="pdp__tab" role="tab" data-tab="story" aria-selected="false" aria-expanded="false">Story</button>
          <button class="pdp__tab" role="tab" data-tab="sizing" aria-selected="false" aria-expanded="false">Sizing</button>
          <button class="pdp__tab" role="tab" data-tab="delivery" aria-selected="false" aria-expanded="false">Delivery &amp; Returns</button>
        </div>

        {%- comment -%} ===== STORY ===== {% endcomment -%}
        <div class="pdp__tab-panel" data-tab-panel="story" role="tabpanel">
          {%- if product.collections.size > 0 -%}
            <p class="pdp__tab-collection">{{ product.collections.first.title | upcase }}</p>
          {%- endif -%}
          <p class="pdp__tab-subtitle">{{ product.title }}</p>
          {%- liquid
            assign story = product.metafields.custom.product_story
            if story == blank
              assign story = product.description
            endif
          -%}
          {%- if story != blank -%}
            <div class="pdp__tab-description">{{ story }}</div>
          {%- endif -%}
          <p class="pdp__tab-meta">Ref. {{ product.variants.first.sku | default: product.id }}</p>
        </div>

        {%- comment -%} ===== SIZING ===== {% endcomment -%}
        <div class="pdp__tab-panel" data-tab-panel="sizing" role="tabpanel">
          {%- if product.metafields.custom.sizing != blank -%}
            <div class="pdp__tab-description">{{ product.metafields.custom.sizing }}</div>
          {%- endif -%}

          {%- if product.metafields.custom.model_stats != blank -%}
            <p class="pdp__tab-meta">{{ product.metafields.custom.model_stats }}</p>
          {%- endif -%}

          {%- if section.settings.size_chart_content != blank -%}
            <button type="button" class="pdp__tab-link" data-modal-open="size-chart-modal">Size guide</button>
          {%- endif -%}

          {%- if section.settings.size_calculator_url != blank -%}
            <a href="{{ section.settings.size_calculator_url }}" class="pdp__tab-link">Find my size</a>
          {%- endif -%}
        </div>

        {%- comment -%} ===== DELIVERY & RETURNS ===== {% endcomment -%}
        <div class="pdp__tab-panel" data-tab-panel="delivery" role="tabpanel">
          {%- render 'delivery-estimator',
            standard_min: section.settings.standard_min,
            standard_max: section.settings.standard_max,
            express_min: section.settings.express_min,
            express_max: section.settings.express_max,
            cutoff_hour: section.settings.cutoff_hour
          -%}

          <p class="dest__label">Free returns</p>
          <p class="pdp__tab-meta">You have 14 days from the date of delivery of your order to return the items for free.</p>
          <a href="/pages/returns" class="pdp__tab-link">Read our return policy</a>

          <p class="dest__label">Secure payment</p>
          <p class="pdp__tab-meta">Credit card, PayPal, Shop Pay</p>

          <p class="pdp__tab-meta pdp__tab-meta--muted">Monday to Friday from 10:00am to 6:00pm CET.</p>
          <a href="/pages/contact" class="pdp__tab-link">Contact form</a>
        </div>
      </div>

      {%- comment -%}
        ===== DETAIL ROWS (Fabric / Colour / Packaging) =====
        Clickable dropdown rows sitting directly below the tabs.
      {%- endcomment -%}
      {%- if detail_rows.size > 0 -%}
        <div class="pdp__rows" data-pdp-rows>
          {%- for block in detail_rows -%}
            <div class="pdp__row" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="pdp__row-trigger"
                data-row-trigger
                aria-expanded="false"
              >
                <span>{{ block.settings.heading }}</span>
                <span class="pdp__row-icon" aria-hidden="true"></span>
              </button>

              <div class="pdp__row-panel" data-row-panel hidden>
                {%- if block.settings.content != blank -%}
                  <div class="pdp__row-copy">{{ block.settings.content }}</div>
                {%- endif -%}

                {%- comment -%}
                  Optional swatch list, one per line: Name|#hex|Description
                  Used by the Colour row to show the full system.
                {%- endcomment -%}
                {%- if block.settings.swatches != blank -%}
                  <ul class="pdp__row-swatches">
                    {%- assign lines = block.settings.swatches | newline_to_br | split: '<br />' -%}
                    {%- for line in lines -%}
                      {%- assign parts = line | strip | split: '|' -%}
                      {%- if parts.size > 1 -%}
                        <li class="pdp__row-swatch">
                          <span class="pdp__row-chip" style="background: {{ parts[1] | strip }};" aria-hidden="true"></span>
                          <span class="pdp__row-swatch-body">
                            <span class="pdp__row-swatch-name">{{ parts[0] | strip }}</span>
                            {%- if parts.size > 2 -%}
                              <span class="pdp__row-swatch-text">{{ parts[2] | strip }}</span>
                            {%- endif -%}
                          </span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                {%- if block.settings.image != blank -%}
                  <img
                    class="pdp__row-media"
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    alt="{{ block.settings.heading | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                  >
                {%- elsif block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'pdp__row-media' }}
                {%- endif -%}

                {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
                  <a class="pdp__tab-link" href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  COMPLETE THE LOOK now lives in its own section
  (sections/product-complete-the-look.liquid) so the products can be curated
  per SKU via the custom.complete_the_look metafield.
{%- endcomment -%}

{%- comment -%} ===== RECENTLY VIEWED ===== {% endcomment -%}
<section class="pdp-recent reveal" data-recently-viewed>
  <h2 class="pdp-recent__heading">Recently viewed</h2>
  <div class="pdp-recent__grid" data-recently-viewed-grid></div>
</section>

{{ 'component-modal.css' | asset_url | stylesheet_tag }}
<div class="modal" id="size-chart-modal" aria-hidden="true">
  <div class="modal__overlay"></div>
  <div class="modal__panel" role="dialog" aria-label="Size guide">
    <div class="modal__header">
      <h2 class="modal__title">Size guide</h2>
      <button class="modal__close" data-modal-close aria-label="Close">
        {%- render 'icon-close' -%}
      </button>
    </div>
    <div class="modal__body" id="size-chart-content">
      {%- if section.settings.size_chart_content != blank -%}
        {{ section.settings.size_chart_content }}
      {%- else -%}
        <p>Size chart coming soon.</p>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function() {
    const handle = '{{ product.handle }}';
    const key = 'fr_recently_viewed';
    try {
      let items = JSON.parse(localStorage.getItem(key)) || [];
      items = items.filter(h => h !== handle);
      items.unshift(handle);
      items = items.slice(0, 8);
      localStorage.setItem(key, JSON.stringify(items));
    } catch(e) {}
  })();
</script>

{% schema %}
{
  "name": "Product Info",
  "class": "section-product-info",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_short_description",
      "label": "Show short description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_appointment_link",
      "label": "Show appointment link",
      "default": false
    },
    {
      "type": "url",
      "id": "appointment_link",
      "label": "Appointment page link"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery estimate text",
      "default": "Order today for delivery within 5 business days"
    },
    {
      "type": "url",
      "id": "size_calculator_url",
      "label": "Size calculator link"
    },
    {
      "type": "header",
      "content": "Conversion"
    },
    {
      "type": "checkbox",
      "id": "show_payment_terms",
      "label": "Show Shop Pay Installments (pay in 4)",
      "default": true
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock indicator appears at or below",
      "min": 1, "max": 20, "step": 1, "default": 5
    },
    {
      "type": "text",
      "id": "notify_label",
      "label": "Back-in-stock button label",
      "default": "Notify me when available"
    },
    {
      "type": "text",
      "id": "klaviyo_company_id",
      "label": "Klaviyo public API key",
      "info": "Klaviyo → Settings → API keys. Used for back-in-stock signups.",
      "default": "WuWz5B"
    },
    {
      "type": "url",
      "id": "installments_url",
      "label": "Pay-in-4 'Learn more' link"
    },
    {
      "type": "checkbox",
      "id": "hide_shop_promise",
      "label": "Hide Shopify's Shop Promise box",
      "info": "Our estimator and urgency line replace it. Untick to show both.",
      "default": true
    },
    {
      "type": "header",
      "content": "Delivery estimator"
    },
    {
      "type": "paragraph",
      "content": "Business-day transit windows. Keep these in sync with Settings → Shipping and delivery; a theme cannot read shipping rates at runtime."
    },
    {
      "type": "range",
      "id": "standard_min",
      "label": "Standard delivery — fastest (business days)",
      "min": 1, "max": 14, "step": 1, "default": 3
    },
    {
      "type": "range",
      "id": "standard_max",
      "label": "Standard delivery — slowest (business days)",
