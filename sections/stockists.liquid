{%- comment -%}
  Stockists — luxurious editorial grid of retail partners.
  Each stockist is a block (image, city, store name, address, hours, link).
{%- endcomment -%}

<section class="stockists">
  <div class="stockists__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="stockists__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="stockists__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="stockists__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>

  <div class="stockists__grid">
    {%- for block in section.blocks -%}
      <article class="stockist" {{ block.shopify_attributes }}>
        <div class="stockist__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1000 }}"
              srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 769px) 45vw, 100vw"
              alt="{{ block.settings.store_name | escape }}"
              loading="lazy"
              class="stockist__img"
            >
          {%- else -%}
            <div class="stockist__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'stockist__placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
        <div class="stockist__info">
          {%- if block.settings.city != blank -%}
            <p class="stockist__city">{{ block.settings.city }}</p>
          {%- endif -%}
          {%- if block.settings.store_name != blank -%}
            <h2 class="stockist__name">{{ block.settings.store_name }}</h2>
          {%- endif -%}
          {%- if block.settings.address != blank -%}
            <p class="stockist__address">{{ block.settings.address }}</p>
          {%- endif -%}
          {%- if block.settings.hours != blank -%}
            <p class="stockist__hours">{{ block.settings.hours }}</p>
          {%- endif -%}
          {%- if block.settings.map_link != blank -%}
            <a href="{{ block.settings.map_link }}" class="stockist__link" target="_blank" rel="noopener">
              {{ block.settings.map_link_label | default: 'View on map' }}
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

<style>
  .stockists {
    padding: calc(var(--header-height) + var(--space-2xl)) 0 var(--space-section);
  }
  .stockists__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-2xl);
    padding: 0 1.25rem;
  }
  .stockists__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin-bottom: var(--space-md);
  }
  .stockists__heading {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.01em;
    line-height: 1;
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
  }
  .stockists__intro {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-light);
  }
  .stockists__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--grid-gap);
    padding: 0 clamp(1.25rem, 0.5rem + 3vw, 4rem);
  }
  @media (min-width: 769px) {
    .stockists__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(2rem, 1rem + 3vw, 4rem);
    }
  }
  .stockist__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #EAE5DB;
  }
  .stockist__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .stockist:hover .stockist__img { transform: scale(1.03); }
  .stockist__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .stockist__placeholder-svg { width: 40%; opacity: 0.15; }
  .stockist__info {
    padding-top: var(--space-md);
    text-align: center;
  }
  @media (min-width: 769px) {
    .stockist__info { text-align: left; }
  }
  .stockist__city {
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }
  .stockist__name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.01em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .stockist__address,
  .stockist__hours {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-primary);
    opacity: 0.75;
  }
  .stockist__hours { margin-top: 0.25rem; opacity: 0.5; }
  .stockist__link {
    display: inline-block;
    margin-top: var(--space-md);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-primary);
  }
</style>

{% schema %}
{
  "name": "Stockists",
  "class": "section-stockists",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Foreign Resource" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stockists" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Discover Foreign Resource at a curated selection of retailers around the world." }
  ],
  "blocks": [
    {
      "type": "stockist",
      "name": "Stockist",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
