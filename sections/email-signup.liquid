{%- liquid
  assign bg_color = section.settings.bg_color | default: '#F5F0EB'
-%}

<section class="email-signup reveal" style="background-color: {{ bg_color }};">
  <div class="container container--narrow">
    <div class="email-signup__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="email-signup__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="email-signup__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'email-signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="email-signup__success">Thank you — you're subscribed.</p>
        {%- endif -%}
        <div class="email-signup__form">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
            required
            class="email-signup__input"
            aria-label="Email address"
          >
          <button type="submit" class="btn btn--primary email-signup__btn">
            {{ section.settings.button_text | default: 'Subscribe' }}
          </button>
        </div>

        <div class="email-signup__more" data-nl-form>
          <fieldset class="email-signup__gender">
            <legend>Title</legend>
            <label><input type="radio" name="nl_gender" value="Mrs" required> Mrs</label>
            <label><input type="radio" name="nl_gender" value="Mr"> Mr</label>
            <label><input type="radio" name="nl_gender" value="Mx"> Mx</label>
            <label><input type="radio" name="nl_gender" value="Prefer not to say"> I prefer not to say</label>
          </fieldset>
          <input type="text" name="contact[last_name]" class="email-signup__input email-signup__text" placeholder="Last Name" aria-label="Last name" required>
          <input type="text" name="contact[first_name]" class="email-signup__input email-signup__text" placeholder="First Name" aria-label="First name" required>
          <label class="email-signup__dob-label" for="email-signup-dob">Date of birth</label>
          <input type="date" id="email-signup-dob" class="email-signup__dob email-signup__text" aria-label="Date of birth" data-birthday>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  .email-signup {
    padding: var(--space-section) 0;
  }
  .email-signup__inner {
    text-align: center;
    max-width: 420px;
    margin: 0 auto;
  }
  .email-signup__heading {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-normal);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .email-signup__subtext {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }
  .email-signup__form {
    display: flex;
    gap: 0;
    border-bottom: 0.5px solid rgba(10, 10, 10, 0.25);
  }
  .email-signup__input {
    flex: 1;
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    padding: var(--space-sm) 0;
    color: var(--color-primary);
    outline: none;
  }
  .email-signup__input::placeholder {
    color: var(--color-primary);
    opacity: 0.3;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .email-signup__btn {
    background: none;
    border: none;
    color: var(--color-primary);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    padding: var(--space-sm) var(--space-md);
    min-height: 44px;
    opacity: 0.5;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .email-signup__btn:hover {
    opacity: 1;
  }
  .email-signup__dob-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    opacity: 0.5;
    text-align: left;
  }
  .email-signup__more[hidden] { display: none; }
  .email-signup__more {
    margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    text-align: left;
  }
  .email-signup__gender {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
  }
  .email-signup__gender legend {
    width: 100%;
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    opacity: 0.5;
    margin-bottom: 0.4rem;
    padding: 0;
  }
  .email-signup__gender label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    cursor: pointer;
  }
  .email-signup__gender input { accent-color: var(--color-primary); }
  .email-signup__text {
    width: 100%;
    background: none;
    border: none;
    border-bottom: 0.5px solid rgba(10, 10, 10, 0.25);
    padding: var(--space-sm) 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-primary);
    outline: none;
  }
  .email-signup__text::placeholder { color: var(--color-primary); opacity: 0.35; }
  .email-signup__success {
    font-size: var(--text-xs);
    margin-bottom: var(--space-md);
    letter-spacing: 0.05em;
  }
</style>

{% schema %}
{
  "name": "Email Signup",
  "class": "section-email-signup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Journey"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "First access to new collections, travel stories, and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#D4C5A9"
    }
  ],
  "presets": [
    {
      "name": "Email Signup"
    }
  ]
}
{% endschema %}
