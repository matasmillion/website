{%- liquid
  assign bg_color = section.settings.bg_color | default: '#F5F0EB'
-%}

<section class="email-signup reveal" style="background-color: {{ bg_color }};">
  <div class="container container--narrow">
    <div class="email-signup__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="email-signup__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="email-signup__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'email-signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="email-signup__form">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
            required
            class="email-signup__input"
            aria-label="Email address"
          >
          <button type="submit" class="btn btn--primary email-signup__btn">
            {{ section.settings.button_text | default: 'Subscribe' }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  .email-signup {
    padding: var(--space-section) 0;
  }
  .email-signup__inner {
    text-align: center;
    max-width: 420px;
    margin: 0 auto;
  }
  .email-signup__heading {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-normal);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .email-signup__subtext {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }
  .email-signup__form {
    display: flex;
    gap: 0;
    border-bottom: 0.5px solid rgba(10, 10, 10, 0.25);
  }
  .email-signup__input {
    flex: 1;
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    padding: var(--space-sm) 0;
    color: var(--color-primary);
    outline: none;
  }
  .email-signup__input::placeholder {
    color: var(--color-primary);
    opacity: 0.3;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .email-signup__btn {
    background: none;
    border: none;
    color: var(--color-primary);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    padding: var(--space-sm) var(--space-md);
    min-height: 44px;
    opacity: 0.5;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .email-signup__btn:hover {
    opacity: 1;
  }
</style>

{% schema %}
{
  "name": "Email Signup",
  "class": "section-email-signup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Journey"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "First access to new collections, travel stories, and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#D4C5A9"
    }
  ],
  "presets": [
    {
      "name": "Email Signup"
    }
  ]
}
{% endschema %}
