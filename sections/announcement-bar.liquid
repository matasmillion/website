{{ 'component-announcement.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_bar -%}
  <div
    class="announcement-bar"
    style="background-color: {{ section.settings.background }}; color: {{ section.settings.text_color }};"
    role="region"
    aria-label="{{ 'general.accessibility.announcement' | t }}"
  >
    <div class="page-width announcement-bar__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__text">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <span class="announcement-bar__text">{{ section.settings.text | escape }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Complimentary shipping on orders over $150"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F5F0EB"
    }
  ]
}
{% endschema %}
