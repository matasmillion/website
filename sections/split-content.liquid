{%- liquid
  assign image_position = section.settings.image_position | default: 'left'
  assign bg_color = section.settings.bg_color
  assign text_bg = section.settings.text_bg_color
-%}

<section class="split-content reveal" style="{% if bg_color != blank %}background-color: {{ bg_color }};{% endif %}">
  <div class="split-content__inner{% if image_position == 'right' %} split-content__inner--reverse{% endif %}">
    <div class="split-content__image">
      {%- if section.settings.image != blank -%}
        {%- render 'responsive-image', image: section.settings.image, sizes: '50vw', max_width: 1000 -%}
      {%- else -%}
        <div class="split-content__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'split-content__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
    <div class="split-content__text" style="{% if text_bg != blank %}background-color: {{ text_bg }};{% endif %}">
      <div class="split-content__text-inner">
        {%- if section.settings.subheading != blank -%}
          <p class="split-content__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="split-content__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="split-content__body">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn {{ section.settings.cta_style }}">
            {{ section.settings.cta_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .split-content {
    padding: clamp(5rem, 3rem + 6vw, 10rem) 0;
  }
  .split-content__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
    border-top: 1px solid rgba(10, 10, 10, 0.06);
    border-bottom: 1px solid rgba(10, 10, 10, 0.06);
  }
  .split-content__inner--reverse {
    direction: rtl;
  }
  .split-content__inner--reverse > * {
    direction: ltr;
  }
  @media (max-width: 768px) {
    .split-content__inner {
      grid-template-columns: 1fr;
      direction: ltr;
    }
    .split-content__inner > * {
      direction: ltr;
    }
  }
  .split-content__image {
    overflow: hidden;
    min-height: 400px;
  }
  .split-content__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .split-content__placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: var(--color-supporting-sand);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .split-content__placeholder-svg {
    width: 30%;
    opacity: 0.1;
  }
  .split-content__text {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .split-content__text-inner {
    max-width: 460px;
  }
  .split-content__subheading {
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.4;
    margin-bottom: var(--space-sm);
  }
  .split-content__heading {
    font-size: var(--text-5xl);
    font-weight: normal;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .split-content__body {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
  }
</style>

{% schema %}
{
  "name": "Split Content",
  "class": "section-split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Mission"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "To inspire global travel"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Foreign Resource is an aspirational travel lifestyle brand for the modern explorer. We design premium essentials that move with you — from the airport to the city, from the coast to the mountains.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button style",
      "options": [
        { "value": "btn--primary", "label": "Filled" },
        { "value": "btn--secondary", "label": "Outlined" }
      ],
      "default": "btn--secondary"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color"
    },
    {
      "type": "color",
      "id": "text_bg_color",
      "label": "Text column background color"
    }
  ],
  "presets": [
    {
      "name": "Split Content"
    }
  ]
}
{% endschema %}
