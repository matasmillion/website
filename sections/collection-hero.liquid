{{ 'component-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign show_hero = section.settings.show_hero
  assign image = section.settings.image
  assign full_bleed = section.settings.full_bleed

  # Text placement. The setting is one of nine "vertical-horizontal" values;
  # the three legacy values (left / center / right) map onto the middle row so
  # existing collection templates keep the placement they were saved with.
  assign position = section.settings.text_position
  case position
    when 'left'
      assign position = 'middle-left'
    when 'center'
      assign position = 'middle-center'
    when 'right'
      assign position = 'middle-right'
  endcase
  if position == blank
    assign position = 'middle-center'
  endif
  assign position_parts = position | split: '-'
  assign v_position = position_parts[0]
  assign h_position = position_parts[1]

  # Aspect ratio. Every option resolves to a CSS aspect-ratio value, except
  # "full" which is a viewport height instead. Both are always emitted so the
  # mobile custom properties can fall back cleanly to the desktop ones.
  assign ratio = section.settings.aspect_ratio
  assign ratio_mobile = section.settings.aspect_ratio_mobile
  if ratio == blank
    assign ratio = 'natural'
  endif
  if ratio_mobile == blank or ratio_mobile == 'inherit'
    assign ratio_mobile = ratio
  endif

  assign css_ratio = ratio
  assign css_height = 'auto'
  if ratio == 'full'
    assign css_ratio = 'auto'
    assign css_height = '100svh'
  elsif ratio == 'natural'
    assign css_ratio = '16 / 9'
    if image != blank
      assign css_ratio = image.aspect_ratio
    endif
  endif

  assign css_ratio_mobile = ratio_mobile
  assign css_height_mobile = 'auto'
  if ratio_mobile == 'full'
    assign css_ratio_mobile = 'auto'
    assign css_height_mobile = '100svh'
  elsif ratio_mobile == 'natural'
    assign css_ratio_mobile = '16 / 9'
    if image != blank
      assign css_ratio_mobile = image.aspect_ratio
    endif
  endif
-%}

{%- if show_hero -%}
  <section
    class="collection-hero reveal collection-hero--{{ v_position }} collection-hero--{{ h_position }}{% if full_bleed %} collection-hero--flush{% endif %}"
    style="
      --ch-ratio: {{ css_ratio }};
      --ch-h: {{ css_height }};
      --ch-ratio-mobile: {{ css_ratio_mobile }};
      --ch-h-mobile: {{ css_height_mobile }};
    "
  >
    {%- if image != blank -%}
      <img
        src="{{ image | image_url: width: 1920 }}"
        srcset="{{ image | image_url: width: 1000 }} 1000w,
                {{ image | image_url: width: 1400 }} 1400w,
                {{ image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt="{{ collection.title | escape }}"
        width="{{ image.width }}"
        height="{{ image.height }}"
        loading="eager"
        class="collection-hero__image"
      >
    {%- else -%}
      <div class="collection-hero__image" style="background-color: var(--color-supporting-sand);"></div>
    {%- endif -%}
    <div class="collection-hero__overlay" style="background: rgba(0,0,0,{{ overlay_opacity }})"></div>
    <div class="collection-hero__content">
      <h1 class="collection-hero__title">
        {{ section.settings.heading | default: collection.title }}
      </h1>
      {%- if section.settings.subtext != blank -%}
        <p class="collection-hero__description">{{ section.settings.subtext }}</p>
      {%- elsif collection.description != blank and section.settings.show_description -%}
        <p class="collection-hero__description">{{ collection.description | strip_html | truncate: 200 }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection Hero",
  "class": "section-collection-hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show collection hero",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Extend image behind the header",
      "default": true,
      "info": "Lets the transparent header sit over the image, like the homepage hero. Turn this off if the hero is not the first section on the page."
    },
    {
      "type": "header",
      "content": "Image shape"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio (desktop)",
      "options": [
        { "value": "natural", "label": "Original image ratio" },
        { "value": "full", "label": "Full screen height" },
        { "value": "21 / 9", "label": "21:9 — ultra wide" },
        { "value": "16 / 9", "label": "16:9 — wide" },
        { "value": "3 / 2", "label": "3:2 — landscape" },
        { "value": "4 / 3", "label": "4:3 — landscape" },
        { "value": "1 / 1", "label": "1:1 — square" },
        { "value": "4 / 5", "label": "4:5 — portrait" },
        { "value": "3 / 4", "label": "3:4 — portrait" },
        { "value": "2 / 3", "label": "2:3 — tall portrait" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "Aspect ratio (mobile)",
      "options": [
        { "value": "inherit", "label": "Same as desktop" },
        { "value": "natural", "label": "Original image ratio" },
        { "value": "full", "label": "Full screen height" },
        { "value": "16 / 9", "label": "16:9 — wide" },
        { "value": "3 / 2", "label": "3:2 — landscape" },
        { "value": "4 / 3", "label": "4:3 — landscape" },
        { "value": "1 / 1", "label": "1:1 — square" },
        { "value": "4 / 5", "label": "4:5 — portrait" },
        { "value": "3 / 4", "label": "3:4 — portrait" },
        { "value": "2 / 3", "label": "2:3 — tall portrait" }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (leave blank to use collection title)"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description as subtext",
      "default": true
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%"
    }
  ]
}
{% endschema %}
