<div class="filter-bar">
  <div class="filter-bar__inner container">
    <button class="filter-bar__mobile-toggle btn btn--secondary" data-filter-toggle=".filter-bar__filters" aria-label="{{ 'collections.filter' | t }}">
      {{ 'collections.filter' | t }}
    </button>

    <div class="filter-bar__filters">
      {%- for filter in collection.filters -%}
        <div class="filter-bar__group">
          <button class="filter-bar__toggle" data-filter-toggle=".filter-dropdown-{{ filter.param_name }}" aria-expanded="false">
            {{ filter.label }}
            <span class="filter-bar__toggle-icon"></span>
          </button>
          <div class="filter-bar__dropdown filter-dropdown-{{ filter.param_name }}">
            {%- case filter.type -%}
              {%- when 'list' -%}
                {%- for value in filter.values -%}
                  <label class="filter-bar__option">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                    >
                    {{ value.label }}
                    <span class="filter-bar__count">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              {%- when 'price_range' -%}
                <div class="filter-bar__price-range">
                  <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency }}" placeholder="Min" class="filter-bar__price-input" min="0">
                  <span>—</span>
                  <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency }}" placeholder="Max" class="filter-bar__price-input" min="0">
                </div>
            {%- endcase -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="filter-bar__sort">
      <label for="sort-select" class="visually-hidden">{{ 'collections.sort' | t }}</label>
      <select id="sort-select" class="filter-bar__sort-select" data-sort-select>
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if collection.sort_by == option.value %}selected{% endif %}>
            {{ option.name }}
          </option>
        {%- endfor -%}
      </select>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Filter Bar",
  "class": "section-filter-bar",
  "settings": []
}
{% endschema %}
