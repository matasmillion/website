{{ 'component-collection.css' | asset_url | stylesheet_tag }}

{%- comment -%} Jacquemus-style collection header: title + count, then Sort By / Filters {% endcomment -%}
<div class="jc-collection">
  <div class="jc-collection__head container">
    <h1 class="jc-collection__title">
      {{ collection.title }}<sup class="jc-collection__count">{{ collection.products_count }}</sup>
    </h1>
  </div>

  <div class="jc-collection__bar container">
    {%- comment -%} Sort By {% endcomment -%}
    <div class="jc-collection__sort" data-sort-wrap>
      <button type="button" class="jc-collection__sort-toggle" data-filter-toggle=".jc-sort-menu" aria-expanded="false">
        {{ 'collections.sort' | t | default: 'Sort By' }}
      </button>
      <div class="jc-collection__menu jc-sort-menu">
        {%- for option in collection.sort_options -%}
          <a
            href="{{ request.path }}?sort_by={{ option.value }}"
            class="jc-collection__menu-item{% if collection.sort_by == option.value %} is-active{% endif %}"
            data-sort-value="{{ option.value }}"
          >{{ option.name }}</a>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Filters {% endcomment -%}
    <div class="jc-collection__filters" data-filters-wrap>
      <button type="button" class="jc-collection__filters-toggle" data-filter-toggle=".jc-filter-menu" aria-expanded="false">
        {{ 'collections.filter' | t | default: 'Filters' }}
      </button>
      {%- if collection.filters.size > 0 -%}
        <div class="jc-collection__menu jc-collection__menu--filters jc-filter-menu">
          {%- for filter in collection.filters -%}
            <div class="jc-collection__filter-group">
              <p class="jc-collection__filter-heading">{{ filter.label }}</p>
              {%- case filter.type -%}
                {%- when 'list' -%}
                  {%- for value in filter.values -%}
                    <a
                      href="{{ value.url_to_add }}"
                      class="jc-collection__filter-option{% if value.active %} is-active{% endif %}"
                    >
                      {{ value.label }} <span class="jc-collection__filter-count">({{ value.count }})</span>
                    </a>
                  {%- endfor -%}
                {%- when 'price_range' -%}
                  <p class="jc-collection__filter-option">Price filtering available on desktop.</p>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Filter Bar",
  "class": "section-filter-bar",
  "settings": []
}
{% endschema %}
