{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

<section class="wishlist-page">
  <div class="container">
    <h1 class="wishlist-page__heading">{{ section.settings.heading }}</h1>

    <div class="wishlist-page__empty" id="wishlist-empty" style="display: none;">
      <p>{{ section.settings.empty_text }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.empty_cta }}</a>
    </div>

    <div class="wishlist-page__grid" id="wishlist-grid"></div>
  </div>
</section>

<style>
  .wishlist-page {
    padding: calc(var(--header-height) + var(--space-xl)) 0 var(--space-section);
    min-height: 60vh;
  }
  .wishlist-page__heading {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-normal);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: var(--space-xl);
  }
  .wishlist-page__empty {
    text-align: center;
    padding: var(--space-2xl) 0;
  }
  .wishlist-page__empty p {
    font-size: var(--text-base);
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
  }
  .wishlist-page__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--grid-gap);
  }
  @media (max-width: 1024px) {
    .wishlist-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 768px) {
    .wishlist-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .wishlist-page__card {
    position: relative;
  }
  .wishlist-page__card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .wishlist-page__card-link:hover {
    opacity: 1;
  }
  .wishlist-page__card-image {
    aspect-ratio: 2 / 3;
    background-color: var(--color-supporting-sand);
    overflow: hidden;
  }
  .wishlist-page__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wishlist-page__card-info {
    padding: 0.625rem 0.25rem 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  .wishlist-page__card-title {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-normal);
    line-height: 1.3;
  }
  .wishlist-page__card-price {
    font-size: var(--text-sm);
    opacity: 0.5;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .wishlist-page__remove {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: var(--color-secondary);
    border: none;
    cursor: pointer;
    padding: 0.375rem;
    color: var(--color-primary);
    opacity: 0.5;
    transition: opacity var(--duration-fast) var(--ease-out);
    z-index: 2;
  }
  .wishlist-page__remove:hover {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const grid = document.getElementById('wishlist-grid');
    const empty = document.getElementById('wishlist-empty');
    if (!grid || !window.FRWishlist) return;

    const items = window.FRWishlist.get();

    if (items.length === 0) {
      empty.style.display = '';
      grid.style.display = 'none';
      return;
    }

    // Fetch product data for each handle via Shopify's product.json endpoint
    const fetchProduct = async (handle) => {
      try {
        const res = await fetch('/products/' + handle + '.js');
        if (res.ok) return res.json();
      } catch (e) {}
      return null;
    };

    const renderProducts = async () => {
      const products = await Promise.all(items.map(fetchProduct));
      const valid = products.filter(p => p !== null);

      if (valid.length === 0) {
        empty.style.display = '';
        grid.style.display = 'none';
        return;
      }

      grid.innerHTML = valid.map(p => {
        const img = p.featured_image ? p.featured_image : '';
        const price = (p.price / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        return '<div class="wishlist-page__card">' +
          '<button class="wishlist-page__remove" data-wishlist-remove="' + p.handle + '" aria-label="Remove ' + p.title + '">' +
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
          '</button>' +
          '<a href="/products/' + p.handle + '" class="wishlist-page__card-link">' +
            '<div class="wishlist-page__card-image">' +
              (img ? '<img src="' + img + '" alt="' + p.title + '" loading="lazy">' : '') +
            '</div>' +
            '<div class="wishlist-page__card-info">' +
              '<span class="wishlist-page__card-title">' + p.title + '</span>' +
              '<span class="wishlist-page__card-price">' + price + '</span>' +
            '</div>' +
          '</a>' +
        '</div>';
      }).join('');

      // Remove button handlers
      grid.querySelectorAll('[data-wishlist-remove]').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const handle = this.dataset.wishlistRemove;
          window.FRWishlist.toggle(handle);
          this.closest('.wishlist-page__card').remove();
          if (grid.children.length === 0) {
            empty.style.display = '';
            grid.style.display = 'none';
          }
        });
      });
    };

    renderProducts();
  });
</script>

{% schema %}
{
  "name": "Wishlist Page",
  "class": "section-wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Saved Items"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "You haven't saved any items yet."
    },
    {
      "type": "text",
      "id": "empty_cta",
      "label": "Empty state button text",
      "default": "Explore the Collection"
    }
  ]
}
{% endschema %}
