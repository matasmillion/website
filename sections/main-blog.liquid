<style>
  .blog-page {
    padding: var(--space-xl) 0 var(--space-section);
  }
  .blog-page__title {
    font-size: var(--text-4xl);
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .blog-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem) var(--grid-gap);
  }
  @media (min-width: 768px) {
    .blog-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .blog-page__card {
    display: block;
    text-decoration: none;
  }
  .blog-page__image {
    aspect-ratio: 4 / 3;
    background: #EAE5DB;
    overflow: hidden;
    margin-bottom: var(--space-sm);
  }
  .blog-page__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .blog-page__card:hover .blog-page__image img {
    transform: scale(1.03);
  }
  .blog-page__date {
    font-size: var(--text-micro);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-light);
    display: block;
    margin-bottom: 0.375rem;
  }
  .blog-page__card-title {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-normal);
    font-size: var(--text-2xl);
    color: var(--color-primary);
    line-height: 1.3;
  }
  .blog-page__excerpt {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.7;
  }
  .blog-page__empty {
    text-align: center;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-light);
    padding: var(--space-2xl) 0;
  }
  .blog-page__pagination {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: var(--space-xl);
  }
  .blog-page__pagination a {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.125rem;
  }
</style>

<section class="blog-page">
  <div class="container">
    <h1 class="blog-page__title">{{ blog.title }}</h1>

    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="blog-page__grid">
          {%- for article in blog.articles -%}
            <a href="{{ article.url }}" class="blog-page__card">
              {%- if article.image != blank -%}
                <div class="blog-page__image">
                  {%- render 'responsive-image', image: article.image, sizes: '(max-width: 768px) 100vw, 33vw', max_width: 900 -%}
                </div>
              {%- endif -%}
              <span class="blog-page__date">{{ article.published_at | date: '%B %-d, %Y' }}</span>
              <h2 class="blog-page__card-title">{{ article.title }}</h2>
              {%- if article.excerpt != blank -%}
                <p class="blog-page__excerpt">{{ article.excerpt | strip_html | truncate: 140 }}</p>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="blog-page__pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'accessibility.previous' | t }}</a>{%- endif -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'accessibility.next' | t }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <p class="blog-page__empty">{{ 'blog.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
