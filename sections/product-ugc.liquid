{%- comment -%}
  PDP — "See others wear em'".

  Manually curated for now, per the spec: hand-pick who appears rather than
  letting an app auto-pull. Each block is one person — image or video, their
  handle, a link, and a country flag.

  When an app takes over later, keep this section as the styled shell and let
  the app fill it; the layout below is what the brand wants either way.
{%- endcomment -%}

{%- liquid
  # A block with no media would render an empty box under a placeholder
  # handle, so only count the ones carrying an image or video.
  assign filled = 0
  for block in section.blocks
    if block.settings.image != blank or block.settings.video != blank or block.settings.video_url != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}

{%- if filled > 0 -%}
  <section class="ugc reveal">
    {%- if section.settings.heading != blank -%}
      <h2 class="ugc__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="ugc__track">
      {%- for block in section.blocks -%}
        {%- if block.settings.image == blank and block.settings.video == blank and block.settings.video_url == blank -%}
          {%- continue -%}
        {%- endif -%}
        <figure class="ugc__item" {{ block.shopify_attributes }}>
          <div class="ugc__media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'ugc__media-el' }}
            {%- elsif block.settings.video_url != blank -%}
              <video class="ugc__media-el" autoplay muted loop playsinline
                {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 800 }}"{% endif %}>
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
            {%- elsif block.settings.image != blank -%}
              <img
                class="ugc__media-el"
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(min-width: 769px) 30vw, 75vw"
                alt="{{ block.settings.handle | default: 'Customer photo' | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>

          <figcaption class="ugc__caption">
            {%- if block.settings.flag != blank -%}
              <span class="ugc__flag" aria-hidden="true">{{ block.settings.flag }}</span>
            {%- endif -%}
            {%- if block.settings.handle != blank -%}
              {%- if block.settings.link != blank -%}
                <a class="ugc__handle" href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ block.settings.handle }}</a>
              {%- else -%}
                <span class="ugc__handle">{{ block.settings.handle }}</span>
              {%- endif -%}
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </section>

  <style>
    .ugc {
      padding: var(--space-2xl) 0;
      border-top: 1px solid var(--color-border);
    }

    .ugc__heading {
      font-family: var(--font-heading);
      font-size: var(--text-3xl);
      font-weight: var(--font-weight-medium);
      text-transform: uppercase;
      letter-spacing: 0.01em;
      padding: 0 clamp(1.25rem, 0.5rem + 3vw, 4rem);
      margin-bottom: var(--space-lg);
    }

    .ugc__track {
      display: flex;
      gap: var(--grid-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding: 0 clamp(1.25rem, 0.5rem + 3vw, 4rem);
    }
    .ugc__track::-webkit-scrollbar { display: none; }

    .ugc__item {
      flex: 0 0 72%;
      scroll-snap-align: start;
      margin: 0;
    }

    @media (min-width: 769px) {
      .ugc__item { flex: 0 0 calc(28% - var(--grid-gap)); }
    }

    .ugc__media {
      aspect-ratio: 3 / 4;
      overflow: hidden;
      background: #E4DED2;
    }

    .ugc__media-el {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .ugc__caption {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    .ugc__flag { font-size: 13px; line-height: 1; }

    .ugc__handle {
      font-size: 11.5px;
      letter-spacing: 0.03em;
      color: #2D2C2F;
      text-decoration: underline;
    }

    .ugc__handle:hover { opacity: 0.7; }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "PDP UGC",
  "class": "section-pdp-ugc",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See others wear em'" }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "url", "id": "video_url", "label": "External mp4 URL" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@handle" },
        { "type": "url", "id": "link", "label": "Profile link" },
        { "type": "text", "id": "flag", "label": "Country flag emoji", "default": "🇺🇸" }
      ]
    }
  ],
  "presets": [{ "name": "PDP UGC" }]
}
{% endschema %}
