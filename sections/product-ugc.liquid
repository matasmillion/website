{%- comment -%}
  PDP — "See others wear em'".

  Per-product, driven entirely by product metafields. This section used to
  carry the media in its own `person` blocks, but section settings live in
  templates/product.json — one file shared by every product — so whatever was
  picked there showed up identically on all ~23 PDPs. Curation that isn't
  actually per-product reads as a bug, the same trap documented in
  product-complete-the-look.liquid.

  Sources — all per product, index aligned, no fallbacks:
    media    custom.ugc          (list.file_reference, Images)
    handle   custom.ugc_handles  (list.single_line_text_field)
    link     custom.ugc_links    (list.url)
    flag     custom.ugc_flags    (list.single_line_text_field, emoji)

  The four lists are matched by position: the 2nd handle captions the 2nd
  image. Only custom.ugc is required — a product with images and no caption
  lists renders the media on its own rather than "@handle" placeholders. A
  product with no custom.ugc renders no section at all.

  custom.ugc is validated to Images in admin, but the video branch is kept so
  widening that validation later is a one-click change rather than a rewrite.

  When an app takes over later, keep this section as the styled shell and let
  the app fill it; the layout below is what the brand wants either way.
{%- endcomment -%}

{%- liquid
  assign shots = product.metafields.custom.ugc.value
  assign handles = product.metafields.custom.ugc_handles.value
  assign links = product.metafields.custom.ugc_links.value
  assign flags = product.metafields.custom.ugc_flags.value

  assign max_items = section.settings.max_items | default: 12
-%}

{%- if shots != blank and shots.size > 0 -%}
  <section class="ugc reveal">
    {%- if section.settings.heading != blank -%}
      <h2 class="ugc__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="ugc__track">
      {%- for shot in shots limit: max_items -%}
        {%- liquid
          assign i = forloop.index0
          assign handle = handles[i]
          assign link = links[i]
          assign flag = flags[i]

          assign alt = shot.alt
          if alt == blank
            assign alt = handle
          endif
          if alt == blank
            assign alt = 'Customer photo'
          endif
        -%}
        <figure class="ugc__item">
          <div class="ugc__media">
            {%- if shot.media_type == 'video' -%}
              {{ shot | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'ugc__media-el' }}
            {%- else -%}
              <img
                class="ugc__media-el"
                src="{{ shot | image_url: width: 800 }}"
                srcset="{{ shot | image_url: width: 400 }} 400w, {{ shot | image_url: width: 800 }} 800w"
                sizes="(min-width: 769px) 30vw, 75vw"
                alt="{{ alt | escape }}"
                width="{{ shot.width }}"
                height="{{ shot.height }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>

          {%- comment -%}
            A product can have images with no caption lists set yet, so the
            whole figcaption is skipped rather than left as an empty row that
            still eats its margin.
          {%- endcomment -%}
          {%- if handle != blank or flag != blank -%}
            <figcaption class="ugc__caption">
              {%- if flag != blank -%}
                <span class="ugc__flag" aria-hidden="true">{{ flag }}</span>
              {%- endif -%}
              {%- if handle != blank -%}
                {%- if link != blank -%}
                  <a class="ugc__handle" href="{{ link }}" target="_blank" rel="noopener">{{ handle }}</a>
                {%- else -%}
                  <span class="ugc__handle">{{ handle }}</span>
                {%- endif -%}
              {%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </section>

  <style>
    .ugc {
      padding: var(--space-2xl) 0;
      border-top: 1px solid var(--color-border);
    }

    .ugc__heading {
      font-family: var(--font-heading);
      font-size: var(--text-3xl);
      font-weight: var(--font-weight-medium);
      text-transform: uppercase;
      letter-spacing: 0.01em;
      padding: 0 clamp(1.25rem, 0.5rem + 3vw, 4rem);
      margin-bottom: var(--space-lg);
    }

    .ugc__track {
      display: flex;
      gap: var(--grid-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding: 0 clamp(1.25rem, 0.5rem + 3vw, 4rem);
    }
    .ugc__track::-webkit-scrollbar { display: none; }

    .ugc__item {
      flex: 0 0 72%;
      scroll-snap-align: start;
      margin: 0;
    }

    @media (min-width: 769px) {
      .ugc__item { flex: 0 0 calc(28% - var(--grid-gap)); }
    }

    .ugc__media {
      aspect-ratio: 3 / 4;
      overflow: hidden;
      background: #E4DED2;
    }

    .ugc__media-el {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .ugc__caption {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    .ugc__flag { font-size: 13px; line-height: 1; }

    .ugc__handle {
      font-size: 11.5px;
      letter-spacing: 0.03em;
      color: #2D2C2F;
      text-decoration: underline;
    }

    .ugc__handle:hover { opacity: 0.7; }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "PDP UGC",
  "class": "section-pdp-ugc",
  "settings": [
    {
      "type": "paragraph",
      "content": "Content is per product. Set UGC (images) on the product, and optionally UGC Handles, UGC Links and UGC Flags — those three lists are matched to the images by position."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See others wear em'" },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum shots shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [{ "name": "PDP UGC" }]
}
{% endschema %}
