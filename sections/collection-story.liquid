{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection_handle = section.settings.collection
  assign limit = section.settings.products_count | default: 4
  assign hero_images = section.blocks | where: 'type', 'hero_image'
-%}

<section class="cs reveal" id="cs-{{ section.id }}">
  {%- comment -%} Hero Images — 1 or 2 side-by-side (desktop) {% endcomment -%}
  {%- if hero_images.size > 0 -%}
    <div class="cs__heroes cs__heroes--{{ hero_images.size }}">
      {%- for block in hero_images -%}
        <div class="cs__hero" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="cs__hero-link">{%- endif -%}
            {%- if block.settings.video != blank -%}
              <div class="cs__hero-media cs__hero-media--video">
                <video
                  autoplay muted loop playsinline
                  poster="{{ block.settings.image | image_url: width: 1200 }}"
                  class="cs__hero-video"
                >
                  <source src="{{ block.settings.video }}" type="video/mp4">
                </video>
              </div>
            {%- elsif block.settings.image != blank -%}
              <div class="cs__hero-media">
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                          {{ block.settings.image | image_url: width: 900 }} 900w,
                          {{ block.settings.image | image_url: width: 1200 }} 1200w"
                  sizes="{% if hero_images.size == 2 %}(min-width: 769px) 50vw, 100vw{% else %}100vw{% endif %}"
                  alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="cs__hero-img"
                >
              </div>
            {%- else -%}
              <div class="cs__hero-media cs__hero-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'cs__placeholder-svg' }}
              </div>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="cs__hero-label">{{ block.settings.label }}</span>
            {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Product Grid {% endcomment -%}
  <div class="cs__grid">
    {%- if collection_handle != blank -%}
      {%- for product in collections[collection_handle].products limit: limit -%}
        <div class="cs__product">
          {%- render 'product-card', product: product, context: 'homepage' -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="cs__product">
          <article class="product-card product-card--homepage">
            <div class="product-card__image-wrapper product-card__image-wrapper--portrait">
              <div class="product-card__placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}
              </div>
            </div>
          </article>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  .cs {
    margin: 0 0 var(--grid-gap);
    padding: 0;
  }
  .cs__heroes {
    display: grid;
    gap: var(--grid-gap);
  }
  .cs__heroes--1 {
    grid-template-columns: 1fr;
  }
  .cs__heroes--2 {
    grid-template-columns: 1fr;
  }
  @media (min-width: 769px) {
    .cs__heroes--2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cs__hero {
    position: relative;
    overflow: hidden;
  }
  .cs__hero-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .cs__hero-link:hover { opacity: 1; }
  .cs__hero-media {
    position: relative;
    aspect-ratio: 3 / 4;
  }
  @media (min-width: 769px) {
    .cs__heroes--2 .cs__hero-media {
      aspect-ratio: 3 / 4;
    }
    .cs__heroes--1 .cs__hero-media {
      aspect-ratio: 3 / 4;
      max-height: 80vh;
    }
  }
  .cs__hero-img,
  .cs__hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs__hero-placeholder {
    background-color: var(--color-supporting-sand);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cs__placeholder-svg {
    width: 20%;
    opacity: 0.1;
  }
  .cs__hero-label {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-normal);
    color: var(--color-primary);
    letter-spacing: 0.01em;
    z-index: 1;
  }
  @media (min-width: 769px) {
    .cs__hero-label {
      bottom: 3rem;
      left: 3rem;
      font-size: var(--text-lg);
    }
  }

  /* Product Grid */
  .cs__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
    margin-top: var(--grid-gap);
  }
  @media (min-width: 769px) {
    .cs__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .cs__product {
    min-width: 0;
  }
</style>

{% schema %}
{
  "name": "Collection Story",
  "class": "section-collection-story",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "hero_image",
      "name": "Hero Image",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "video",
          "label": "Video URL (MP4)",
          "info": "Optional — overrides the image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Category label",
          "default": "New In Women"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Story",
      "blocks": [
        { "type": "hero_image" }
      ]
    }
  ]
}
{% endschema %}
