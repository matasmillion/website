{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign feature_collection = section.settings.collection
  assign limit = section.settings.products_count | default: 4
  assign hero_images = section.blocks | where: 'type', 'hero_image'
  assign product_count = feature_collection.products.size
-%}

<section class="cs reveal" id="cs-{{ section.id }}">
  {%- comment -%} Hero Images — mobile shows only the first, desktop shows both (even split) {% endcomment -%}
  {%- if hero_images.size > 0 -%}
    <div class="cs__heroes cs__heroes--{{ hero_images.size }}">
      {%- for block in hero_images -%}
        {%- liquid
          assign ratio = block.settings.aspect_ratio | default: '2:3'
          if ratio == 'fill'
            assign media_class = 'cs__hero-media cs__hero-media--fill'
            assign media_style = ''
          else
            assign media_class = 'cs__hero-media'
            capture media_style
              echo ' style="aspect-ratio: '
              echo ratio | replace: ':', ' / '
              echo ';"'
            endcapture
          endif
        -%}
        <div class="cs__hero" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="cs__hero-link">{%- endif -%}
            {%- if block.settings.video != blank -%}
              <div class="{{ media_class }} cs__hero-media--video"{{ media_style }}>
                <video
                  autoplay muted loop playsinline
                  poster="{{ block.settings.image | image_url: width: 1200 }}"
                  class="cs__hero-video"
                >
                  <source src="{{ block.settings.video }}" type="video/mp4">
                </video>
              </div>
            {%- elsif block.settings.image != blank -%}
              <div class="{{ media_class }}"{{ media_style }}>
                <img
                  src="{{ block.settings.image | image_url: width: 1400 }}"
                  srcset="{{ block.settings.image | image_url: width: 700 }} 700w,
                          {{ block.settings.image | image_url: width: 1100 }} 1100w,
                          {{ block.settings.image | image_url: width: 1600 }} 1600w"
                  sizes="{% if hero_images.size == 2 %}(min-width: 769px) 50vw, 100vw{% else %}100vw{% endif %}"
                  alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="cs__hero-img"
                >
              </div>
            {%- else -%}
              <div class="{{ media_class }} cs__hero-placeholder"{{ media_style }}>
                {{ 'lifestyle-1' | placeholder_svg_tag: 'cs__placeholder-svg' }}
              </div>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="cs__hero-label">{{ block.settings.label }}</span>
            {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Product Grid — only when a collection with products is set {% endcomment -%}
  {%- if feature_collection != blank and product_count > 0 -%}
    <div class="cs__grid">
      {%- for product in feature_collection.products limit: limit -%}
        <div class="cs__product">
          {%- comment -%}
            HOMEPAGE RULE: this is a display-only card — image + name, nothing else.
            No price, no compare-at, no sale badge, no wishlist heart.
            Price lives on the collection page and the PDP.
          {%- endcomment -%}
          {%- render 'product-card', product: product, context: 'overlay', show_price: false, show_wishlist: false, show_badge: false -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  .cs {
    margin: 0 0 var(--grid-gap);
    padding: 0;
  }
  /* Heroes: mobile shows only the FIRST image; desktop shows both (even split).
     No gap between hero images — the 3px gap is only for product cards. */
  .cs__heroes {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }
  @media (max-width: 768px) {
    /* Never show a second hero on mobile */
    .cs__heroes .cs__hero:nth-child(n + 2) {
      display: none;
    }
  }
  @media (min-width: 769px) {
    .cs__heroes--2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cs__hero {
    position: relative;
    overflow: hidden;
  }
  .cs__hero-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .cs__hero-link:hover { opacity: 1; }

  /* Media aspect ratio is set inline per block (2:3, 9:16, etc.).
     "fill" fills the viewport height. */
  .cs__hero-media {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
  }
  .cs__hero-media--fill {
    aspect-ratio: auto;
    height: 82vh;
  }
  @media (min-width: 769px) {
    .cs__hero-media--fill {
      height: 100vh;
    }
  }
  .cs__hero-img,
  .cs__hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs__hero-placeholder {
    background-color: #EDEAE3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cs__placeholder-svg {
    width: 20%;
    opacity: 0.12;
  }
  .cs__hero-label {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-normal);
    color: var(--color-primary);
    letter-spacing: 0.01em;
    z-index: 1;
  }
  @media (min-width: 769px) {
    .cs__hero-label {
      bottom: 3rem;
      left: 3rem;
      font-size: var(--text-lg);
    }
  }

  /* Product Grid */
  .cs__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
    margin-top: var(--grid-gap);
  }
  @media (min-width: 769px) {
    .cs__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .cs__product {
    min-width: 0;
  }
</style>

{% schema %}
{
  "name": "Collection Story",
  "class": "section-collection-story",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "hero_image",
      "name": "Hero Image",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Aspect ratio",
          "options": [
            { "value": "fill", "label": "Fill screen height" },
            { "value": "9:16", "label": "9:16 (tall portrait)" },
            { "value": "2:3", "label": "2:3 (portrait)" },
            { "value": "3:4", "label": "3:4 (portrait)" },
            { "value": "4:5", "label": "4:5 (portrait)" },
            { "value": "1:1", "label": "1:1 (square)" },
            { "value": "4:3", "label": "4:3 (landscape)" },
            { "value": "3:2", "label": "3:2 (landscape)" },
            { "value": "16:9", "label": "16:9 (wide)" }
          ],
          "default": "2:3"
        },
        {
          "type": "text",
          "id": "video",
          "label": "Video URL (MP4)",
          "info": "Optional — overrides the image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Category label",
          "default": "New In Women"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Story",
      "blocks": [
        { "type": "hero_image" }
      ]
    }
  ]
}
{% endschema %}
