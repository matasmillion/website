{%- comment -%} Default page — renders the page's title + content {% endcomment -%}
<section class="page-default">
  <div class="page-default__inner">
    {%- if section.settings.show_title and page.title != blank -%}
      <h1 class="page-default__title">{{ page.title }}</h1>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="page-default__content rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

<style>
  .page-default { padding: var(--space-2xl) 0 var(--space-section); }
  .page-default__inner { max-width: 760px; margin: 0 auto; padding: 0 clamp(1.25rem, 1rem + 2vw, 3rem); }
  .page-default__title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: var(--space-lg);
  }
  .page-default__content { font-size: var(--text-base); line-height: 1.85; color: var(--color-primary); }
  .page-default__content p { margin-bottom: 1.2em; }
  .page-default__content h2, .page-default__content h3 { font-family: var(--font-heading); margin: 1.5em 0 0.5em; }
  .page-default__content a { text-decoration: underline; text-underline-offset: 3px; }
</style>

{% schema %}
{
  "name": "Page",
  "class": "section-main-page",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true }
  ]
}
{% endschema %}
