{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection_handle = section.settings.collection
  assign limit = section.settings.products_count
-%}

<section class="featured-products reveal">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="featured-products__header">
        <h2 class="featured-products__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link_url | default: collections[collection_handle].url }}" class="featured-products__link">
            {{ section.settings.link_text }}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="featured-products__carousel" data-carousel>
    <div class="featured-products__track" data-carousel-track>
      {%- if collection_handle != blank -%}
        {%- for product in collections[collection_handle].products limit: limit -%}
          <div class="featured-products__slide">
            {%- render 'product-card', product: product -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <div class="featured-products__slide">
            <article class="product-card">
              <div class="product-card__image-wrapper product-card__image-wrapper--portrait">
                <div class="product-card__placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}
                </div>
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">Product {{ i }}</h3>
                <div class="product-card__price">{{ 8500 | money }}</div>
              </div>
            </article>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <button class="featured-products__arrow featured-products__arrow--prev" data-carousel-prev aria-label="{{ 'accessibility.previous' | t }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="featured-products__arrow featured-products__arrow--next" data-carousel-next aria-label="{{ 'accessibility.next' | t }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</section>

<style>
  .featured-products {
    padding: var(--space-2xl) 0;
  }
  .featured-products__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }
  .featured-products__heading {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
  }
  .featured-products__link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .featured-products__carousel {
    position: relative;
    padding: 0 var(--space-md);
  }
  .featured-products__track {
    display: flex;
    gap: var(--grid-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: var(--space-sm);
  }
  .featured-products__track::-webkit-scrollbar {
    display: none;
  }
  .featured-products__slide {
    flex: 0 0 280px;
    scroll-snap-align: start;
  }
  @media (max-width: 768px) {
    .featured-products__slide {
      flex: 0 0 220px;
    }
  }
  .featured-products__arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-secondary);
    border: var(--border-thin);
    cursor: pointer;
    z-index: 2;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .featured-products__arrow:hover {
    opacity: 0.7;
  }
  .featured-products__arrow--prev { left: 0; }
  .featured-products__arrow--next { right: 0; }
  @media (max-width: 768px) {
    .featured-products__arrow { display: none; }
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "View all link text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "View all link URL"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
