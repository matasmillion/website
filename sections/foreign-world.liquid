{%- comment -%}
  Foreign World — placeholder for the interactive globe (People + Places).
  Real globe code will be dropped in later. This gives the surrounding UI:
  intro, People/Places toggle, placeholder globe, and account/email capture.
{%- endcomment -%}

<section class="fw">
  <div class="fw__hero">
    <p class="fw__eyebrow">{{ section.settings.eyebrow | default: 'Foreign Resource' }}</p>
    <h1 class="fw__title">{{ section.settings.heading | default: 'Foreign World' }}</h1>
    <p class="fw__intro">{{ section.settings.intro }}</p>
  </div>

  {%- comment -%} People / Places toggle {% endcomment -%}
  <div class="fw__toggle" role="tablist" aria-label="View">
    <button class="fw__toggle-btn is-active" data-fw-tab="places" role="tab" aria-selected="true">Places</button>
    <button class="fw__toggle-btn" data-fw-tab="people" role="tab" aria-selected="false">People</button>
  </div>

  {%- comment -%} Globe placeholder {% endcomment -%}
  <div class="fw__globe" data-fw-globe>
    <div class="fw__globe-orb">
      <span class="fw__globe-note">Interactive globe coming soon</span>
    </div>
  </div>

  {%- comment -%} Placeholder feed (Places by default) {% endcomment -%}
  <div class="fw__feed" data-fw-panel="places">
    <h2 class="fw__feed-title">Places</h2>
    <p class="fw__feed-sub">Deep, step-by-step guides to extraordinary journeys — added by the community.</p>
    <div class="fw__grid">
      {%- assign places = 'The coal-ore train, Iran|Salar de Uyuni, Bolivia|Sokotra, Yemen|Lake Baikal ice, Russia|Danakil Depression, Ethiopia|Faroe Islands crossing' | split: '|' -%}
      {%- for place in places -%}
        <article class="fw-card">
          <div class="fw-card__media"><span class="fw-card__pin">◍</span></div>
          <p class="fw-card__label">Place</p>
          <h3 class="fw-card__name">{{ place }}</h3>
          <p class="fw-card__meta">Flights · agents · step-by-step</p>
        </article>
      {%- endfor -%}
    </div>
  </div>

  <div class="fw__feed" data-fw-panel="people" hidden>
    <h2 class="fw__feed-title">People</h2>
    <p class="fw__feed-sub">See where explorers are right now — tap through to their Instagram.</p>
    <div class="fw__grid fw__grid--people">
      {%- assign people = 'Currently: Tbilisi|Currently: Oaxaca|Currently: Chefchaouen|Currently: Hokkaido|Currently: Patagonia|Currently: Lisbon' | split: '|' -%}
      {%- for person in people -%}
        <article class="fw-card fw-card--person">
          <div class="fw-card__avatar"></div>
          <h3 class="fw-card__name">Explorer</h3>
          <p class="fw-card__meta">{{ person }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Account / email capture {% endcomment -%}
  <div class="fw__join">
    <h2 class="fw__join-title">Join Foreign World</h2>
    <p class="fw__join-sub">Create an account to add places, follow people, and share your journeys.</p>
    {%- form 'customer', id: 'fw-join' -%}
      <input type="hidden" name="contact[tags]" value="foreign-world">
      {%- if form.posted_successfully? -%}
        <p class="fw__join-success">You're in — welcome to Foreign World.</p>
      {%- endif -%}
      <div class="fw__join-field" data-nl-form>
        <input type="email" name="contact[email]" class="fw__join-input" placeholder="Email address" aria-label="Email" required>
        <button type="submit" class="fw__join-btn">Create account</button>
      </div>
    {%- endform -%}
  </div>
</section>

<style>
  .fw { padding: var(--space-xl) 0 var(--space-section); }
  .fw__hero {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-xl);
    padding: 0 1.25rem;
  }
  .fw__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin-bottom: var(--space-md);
  }
  .fw__title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 1.5rem + 6vw, 7rem);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-lg);
  }
  .fw__intro { font-size: var(--text-base); line-height: 1.8; color: var(--color-text-light); }

  .fw__toggle {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .fw__toggle-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-light);
    padding: 0 0 0.4rem;
    border-bottom: 1px solid transparent;
  }
  .fw__toggle-btn.is-active { color: var(--color-primary); border-bottom-color: var(--color-primary); }

  .fw__globe { display: flex; justify-content: center; padding: var(--space-lg) 1.25rem var(--space-2xl); }
  .fw__globe-orb {
    width: min(70vw, 420px);
    height: min(70vw, 420px);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, rgba(255,255,255,0.5), transparent 45%),
      repeating-linear-gradient(0deg, rgba(45,44,47,0.12) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(90deg, rgba(45,44,47,0.12) 0 1px, transparent 1px 26px),
      #E4DED2;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset -20px -30px 60px rgba(45,44,47,0.15);
  }
  .fw__globe-note {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    opacity: 0.5;
  }

  .fw__feed { max-width: 1200px; margin: 0 auto; padding: 0 clamp(1.25rem, 0.5rem + 3vw, 4rem) var(--space-2xl); }
  .fw__feed-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .fw__feed-sub { font-size: var(--text-sm); color: var(--color-text-light); margin-bottom: var(--space-lg); }
  .fw__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg) var(--grid-gap);
  }
  @media (min-width: 600px) { .fw__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 900px) { .fw__grid { grid-template-columns: repeat(3, 1fr); } }

  .fw-card__media {
    aspect-ratio: 3 / 2;
    background: #E4DED2;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 0.75rem;
  }
  .fw-card__pin { font-size: 2rem; color: var(--color-primary); opacity: 0.3; }
  .fw-card__label {
    font-size: var(--text-xs); letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--color-text-light); margin-bottom: 0.25rem;
  }
  .fw-card__name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    line-height: 1.15;
    margin-bottom: 0.25rem;
  }
  .fw-card__meta { font-size: var(--text-sm); color: var(--color-text-light); }
  .fw-card--person { text-align: center; }
  .fw-card__avatar {
    width: 72px; height: 72px; border-radius: 50%;
    background: #E4DED2; margin: 0 auto 0.75rem;
  }

  .fw__join {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-2xl) 1.25rem 0;
    border-top: 1px solid var(--color-border);
  }
  .fw__join-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .fw__join-sub { font-size: var(--text-sm); color: var(--color-text-light); margin-bottom: var(--space-lg); }
  .fw__join-field { display: flex; border-bottom: 1px solid var(--color-primary); }
  .fw__join-input {
    flex: 1; background: none; border: none; padding: 0.75rem 0;
    font-family: var(--font-body); font-size: var(--text-sm); color: var(--color-primary);
  }
  .fw__join-input:focus { outline: none; }
  .fw__join-btn {
    background: none; border: none; cursor: pointer;
    font-size: var(--text-xs); letter-spacing: 0.15em; text-transform: uppercase;
    padding: 0 0.5rem; color: var(--color-primary);
  }
  .fw__join-success { font-size: var(--text-sm); margin-bottom: var(--space-md); }
</style>

<script>
  (function () {
    var tabs = document.querySelectorAll('[data-fw-tab]');
    var panels = document.querySelectorAll('[data-fw-panel]');
    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        tabs.forEach(function (x) { x.classList.remove('is-active'); x.setAttribute('aria-selected', 'false'); });
        t.classList.add('is-active'); t.setAttribute('aria-selected', 'true');
        panels.forEach(function (p) { p.hidden = p.getAttribute('data-fw-panel') !== t.getAttribute('data-fw-tab'); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Foreign World",
  "class": "section-foreign-world",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Foreign Resource" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Foreign World" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "An atlas of the extraordinary. Discover places few have been, follow the people going there now, and add your own journeys to the map." }
  ],
  "presets": [{ "name": "Foreign World" }]
}
{% endschema %}
