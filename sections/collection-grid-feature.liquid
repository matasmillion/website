{%- liquid
  assign layout = section.settings.layout
-%}

<section class="collection-feature reveal">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-feature__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="collection-feature__grid collection-feature__grid--{{ layout }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="collection-feature__item" {{ block.shopify_attributes }}>
          <div class="collection-feature__image-wrapper">
            {%- if block.settings.image != blank -%}
              {%- render 'responsive-image', image: block.settings.image, sizes: '(max-width: 768px) 100vw, 50vw', max_width: 1000 -%}
            {%- else -%}
              <div class="collection-feature__placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <div class="collection-feature__overlay collection-feature__overlay--{{ block.settings.text_position | default: 'bottom-left' }}">
              <h3 class="collection-feature__title">{{ block.settings.title }}</h3>
            </div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .collection-feature {
    padding: var(--space-section) 0;
  }
  .collection-feature__heading {
    font-size: var(--text-xs);
    font-weight: normal;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: center;
    margin-bottom: var(--space-xl);
    opacity: 0.4;
  }
  .collection-feature__grid {
    display: grid;
    gap: var(--grid-gap);
  }
  .collection-feature__grid--asymmetric {
    grid-template-columns: 1.5fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .collection-feature__grid--asymmetric .collection-feature__item:first-child {
    grid-row: 1 / 3;
  }
  .collection-feature__grid--equal {
    grid-template-columns: repeat(3, 1fr);
  }
  .collection-feature__grid--two-column {
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 768px) {
    .collection-feature__grid--asymmetric,
    .collection-feature__grid--equal {
      grid-template-columns: 1fr;
    }
    .collection-feature__grid--asymmetric .collection-feature__item:first-child {
      grid-row: auto;
    }
    .collection-feature__grid--two-column {
      grid-template-columns: 1fr;
    }
  }
  .collection-feature__item {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: var(--color-white);
    min-height: 350px;
    border: 1px solid rgba(10, 10, 10, 0.05);
  }
  .collection-feature__image-wrapper {
    position: absolute;
    inset: 0;
  }
  .collection-feature__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--duration-slow) var(--ease-out);
  }
  .collection-feature__item:hover .collection-feature__image-wrapper img {
    opacity: 0.9;
  }
  .collection-feature__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-supporting-sand);
    opacity: 0.1;
  }
  .collection-feature__overlay {
    position: absolute;
    z-index: 1;
    padding: var(--space-lg);
  }
  .collection-feature__overlay--bottom-left {
    bottom: 0;
    left: 0;
  }
  .collection-feature__overlay--center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }
  .collection-feature__overlay--top-left {
    top: 0;
    left: 0;
  }
  .collection-feature__title {
    font-size: var(--text-xl);
    font-weight: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 1px 3px rgba(10, 10, 10, 0.3);
  }
</style>

{% schema %}
{
  "name": "Collection Feature Grid",
  "class": "section-collection-feature",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Collections"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Grid layout",
      "options": [
        { "value": "asymmetric", "label": "Asymmetric (1 large + 2 stacked)" },
        { "value": "equal", "label": "Equal columns" },
        { "value": "two-column", "label": "Two columns" }
      ],
      "default": "asymmetric"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "center", "label": "Center" },
            { "value": "top-left", "label": "Top left" }
          ],
          "default": "bottom-left"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Collection Feature Grid",
      "blocks": [
        { "type": "collection_item", "settings": { "title": "Technical Traveler" } },
        { "type": "collection_item", "settings": { "title": "Staples" } },
        { "type": "collection_item", "settings": { "title": "New Arrivals" } }
      ]
    }
  ]
}
{% endschema %}
