<section class="product-reviews reveal" id="product-reviews">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-reviews__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="product-reviews__container" id="judgeme-reviews-container">
      {%- comment -%}
        Judge.me reviews app will render here.
        Install Judge.me and configure it to target #judgeme-reviews-container.
        The surrounding styles ensure the reviews match the brand aesthetic.
      {%- endcomment -%}
      {%- if request.design_mode -%}
        <div class="product-reviews__placeholder">
          <p>Customer reviews will appear here once Judge.me is installed and configured.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .product-reviews {
    padding: var(--space-2xl) 0;
    border-top: var(--border-thin);
  }
  .product-reviews__heading {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--space-xl);
    opacity: 0.5;
  }
  .product-reviews__placeholder {
    text-align: center;
    padding: var(--space-2xl);
    font-size: var(--text-sm);
    color: var(--color-text-light);
    border: 1px dashed var(--color-border);
  }
  /* Judge.me override styles */
  .product-reviews__container .jdgm-rev-widg {
    font-family: var(--font-body) !important;
  }
  .product-reviews__container .jdgm-rev-widg__title {
    font-family: var(--font-heading) !important;
  }
</style>

{% schema %}
{
  "name": "Reviews (Judge.me)",
  "class": "section-product-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    }
  ],
  "presets": [
    {
      "name": "Reviews Container"
    }
  ]
}
{% endschema %}
