{{ 'component-portal.css' | asset_url | stylesheet_tag }}

<div class="portal-auth page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="portal-auth__inner">
    <div id="login" class="portal-auth__panel" data-login-panel>
      <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
      <h1 class="portal-auth__heading h2">{{ 'customer.login.title' | t }}</h1>

      {%- form 'customer_login', novalidate: 'novalidate', class: 'portal-auth__form' -%}
        {%- if form.errors -%}
          <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="LoginEmail">{{ 'customer.login.email' | t }}</label>
          <input
            id="LoginEmail"
            class="field__input"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            required
          >
        </div>

        <div class="field">
          <label class="field__label" for="LoginPassword">{{ 'customer.login.password' | t }}</label>
          <input
            id="LoginPassword"
            class="field__input"
            type="password"
            name="customer[password]"
            autocomplete="current-password"
            required
          >
        </div>

        <button type="submit" class="button button--full">{{ 'customer.login.sign_in' | t }}</button>

        <div class="portal-auth__aux">
          <a href="#recover" class="link-underline" data-show-recover>{{ 'customer.login.forgot_password' | t }}</a>
        </div>
      {%- endform -%}

      <div class="portal-auth__alt">
        <p class="text-soft">{{ 'customer.login.new_customer' | t }}</p>
        <a href="{{ routes.account_register_url }}" class="link-underline">{{ 'customer.login.create_account' | t }}</a>
      </div>

      {%- if shop.checkout.guest_login -%}
        <div class="portal-auth__alt">
          <p class="text-soft">{{ 'customer.login.guest_title' | t }}</p>
          {%- form 'guest_login' -%}
            <button type="submit" class="button button--outline button--small">{{ 'customer.login.guest_continue' | t }}</button>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div id="recover" class="portal-auth__panel" data-recover-panel hidden>
      <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
      <h2 class="portal-auth__heading h2">{{ 'customer.recover.title' | t }}</h2>
      <p class="text-soft">{{ 'customer.recover.subtext' | t }}</p>

      {%- form 'recover_customer_password', class: 'portal-auth__form' -%}
        {%- assign recover_success = form.posted_successfully? -%}
        {%- if form.errors -%}
          <div class="form__message form__message--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input
            id="RecoverEmail"
            class="field__input"
            type="email"
            name="email"
            autocomplete="email"
            autocapitalize="off"
            required
          >
        </div>

        <button type="submit" class="button button--full">{{ 'customer.recover.submit' | t }}</button>

        <div class="portal-auth__aux">
          <a href="#login" class="link-underline" data-show-login>{{ 'customer.recover.cancel' | t }}</a>
        </div>
      {%- endform -%}
    </div>

    {%- if recover_success -%}
      <div class="form__message portal-auth__success" role="status">
        {{ 'customer.recover.success' | t }}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var loginPanel = document.querySelector('[data-login-panel]');
    var recoverPanel = document.querySelector('[data-recover-panel]');
    if (!loginPanel || !recoverPanel) return;

    function sync() {
      var showRecover = window.location.hash === '#recover';
      recoverPanel.hidden = !showRecover;
      loginPanel.hidden = showRecover;
    }

    window.addEventListener('hashchange', sync);
    sync();
  })();
</script>

{% schema %}
{
  "name": "Login",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ]
}
{% endschema %}
