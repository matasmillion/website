{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

{%- if section.settings.image != blank or request.design_mode -%}
<section class="product-editorial reveal">
  <div class="product-editorial__wrapper">
    {%- if section.settings.image != blank -%}
      {%- render 'responsive-image', image: section.settings.image, sizes: '100vw', max_width: 1920, class: 'product-editorial__image' -%}
    {%- else -%}
      <div class="product-editorial__placeholder"></div>
    {%- endif -%}

    {%- if section.settings.overlay_opacity > 0 -%}
      <div class="product-editorial__overlay" style="background: rgba(0,0,0,{{ overlay_opacity }})"></div>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.cta_text != blank -%}
      <div class="product-editorial__content" style="color: {{ section.settings.text_color }};">
        {%- if section.settings.heading != blank -%}
          <h2 class="product-editorial__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--secondary" style="color: {{ section.settings.text_color }}; border-color: {{ section.settings.text_color }};">
            {{ section.settings.cta_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<style>
  .product-editorial {
    padding: var(--space-xl) 0;
  }
  .product-editorial__wrapper {
    position: relative;
    overflow: hidden;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-editorial__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-editorial__placeholder {
    position: absolute;
    inset: 0;
    background-color: var(--color-supporting-sand);
  }
  .product-editorial__overlay {
    position: absolute;
    inset: 0;
  }
  .product-editorial__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--space-2xl);
  }
  .product-editorial__heading {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-lg);
    line-height: 1.1;
  }
</style>

{% schema %}
{
  "name": "Editorial Image",
  "class": "section-product-editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 20,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Editorial Image"
    }
  ]
}
{% endschema %}
