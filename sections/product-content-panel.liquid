{%- comment -%}
  PDP — Content panel (Pangaia pattern).

  One section, instantiated four times on the product template:
    ENGINEERING · FABRIC · COLOR · PACKAGING

  Layout: copy column (heading, intro, icon/label/descriptor rows or the
  colour system) beside a media column (images and/or video with thumbnails).

  Block types:
    point  — icon + title + description
    color  — swatch + name + description (the FR colour system)
    media  — image, uploaded video, or external mp4 URL

  Renders nothing when it has no blocks, so an unconfigured instance stays
  invisible rather than leaving an empty band on the page.
{%- endcomment -%}

{%- liquid
  assign points = section.blocks | where: 'type', 'point'
  assign colors = section.blocks | where: 'type', 'color'
  assign media = section.blocks | where: 'type', 'media'
  assign has_copy = false
  if points.size > 0 or colors.size > 0
    assign has_copy = true
  endif
-%}

{%- if has_copy or media.size > 0 -%}
  {{ 'component-content-panel.css' | asset_url | stylesheet_tag }}

  <section class="pcp reveal{% if section.settings.media_first %} pcp--media-first{% endif %}">
    <div class="pcp__inner">
      {%- comment -%} ===== COPY COLUMN ===== {% endcomment -%}
      <div class="pcp__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="pcp__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="pcp__intro">{{ section.settings.intro }}</div>
        {%- endif -%}

        {%- comment -%} Icon + label + descriptor rows {% endcomment -%}
        {%- if points.size > 0 -%}
          <ul class="pcp__points">
            {%- for block in points -%}
              <li class="pcp__point" {{ block.shopify_attributes }}>
                <span class="pcp__point-icon" aria-hidden="true">
                  {%- if block.settings.icon_image != blank -%}
                    <img src="{{ block.settings.icon_image | image_url: width: 60 }}" alt="" width="30" height="30" loading="lazy">
                  {%- else -%}
                    {%- case block.settings.icon -%}
                      {%- when 'leaf' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
                      {%- when 'drop' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 2.7s6 6.1 6 10.3a6 6 0 0 1-12 0c0-4.2 6-10.3 6-10.3z"/></svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      {%- when 'thread' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 20c6-2 10-6 16-16"/><circle cx="18" cy="6" r="2"/></svg>
                      {%- when 'box' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M21 8v12H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>
                      {%- when 'recycle' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><polyline points="7 17 3 17 5 13"/><path d="M5 13a9 9 0 0 1 8-6"/><polyline points="17 7 21 7 19 11"/><path d="M19 11a9 9 0 0 1-8 6"/></svg>
                      {%- when 'clock' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><circle cx="12" cy="16" r="0.6" fill="currentColor"/></svg>
                    {%- endcase -%}
                  {%- endif -%}
                </span>
                <div class="pcp__point-body">
                  {%- if block.settings.title != blank -%}
                    <h3 class="pcp__point-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="pcp__point-text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} ===== COLOUR SYSTEM ===== {% endcomment -%}
        {%- if colors.size > 0 -%}
          <ul class="pcp__colors">
            {%- for block in colors -%}
              <li class="pcp__color" {{ block.shopify_attributes }}>
                <span class="pcp__color-chip" style="background: {{ block.settings.swatch }};" aria-hidden="true"></span>
                <div class="pcp__color-body">
                  {%- if block.settings.name != blank -%}
                    <h3 class="pcp__color-name">{{ block.settings.name }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="pcp__color-text">{{ block.settings.text }}</p>
                  {%- endif -%}
                  {%- if block.settings.pairing != blank -%}
                    <p class="pcp__color-pairing">Pairs with {{ block.settings.pairing }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
          <a class="pcp__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>

      {%- comment -%} ===== MEDIA COLUMN ===== {% endcomment -%}
      {%- if media.size > 0 -%}
        <div class="pcp__media" data-panel-media>
          <div class="pcp__stage">
            {%- for block in media -%}
              <div class="pcp__slide{% if forloop.first %} is-active{% endif %}" data-panel-slide="{{ forloop.index0 }}">
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'pcp__media-el' }}
                {%- elsif block.settings.video_url != blank -%}
                  <video class="pcp__media-el" autoplay muted loop playsinline
                    {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 1200 }}"{% endif %}>
                    <source src="{{ block.settings.video_url }}" type="video/mp4">
                  </video>
                {%- elsif block.settings.image != blank -%}
                  <img
                    class="pcp__media-el"
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                    sizes="(min-width: 769px) 45vw, 100vw"
                    alt="{{ block.settings.image.alt | default: section.settings.heading | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if media.size > 1 -%}
            <div class="pcp__thumbs">
              {%- for block in media -%}
                <button
                  type="button"
                  class="pcp__thumb{% if forloop.first %} is-active{% endif %}"
                  data-panel-thumb="{{ forloop.index0 }}"
                  aria-label="View media {{ forloop.index }}"
                >
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 120 }}" alt="" width="60" height="60" loading="lazy">
                  {%- else -%}
                    <span class="pcp__thumb-fallback"></span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PDP Content Panel",
  "class": "section-pdp-content-panel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fabric" },
    { "type": "richtext", "id": "intro", "label": "Intro paragraph" },
    { "type": "checkbox", "id": "media_first", "label": "Media on the left", "default": false },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "drop", "label": "Drop" },
            { "value": "shield", "label": "Shield" },
            { "value": "thread", "label": "Thread" },
            { "value": "box", "label": "Box" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "clock", "label": "Clock" },
            { "value": "info", "label": "Info" }
          ],
          "default": "leaf"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon (overrides the above)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Ultra-soft" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    },
    {
      "type": "color",
      "name": "Colour",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Slate" },
        { "type": "color", "id": "swatch", "label": "Swatch", "default": "#4A4E54" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "text", "id": "pairing", "label": "Pairs with" }
      ]
    },
    {
      "type": "media",
      "name": "Media",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "url", "id": "video_url", "label": "External mp4 URL" }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Content Panel" }
  ]
}
{% endschema %}
