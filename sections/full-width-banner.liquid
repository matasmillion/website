{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign text_align = section.settings.text_alignment | default: 'center'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<section class="fw-banner reveal">
  <div class="fw-banner__media">
    {%- if section.settings.image != blank -%}
      {%- render 'responsive-image', image: section.settings.image, sizes: '100vw', max_width: 1920, loading: 'lazy' -%}
    {%- else -%}
      <div class="fw-banner__placeholder"></div>
    {%- endif -%}
    <div class="fw-banner__overlay" style="background: rgba(0,0,0,{{ overlay_opacity }})"></div>
  </div>

  <div class="fw-banner__content" style="text-align: {{ text_align }}; color: {{ text_color }};">
    {%- if section.settings.heading != blank -%}
      <h2 class="fw-banner__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="fw-banner__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}
    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.cta_link }}" class="btn {{ section.settings.cta_style }}">
        {{ section.settings.cta_text }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  .fw-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .fw-banner__media {
    position: absolute;
    inset: 0;
  }
  .fw-banner__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fw-banner__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-supporting-sand);
  }
  .fw-banner__overlay {
    position: absolute;
    inset: 0;
  }
  .fw-banner__content {
    position: relative;
    z-index: 1;
    padding: var(--space-2xl);
    max-width: 800px;
  }
  .fw-banner__heading {
    font-size: var(--text-5xl);
    line-height: 1.05;
    margin-bottom: var(--space-md);
  }
  .fw-banner__subtext {
    font-size: var(--text-lg);
    opacity: 0.85;
    margin-bottom: var(--space-lg);
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Full-Width Banner",
  "class": "section-fw-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Freedom through confidence"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button style",
      "options": [
        { "value": "btn--primary", "label": "Filled" },
        { "value": "btn--secondary", "label": "Outlined" }
      ],
      "default": "btn--secondary"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Full-Width Banner"
    }
  ]
}
{% endschema %}
