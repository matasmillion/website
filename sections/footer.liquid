{{ 'component-footer.css' | asset_url | stylesheet_tag }}

<footer class="footer color-scheme--{{ section.settings.color_scheme }}">
  <div class="page-width footer__inner">
    <div class="footer__brand">
      {%- if section.settings.show_logo and settings.logo != blank -%}
        {{ settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'footer__logo', alt: shop.name }}
      {%- else -%}
        <p class="footer__wordmark">{{ shop.name }}</p>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="footer__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
    </div>

    <div class="footer__columns">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <nav class="footer__column" aria-label="{{ block.settings.heading | default: block.settings.menu.title | escape }}" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="footer__heading eyebrow">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              <ul class="footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- when 'text' -%}
            <div class="footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="footer__heading eyebrow">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {%- if section.settings.show_social -%}
        <div class="footer__column">
          <p class="footer__heading eyebrow">{{ 'general.footer.follow' | t }}</p>
          <ul class="footer__social" role="list">
            {%- if settings.social_instagram != blank -%}
              <li><a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram', size: 18 %}</a></li>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <li><a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok', size: 18 %}</a></li>
            {%- endif -%}
            {%- if settings.social_youtube != blank -%}
              <li><a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube', size: 18 %}</a></li>
            {%- endif -%}
            {%- if settings.social_x != blank -%}
              <li><a href="{{ settings.social_x }}" aria-label="X">{% render 'icon', name: 'x', size: 18 %}</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="page-width footer__bottom">
    <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    <ul class="footer__legal" role="list">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          <li><a href="{{ policy.url }}" class="footer__link">{{ policy.title }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "cream"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": false
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Designed for those who see the world differently."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Our mission"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>To inspire global travel. Every purchase contributes to the Foreign Fund — supporting displaced communities worldwide.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
