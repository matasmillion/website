<footer class="footer" role="contentinfo">
  <div class="footer__inner">
    {%- comment -%} Top section: Newsletter + Contact side by side {% endcomment -%}
    <div class="footer__top">
      <div class="footer__newsletter-section">
        <button class="footer__accordion-trigger" data-accordion-trigger aria-expanded="false">
          <span>{{ section.settings.newsletter_heading | default: 'Subscribe to the newsletter' }}</span>
          <svg class="footer__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="footer__accordion-content" data-accordion-content>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}
          {%- form 'customer', id: 'footer-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="footer__newsletter-success">Thank you — you're subscribed.</p>
            {%- endif -%}
            <div class="footer__newsletter-field">
              <input
                type="email"
                name="contact[email]"
                class="footer__newsletter-input"
                placeholder="Email address"
                aria-label="Email address"
                required
                data-nl-email
              >
              <button type="submit" class="btn btn--primary footer__register-btn">
                {{ section.settings.newsletter_button | default: 'Register' }}
              </button>
            </div>

            <div class="footer__nl-more" data-nl-more hidden>
              <fieldset class="footer__nl-gender">
                <legend>Title</legend>
                <label><input type="radio" name="nl_gender" value="Mrs" data-nl-required> Mrs</label>
                <label><input type="radio" name="nl_gender" value="Mr"> Mr</label>
                <label><input type="radio" name="nl_gender" value="Mx"> Mx</label>
                <label><input type="radio" name="nl_gender" value="Prefer not to say"> I prefer not to say</label>
              </fieldset>
              <input
                type="text"
                name="contact[first_name]"
                class="footer__newsletter-input footer__nl-text"
                placeholder="First name"
                aria-label="First name"
                data-nl-required
              >
              <input
                type="text"
                name="contact[last_name]"
                class="footer__newsletter-input footer__nl-text"
                placeholder="Last name"
                aria-label="Last name"
                data-nl-required
              >
              <label class="footer__newsletter-dob-label" for="footer-dob">Date of birth</label>
              <input
                type="date"
                id="footer-dob"
                class="footer__newsletter-dob"
                aria-label="Date of birth"
                data-birthday
              >
            </div>
          {%- endform -%}
        </div>
      </div>

      <div class="footer__contact-section">
        <h2 class="footer__contact-heading">{{ section.settings.contact_heading | default: 'Need help? Contact us' }}</h2>
        {%- if section.settings.contact_hours != blank -%}
          <p class="footer__contact-hours">{{ section.settings.contact_hours }}</p>
        {%- endif -%}
        <div class="footer__contact-links">
          {%- if section.settings.contact_link_1_text != blank -%}
            <a href="{{ section.settings.contact_link_1_url }}" class="footer__contact-link">{{ section.settings.contact_link_1_text }}</a>
          {%- endif -%}
          {%- if section.settings.contact_link_2_text != blank -%}
            <a href="{{ section.settings.contact_link_2_url }}" class="footer__contact-link">{{ section.settings.contact_link_2_text }}</a>
          {%- endif -%}
          {%- if section.settings.contact_link_3_text != blank -%}
            <a href="{{ section.settings.contact_link_3_url }}" class="footer__contact-link">{{ section.settings.contact_link_3_text }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} Middle section: Accordion menus + Social {% endcomment -%}
    <div class="footer__middle">
      <div class="footer__menus">
        {%- for block in section.blocks -%}
          <div class="footer__menu-group" {{ block.shopify_attributes }}>
            <button class="footer__accordion-trigger" data-accordion-trigger aria-expanded="false">
              <span>{{ block.settings.heading }}</span>
              <svg class="footer__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            {%- if block.settings.menu != blank -%}
              <div class="footer__accordion-content" data-accordion-content>
                <ul class="footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="footer__social">
        <h3 class="footer__social-heading">Follow</h3>
        <div class="footer__social-links">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" class="footer__social-link">Instagram</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" class="footer__social-link">TikTok</a>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" class="footer__social-link">YouTube</a>
          {%- endif -%}
          {%- if settings.social_twitter != blank -%}
            <a href="{{ settings.social_twitter }}" target="_blank" rel="noopener" class="footer__social-link">X</a>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} Bottom: Copyright + Logo + Language {% endcomment -%}
    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ shop.name | upcase }} {{ 'now' | date: '%Y' }}</p>
      <a href="/" class="footer__bottom-logo" aria-label="{{ shop.name }}">
        {%- if settings.logo -%}
          <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" loading="lazy">
        {%- else -%}
          <span class="footer__bottom-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <div class="footer__bottom-right">
        {%- if section.settings.legal_menu != blank -%}
          <nav class="footer__legal" aria-label="Legal">
            {%- for link in section.settings.legal_menu.links -%}
              <a href="{{ link.url }}" class="footer__legal-link">{{ link.title }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-secondary);
    color: var(--color-primary);
  }
  .footer__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 1rem + 2vw, 3rem);
  }

  /* --- Top: Newsletter + Contact --- */
  .footer__top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid rgba(10, 10, 10, 0.08);
  }
  @media (max-width: 768px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
  .footer__newsletter-section {
    padding: var(--space-lg) var(--space-lg) var(--space-lg) 0;
    border-right: 1px solid rgba(10, 10, 10, 0.08);
  }
  @media (max-width: 768px) {
    .footer__newsletter-section {
      border-right: none;
      border-bottom: 1px solid rgba(10, 10, 10, 0.08);
      padding: var(--space-lg) 0;
    }
  }
  .footer__contact-section {
    padding: var(--space-lg) 0 var(--space-lg) var(--space-lg);
  }
  @media (max-width: 768px) {
    .footer__contact-section {
      padding: var(--space-lg) 0;
    }
  }
  .footer__contact-heading {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-normal);
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.3;
    margin-bottom: var(--space-md);
  }
  .footer__contact-hours {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }
  .footer__contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .footer__contact-link {
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 0.5px;
  }
  .footer__newsletter-text {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }
  .footer__newsletter-field {
    display: flex;
    align-items: stretch;
    gap: 0;
    border-bottom: 1px solid var(--color-primary);
    max-width: 420px;
  }
  .footer__newsletter-input {
    flex: 1;
    background: none;
    border: none;
    padding: 0.75rem 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-primary);
  }
  .footer__newsletter-input:focus { outline: none; }
  .footer__register-btn {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    padding: 0.5rem 1.5rem;
    white-space: nowrap;
  }
  .footer__newsletter-success {
    font-size: var(--text-sm);
    margin-bottom: var(--space-sm);
  }
  .footer__newsletter-dob-label {
    display: block;
    margin-top: var(--space-md);
    margin-bottom: 0.4rem;
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }
  .footer__newsletter-dob {
    width: 100%;
    max-width: 420px;
    background: none;
    border: none;
    border-bottom: 1px solid var(--color-primary);
    padding: 0.6rem 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-primary);
  }
  .footer__newsletter-dob:focus { outline: none; }

  /* Progressive fields (revealed after email entered) */
  .footer__nl-more[hidden] { display: none; }
  .footer__nl-more {
    max-width: 420px;
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .footer__nl-gender {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
  }
  .footer__nl-gender legend {
    width: 100%;
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin-bottom: 0.4rem;
    padding: 0;
  }
  .footer__nl-gender label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .footer__nl-gender input { accent-color: var(--color-primary); }
  .footer__nl-text {
    width: 100%;
    border-bottom: 1px solid var(--color-primary);
    padding: 0.6rem 0;
  }
  .footer__nl-text::placeholder { color: var(--color-text-light); }

  /* --- Accordion triggers --- */
  .footer__accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-normal);
    color: var(--color-primary);
    text-align: left;
    padding: 0;
    margin-bottom: var(--space-md);
    min-height: 44px;
  }
  .footer__chevron {
    transition: transform var(--duration-base) var(--ease-out);
  }
  .footer__accordion-trigger[aria-expanded="true"] .footer__chevron {
    transform: rotate(180deg);
  }
  .footer__accordion-content {
    overflow: hidden;
  }

  /* --- Middle: Menus + Social --- */
  .footer__middle {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-top: 1px solid rgba(10, 10, 10, 0.08);
    padding: var(--space-lg) 0;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }
  .footer__menus {
    display: flex;
    gap: clamp(2rem, 1.5rem + 3vw, 6rem);
    flex-wrap: wrap;
  }
  .footer__menu-group .footer__accordion-trigger {
    font-size: var(--text-base);
    margin-bottom: 0;
  }
  .footer__menu-group .footer__accordion-content {
    display: none;
  }
  .footer__menu-group .footer__accordion-content.is-open {
    display: block;
    padding-top: var(--space-sm);
  }
  @media (min-width: 769px) {
    .footer__menu-group .footer__accordion-content {
      display: block;
      padding-top: var(--space-sm);
    }
    .footer__menu-group .footer__chevron {
      display: none;
    }
  }
  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .footer__link {
    font-size: var(--text-sm);
    opacity: 0.5;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .footer__link:hover {
    opacity: 1;
  }
  .footer__social {
    text-align: right;
  }
  @media (max-width: 768px) {
    .footer__social {
      text-align: left;
      width: 100%;
    }
  }
  .footer__social-heading {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-normal);
    text-transform: none;
    letter-spacing: 0;
    margin-bottom: var(--space-sm);
  }
  .footer__social-links {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  @media (min-width: 769px) {
    .footer__social-links {
      justify-content: flex-end;
    }
  }
  .footer__social-link {
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 0.5px;
    opacity: 0.6;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .footer__social-link:hover {
    opacity: 1;
  }

  /* --- Bottom: Copyright + Logo --- */
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xl) 0 var(--space-lg);
    border-top: 1px solid rgba(10, 10, 10, 0.08);
  }
  .footer__copyright {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    opacity: 0.5;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .footer__bottom-logo img {
    max-height: 20px;
  }
  .footer__bottom-logo-text {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 0.9rem + 1vw, 1.75rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .footer__bottom-right {
    font-size: var(--text-micro);
  }
  .footer__legal {
    display: flex;
    gap: var(--space-md);
  }
  .footer__legal-link {
    font-size: var(--text-micro);
    opacity: 0.35;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .footer__legal-link:hover {
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Subscribe to the newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "default": "Subscribe to receive all the information by email on our latest collections, products, and projects."
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Newsletter button text",
      "default": "Register"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Need help? Contact us"
    },
    {
      "type": "text",
      "id": "contact_hours",
      "label": "Contact hours",
      "default": "Monday to Friday from 9:00am to 5:00pm EST."
    },
    {
      "type": "text",
      "id": "contact_link_1_text",
      "label": "Contact link 1 text",
      "default": "Contact form"
    },
    {
      "type": "url",
      "id": "contact_link_1_url",
      "label": "Contact link 1 URL"
    },
    {
      "type": "text",
      "id": "contact_link_2_text",
      "label": "Contact link 2 text",
      "default": "Track an order"
    },
    {
      "type": "url",
      "id": "contact_link_2_url",
      "label": "Contact link 2 URL"
    },
    {
      "type": "text",
      "id": "contact_link_3_text",
      "label": "Contact link 3 text",
      "default": "Register a return"
    },
    {
      "type": "url",
      "id": "contact_link_3_url",
      "label": "Contact link 3 URL"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Legal"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "settings": {
      "newsletter_heading": "Subscribe to the newsletter",
      "newsletter_text": "Subscribe to receive all the information by email on our latest collections, products, and projects.",
      "contact_heading": "Need help? Contact us",
      "contact_hours": "Monday to Friday from 9:00am to 5:00pm EST.",
      "contact_link_1_text": "Contact form",
      "contact_link_2_text": "Track an order",
      "contact_link_3_text": "Register a return"
    },
    "blocks": [
      { "type": "menu", "settings": { "heading": "Legal" } },
      { "type": "menu", "settings": { "heading": "FAQ" } },
      { "type": "menu", "settings": { "heading": "Company" } }
    ]
  }
}
{% endschema %}
