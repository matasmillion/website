<footer class="footer" role="contentinfo">
  <div class="footer__inner container">
    <div class="footer__grid">
      {%- comment -%} Brand Column {% endcomment -%}
      <div class="footer__col footer__col--brand">
        <a href="/" class="footer__logo" aria-label="{{ shop.name }}">
          {%- if settings.logo -%}
            <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="100" loading="lazy">
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- render 'social-icons' -%}
      </div>

      {%- comment -%} Navigation Columns {% endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="footer__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- form 'customer', id: 'footer-newsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="footer__newsletter">
                  <input
                    type="email"
                    name="contact[email]"
                    placeholder="{{ block.settings.placeholder | default: 'Enter your email' }}"
                    required
                    class="footer__input"
                    aria-label="Email address"
                  >
                  <button type="submit" class="footer__newsletter-btn" aria-label="{{ 'newsletter.submit' | t }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </button>
                </div>
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      {%- if section.settings.legal_menu != blank -%}
        <nav class="footer__legal" aria-label="Legal">
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}" class="footer__legal-link">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary);
    color: var(--color-secondary);
    padding: var(--space-2xl) 0 var(--space-lg);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }
  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }
    .footer__col--brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
  .footer__logo-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .footer__logo img {
    filter: brightness(0) invert(1);
  }
  .footer__tagline {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    opacity: 0.6;
    line-height: 1.5;
  }
  .footer .social-icons {
    margin-top: var(--space-md);
    display: flex;
    gap: var(--space-sm);
  }
  .footer .social-icons__link {
    opacity: 0.6;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .footer .social-icons__link:hover {
    opacity: 1;
  }
  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
    opacity: 0.5;
  }
  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .footer__link {
    font-size: var(--text-sm);
    opacity: 0.7;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .footer__link:hover {
    opacity: 1;
  }
  .footer__text {
    font-size: var(--text-sm);
    opacity: 0.7;
    line-height: 1.6;
  }
  .footer__newsletter {
    display: flex;
    border-bottom: 1px solid rgba(245, 240, 235, 0.3);
    margin-top: var(--space-sm);
  }
  .footer__input {
    flex: 1;
    background: none;
    border: none;
    color: var(--color-secondary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: var(--space-xs) 0;
    outline: none;
  }
  .footer__input::placeholder {
    color: rgba(245, 240, 235, 0.4);
  }
  .footer__newsletter-btn {
    background: none;
    border: none;
    color: var(--color-secondary);
    cursor: pointer;
    padding: var(--space-xs);
    opacity: 0.6;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .footer__newsletter-btn:hover {
    opacity: 1;
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(245, 240, 235, 0.1);
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .footer__copyright {
    font-size: var(--text-xs);
    opacity: 0.4;
  }
  .footer__legal {
    display: flex;
    gap: var(--space-md);
  }
  .footer__legal-link {
    font-size: var(--text-xs);
    opacity: 0.4;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .footer__legal-link:hover {
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Designed for those who see the world differently."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu (privacy, terms)"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay Connected"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtext",
          "default": "First access to new collections and travel stories."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Input placeholder",
          "default": "Enter your email"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "default": {
    "settings": {
      "tagline": "Designed for those who see the world differently."
    },
    "blocks": [
      {
        "type": "menu",
        "settings": {
          "heading": "Shop"
        }
      },
      {
        "type": "menu",
        "settings": {
          "heading": "About"
        }
      },
      {
        "type": "newsletter",
        "settings": {
          "heading": "Stay Connected"
        }
      }
    ]
  }
}
{% endschema %}
