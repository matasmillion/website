{%- comment -%}
  PDP — Complete the look.

  A per-SKU lookbook shot beside the four products curated for it.

  Mobile  — lookbook full width, then a 2x2 grid beneath.
  Desktop — lookbook left, 2x2 grid right, sized so the whole section reads in
            one viewport rather than being scrolled through.

  Sources, in order of preference:
    lookbook  product.metafields.custom.lookbook_image   (file_reference)
              falling back to the product's featured image
    products  product.metafields.custom.complete_the_look (list.product_reference)
              falling back to custom.styled_with, then the first collection

  The lookbook frame's aspect ratio is set per breakpoint in the theme editor,
  so the shot can be planned around the frame rather than cropped to fit.

  Setting complementary products needs no metaobjects — create one metafield
  definition (Settings > Custom data > Products):
      custom.complete_the_look : Product (list of)
      custom.lookbook_image    : File
{%- endcomment -%}

{%- liquid
  assign lookbook = product.metafields.custom.lookbook_image.value
  if lookbook == blank
    assign lookbook = product.featured_image
  endif

  assign picks = product.metafields.custom.complete_the_look.value
  if picks == blank
    assign picks = product.metafields.custom.styled_with.value
  endif
  if picks == blank and product.collections.size > 0
    assign picks = product.collections.first.products
  endif

  assign ratio_m = section.settings.lookbook_ratio_mobile | default: '4/5'
  assign ratio_d = section.settings.lookbook_ratio_desktop | default: '4/5'
-%}

{%- if picks != blank and picks.size > 0 -%}
  <section
    class="ctl reveal"
    style="--ctl-ratio-m: {{ ratio_m }}; --ctl-ratio-d: {{ ratio_d }};"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="ctl__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="ctl__layout">
      {%- if lookbook != blank -%}
        <div class="ctl__lookbook">
          <img
            class="ctl__lookbook-img"
            src="{{ lookbook | image_url: width: 1400 }}"
            srcset="{{ lookbook | image_url: width: 700 }} 700w,
                    {{ lookbook | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 769px) 46vw, 100vw"
            alt="{{ product.title | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div class="ctl__grid">
        {%- assign shown = 0 -%}
        {%- for item in picks -%}
          {%- unless item.handle == product.handle -%}
            {%- if shown < 4 -%}
              <a class="ctl__item" href="{{ item.url }}" aria-label="{{ item.title | escape }}">
                {%- if item.featured_image -%}
                  <img
                    class="ctl__item-img"
                    src="{{ item.featured_image | image_url: width: 800 }}"
                    alt="{{ item.title | escape }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <style>
    /* Full-bleed: the images touch both edges of the viewport on every
       breakpoint. Only the heading keeps the page inset. */
    .ctl {
      padding: var(--space-2xl) 0;
      border-top: 1px solid var(--color-border);
    }

    .ctl__heading {
      padding: 0 clamp(1.25rem, 0.5rem + 3vw, 4rem);
      font-family: var(--font-heading);
      font-size: clamp(1.5rem, 1rem + 1.6vw, 2.25rem);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0.01em;
      text-transform: uppercase;
      color: #2D2C2F;
      margin-bottom: var(--space-lg);
    }

    /* Seamless — the images butt up against each other with no gutters */
    .ctl__layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
    }

    .ctl__lookbook {
      aspect-ratio: var(--ctl-ratio-m, 4/5);
      overflow: hidden;
      background: #E4DED2;
    }

    .ctl__lookbook-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .ctl__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }

    .ctl__item {
      display: block;
      position: relative;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: #E4DED2;
    }

    .ctl__item-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform var(--duration-slow) var(--ease-out);
    }

    .ctl__item:hover .ctl__item-img { transform: scale(1.03); }

    @media (min-width: 769px) {
      /* Lookbook left, grid right. The lookbook drives the height and the whole
         section is capped to a viewport so it reads as one composition. */
      .ctl__layout {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
      }

      .ctl__lookbook {
        aspect-ratio: var(--ctl-ratio-d, 4/5);
        max-height: 82vh;
        height: 100%;
      }

      /* The 2x2 matches the lookbook's height exactly, so the whole section
         reads as one uninterrupted block. */
      .ctl__grid {
        height: 100%;
        grid-template-rows: repeat(2, 1fr);
      }

      .ctl__item { aspect-ratio: auto; height: 100%; }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "PDP Complete the Look",
  "class": "section-pdp-complete-the-look",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    {
      "type": "select",
      "id": "lookbook_ratio_mobile",
      "label": "Lookbook frame — mobile",
      "options": [
        { "value": "9/16", "label": "9:16 (tall)" },
        { "value": "2/3", "label": "2:3" },
        { "value": "3/4", "label": "3:4" },
        { "value": "4/5", "label": "4:5" },
        { "value": "1/1", "label": "1:1 (square)" },
        { "value": "5/4", "label": "5:4" },
        { "value": "4/3", "label": "4:3" },
        { "value": "3/2", "label": "3:2" },
        { "value": "16/9", "label": "16:9 (wide)" }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "lookbook_ratio_desktop",
      "label": "Lookbook frame — desktop",
      "info": "Wider ratios keep the whole section in one screen. Shoot to match.",
      "options": [
        { "value": "9/16", "label": "9:16 (tall)" },
        { "value": "2/3", "label": "2:3" },
        { "value": "3/4", "label": "3:4" },
        { "value": "4/5", "label": "4:5" },
        { "value": "1/1", "label": "1:1 (square)" },
        { "value": "5/4", "label": "5:4" },
        { "value": "4/3", "label": "4:3" },
        { "value": "3/2", "label": "3:2" },
        { "value": "16/9", "label": "16:9 (wide)" }
      ],
      "default": "4/5"
    },
    {
      "type": "paragraph",
      "content": "Lookbook comes from the custom.lookbook_image metafield (type: File), falling back to the product's featured image. Products come from custom.complete_the_look (type: Product, list of)."
    }
  ],
  "presets": [{ "name": "PDP Complete the Look" }]
}
{% endschema %}
