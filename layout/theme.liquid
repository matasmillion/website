<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ settings.text_direction | default: 'ltr' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary }}">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- render 'meta-tags' -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}

  {%- comment -%} Preconnect to Shopify CDN {% endcomment -%}
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {%- comment -%} Font loading — Inter from Shopify's font library {% endcomment -%}
  {%- if settings.font_heading.family -%}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if settings.font_body.family -%}
    {{ settings.font_body | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- comment -%} Fallback: load Inter directly if font pickers not configured {% endcomment -%}
  {%- unless settings.font_body.family -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  {%- endunless -%}

  {%- comment -%} Base CSS — always loaded {% endcomment -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {%- comment -%}
    Settings-driven CSS variables. base.css is a static .css file, so Liquid
    inside it is NOT processed — these must be defined here (processed as Liquid)
    and loaded AFTER base.css so they take effect.
  {%- endcomment -%}
  <style>
    :root {
      --color-primary: {{ settings.color_primary | default: '#2E2E2E' }};
      --color-secondary: {{ settings.color_secondary | default: '#FFFFFF' }};
      --color-accent: {{ settings.color_accent | default: '#C4632A' }};
      --color-supporting-green: {{ settings.color_supporting_green | default: '#7A8B6F' }};
      --color-supporting-sand: {{ settings.color_supporting_sand | default: '#D4C5A9' }};
      --font-heading: {{ settings.font_heading.family | default: 'Inter' }}, {{ settings.font_heading.fallback_families | default: 'sans-serif' }};
      --font-body: {{ settings.font_body.family | default: 'Inter' }}, {{ settings.font_body.fallback_families | default: 'sans-serif' }};
    }
  </style>

  {%- comment -%} Shopify essentials {% endcomment -%}
  {{ content_for_header }}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
  <a class="skip-to-content" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

  {%- sections 'header-group' -%}

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {%- sections 'footer-group' -%}

  {%- comment -%} Global JS — loaded at end {% endcomment -%}
  <script src="{{ 'global.js' | asset_url }}" defer></script>
</body>
</html>
