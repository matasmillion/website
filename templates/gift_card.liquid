{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{{ 'gift_card.title' | t: shop: shop.name }}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #F1EEE6;
      color: #2D2C2F;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.25rem;
      -webkit-font-smoothing: antialiased;
    }
    .gift-card {
      max-width: 420px;
      width: 100%;
      text-align: center;
    }
    .gift-card__shop {
      font-size: 0.625rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin-bottom: 2rem;
    }
    .gift-card__title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 400;
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }
    .gift-card__amount {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 3rem;
      font-weight: 500;
      margin: 1.5rem 0;
    }
    .gift-card__expired {
      display: inline-block;
      font-size: 0.625rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #8B0000;
      border: 1px solid currentColor;
      padding: 0.375rem 0.75rem;
      margin-bottom: 1rem;
    }
    .gift-card__code {
      display: inline-block;
      font-size: 1rem;
      letter-spacing: 0.2em;
      border: 1px solid rgba(45, 44, 47, 0.25);
      padding: 0.875rem 1.5rem;
      margin-bottom: 1.5rem;
      user-select: all;
    }
    .gift-card__qr {
      display: flex;
      justify-content: center;
      margin-bottom: 1.5rem;
    }
    .gift-card__note {
      font-size: 0.75rem;
      color: #716F70;
      line-height: 1.7;
      margin-bottom: 2rem;
    }
    .gift-card__actions a,
    .gift-card__actions button {
      display: inline-block;
      font-family: 'Inter', sans-serif;
      font-size: 0.625rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #2D2C2F;
      background: none;
      border: none;
      border-bottom: 1px solid rgba(45, 44, 47, 0.25);
      padding: 0 0 0.125rem;
      margin: 0 0.75rem;
      text-decoration: none;
      cursor: pointer;
    }
    @media print {
      .gift-card__actions { display: none; }
    }
  </style>
</head>
<body>
  <div class="gift-card">
    <p class="gift-card__shop">{{ shop.name }}</p>
    <h1 class="gift-card__title">{{ 'gift_card.subtitle' | t }}</h1>

    {%- if gift_card.expired or gift_card.enabled != true -%}
      <p class="gift-card__expired">{{ 'gift_card.expired' | t }}</p>
    {%- endif -%}

    <p class="gift-card__amount">{{ gift_card.balance | money }}</p>

    {%- if gift_card.balance != gift_card.initial_value -%}
      {%- assign initial_value = gift_card.initial_value | money -%}
      <p class="gift-card__note">{{ 'gift_card.initial_value' | t: value: initial_value }}</p>
    {%- endif -%}

    <p class="gift-card__code">{{ gift_card.code | format_code }}</p>

    <div class="gift-card__qr" id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>

    <p class="gift-card__note">{{ 'gift_card.instructions' | t }}</p>

    <div class="gift-card__actions">
      <a href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_card.shop_link' | t }}</a>
      <button type="button" onclick="window.print();">{{ 'gift_card.print' | t }}</button>
    </div>
  </div>

  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  <script>
    window.addEventListener('DOMContentLoaded', function () {
      var el = document.getElementById('QrCode');
      if (el && window.QRCode) {
        new QRCode(el, {
          text: el.dataset.identifier,
          width: 120,
          height: 120
        });
      }
    });
  </script>
</body>
</html>
