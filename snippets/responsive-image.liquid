{%- comment -%}
  Responsive Image Snippet
  Usage: {% render 'responsive-image', image: image, sizes: '100vw', max_width: 1600, alt: 'Alt text', class: 'my-class' %}
{%- endcomment -%}

{%- liquid
  assign img_sizes = sizes | default: '100vw'
  assign img_max = max_width | default: 1600
  assign img_alt = alt | default: image.alt | escape
  assign img_class = class | default: ''
  assign img_loading = loading | default: 'lazy'
-%}

{%- if image -%}
  <img
    src="{{ image | image_url: width: img_max }}"
    srcset="{%- if img_max >= 400 -%}{{ image | image_url: width: 400 }} 400w,{%- endif -%}
            {%- if img_max >= 600 -%}{{ image | image_url: width: 600 }} 600w,{%- endif -%}
            {%- if img_max >= 800 -%}{{ image | image_url: width: 800 }} 800w,{%- endif -%}
            {%- if img_max >= 1000 -%}{{ image | image_url: width: 1000 }} 1000w,{%- endif -%}
            {%- if img_max >= 1200 -%}{{ image | image_url: width: 1200 }} 1200w,{%- endif -%}
            {%- if img_max >= 1600 -%}{{ image | image_url: width: 1600 }} 1600w{%- endif -%}"
    sizes="{{ img_sizes }}"
    alt="{{ img_alt }}"
    loading="{{ img_loading }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    {%- if img_class != blank %} class="{{ img_class }}"{% endif %}
  >
{%- else -%}
  {{ 'lifestyle-1' | placeholder_svg_tag: img_class }}
{%- endif -%}
