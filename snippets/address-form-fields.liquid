{%- comment -%}
  Shared address form fields.
  Usage: {% render 'address-form-fields', form: form, address: address, id_prefix: 'AddressNew' %}
  Country/province selects are populated by customer.js (Shopify country_option_tags pattern).
{%- endcomment -%}
<div class="portal-auth__row">
  <div class="field">
    <label class="field__label" for="AddressFirstName{{ id_prefix }}">{{ 'customer.addresses.first_name' | t }}</label>
    <input
      id="AddressFirstName{{ id_prefix }}"
      class="field__input"
      type="text"
      name="address[first_name]"
      value="{{ form.first_name }}"
      autocomplete="given-name"
    >
  </div>
  <div class="field">
    <label class="field__label" for="AddressLastName{{ id_prefix }}">{{ 'customer.addresses.last_name' | t }}</label>
    <input
      id="AddressLastName{{ id_prefix }}"
      class="field__input"
      type="text"
      name="address[last_name]"
      value="{{ form.last_name }}"
      autocomplete="family-name"
    >
  </div>
</div>

<div class="field">
  <label class="field__label" for="AddressCompany{{ id_prefix }}">{{ 'customer.addresses.company' | t }}</label>
  <input
    id="AddressCompany{{ id_prefix }}"
    class="field__input"
    type="text"
    name="address[company]"
    value="{{ form.company }}"
    autocomplete="organization"
  >
</div>

<div class="field">
  <label class="field__label" for="AddressAddress1{{ id_prefix }}">{{ 'customer.addresses.address1' | t }}</label>
  <input
    id="AddressAddress1{{ id_prefix }}"
    class="field__input"
    type="text"
    name="address[address1]"
    value="{{ form.address1 }}"
    autocomplete="address-line1"
  >
</div>

<div class="field">
  <label class="field__label" for="AddressAddress2{{ id_prefix }}">{{ 'customer.addresses.address2' | t }}</label>
  <input
    id="AddressAddress2{{ id_prefix }}"
    class="field__input"
    type="text"
    name="address[address2]"
    value="{{ form.address2 }}"
    autocomplete="address-line2"
  >
</div>

<div class="portal-auth__row">
  <div class="field">
    <label class="field__label" for="AddressCity{{ id_prefix }}">{{ 'customer.addresses.city' | t }}</label>
    <input
      id="AddressCity{{ id_prefix }}"
      class="field__input"
      type="text"
      name="address[city]"
      value="{{ form.city }}"
      autocomplete="address-level2"
    >
  </div>
  <div class="field">
    <label class="field__label" for="AddressZip{{ id_prefix }}">{{ 'customer.addresses.zip' | t }}</label>
    <input
      id="AddressZip{{ id_prefix }}"
      class="field__input"
      type="text"
      name="address[zip]"
      value="{{ form.zip }}"
      autocomplete="postal-code"
      autocapitalize="characters"
    >
  </div>
</div>

<div class="portal-auth__row">
  <div class="field">
    <label class="field__label" for="AddressCountry{{ id_prefix }}">{{ 'customer.addresses.country' | t }}</label>
    <select
      id="AddressCountry{{ id_prefix }}"
      name="address[country]"
      data-address-country-select
      data-default="{{ form.country }}"
      autocomplete="country"
    >
      {{ all_country_option_tags }}
    </select>
  </div>
  <div class="field" data-address-province-wrap>
    <label class="field__label" for="AddressProvince{{ id_prefix }}">{{ 'customer.addresses.province' | t }}</label>
    <select
      id="AddressProvince{{ id_prefix }}"
      name="address[province]"
      data-address-province-select
      data-default="{{ form.province }}"
      autocomplete="address-level1"
    ></select>
  </div>
</div>

<div class="field">
  <label class="field__label" for="AddressPhone{{ id_prefix }}">{{ 'customer.addresses.phone' | t }}</label>
  <input
    id="AddressPhone{{ id_prefix }}"
    class="field__input"
    type="tel"
    name="address[phone]"
    value="{{ form.phone }}"
    autocomplete="tel"
  >
</div>

<div class="field portal-address-form__default">
  <label class="portal-address-form__checkbox">
    {{ form.set_as_default_checkbox }}
    <span>{{ 'customer.addresses.set_default' | t }}</span>
  </label>
</div>
